@import "../../../utils/pixel-theme.wxss";
.fieldScreen{height:100vh;box-sizing:border-box;padding-top:var(--nav-height,64px);display:flex;flex-direction:column;background:#fcf8ed;color:#243b31;font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif}.editorHeading{padding:12rpx 24rpx;display:flex;justify-content:space-between;gap:12rpx;align-items:center}.fieldName{font-size:calc(27rpx * var(--font-scale,1))}.fieldSubtitle{font-size:22rpx;color:#657467;flex-shrink:0}.fieldMap{position:relative;flex:1;min-height:160px;border-top:4rpx solid #243b31;border-bottom:4rpx solid #243b31}.fieldMap map{width:100%;height:100%}.mapLoading{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#fcf8eddd}.fieldPanel{box-sizing:border-box;flex:none;border-top:6rpx solid #d4dec4}.modeTabs{display:flex;gap:12rpx}.modeTabs button{flex:1}.fieldPanel button{width:100%;min-width:0;font:inherit;font-size:calc(27rpx * var(--font-scale,1));line-height:1.3;min-height:42px;padding:16rpx 10rpx;margin:0;border:3rpx solid #243b31;border-radius:3rpx;background:#fcf8ed;color:#243b31;box-sizing:border-box}.fieldPanel button:after{border:0}.modeTabs .chosen{background:#477f60;color:white;box-shadow:inset 0 -5rpx #335944}.instruction{display:block;font-size:calc(25rpx * var(--font-scale,1));margin:16rpx 0 10rpx;line-height:1.4}.fieldStats{display:flex;flex-wrap:wrap;gap:8rpx 16rpx;justify-content:space-between;font-size:23rpx;color:#657467}.editorTools{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10rpx;margin-top:12rpx}.editorTools button{font-size:calc(23rpx * var(--font-scale,1));padding:10rpx 0}.fieldError,.fieldValid{display:block;font-size:calc(24rpx * var(--font-scale,1));line-height:1.4;margin:12rpx 0}.fieldError{color:#a4462c}.fieldValid{color:#477f60}.fieldPanel .fieldSave{background:#e99c45;color:#172d26;min-height:44px;box-shadow:inset 0 -6rpx #bb7430}.fieldPanel button[disabled]{background:#e7e8dd;color:#92998e;border-color:#b5bcae;box-shadow:none}.fieldFootnote{display:block;color:#657467;font-size:22rpx;line-height:1.4;margin:12rpx 0}.demoNote{font-size:22rpx;color:#a4462c;margin-bottom:10rpx}.large .editorTools{grid-template-columns:repeat(2,minmax(0,1fr))}.fieldPanel .retry{margin-top:12rpx}

.fieldPanelContent{width:100%;box-sizing:border-box;padding:16rpx 24rpx calc(12rpx + env(safe-area-inset-bottom))}
