@import "../../../utils/pixel-theme.wxss";

.fieldScreen{
  position:relative;
  width:var(--vw,100vw);
  height:var(--vh,100vh);
  overflow:hidden;
  box-sizing:border-box;
  padding-top:var(--nav-height,64px);
  display:flex;
  flex-direction:column;
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
}

.editorTopBar{
  flex:none;
  padding:6px 10px;
}

.editorHeading{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  padding:2px 4px;
}

.fieldPicker{
  flex:1;
  min-width:0;
}

.fieldNamePill{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:6px;
  min-height:36px;
  padding:4px 10px;
  background:#fff3d6;
  border:2px solid #2a6b94;
  border-radius:0;
  box-shadow:inset 0 2px 0 #d1b482;
  color:#3b1d0b;
}

.fieldName{
  flex:1;
  min-width:0;
  font-size:calc(14px * var(--font-scale,1));
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.fieldArrow{
  flex:none;
  font-size:13px;
  color:#2a6e99;
}

.fieldMap{
  position:relative;
  flex:1;
  min-height:140px;
  margin:0 12px;
  border:3px solid #3b1c0a;
  border-radius:0;
  border-bottom:0;
  overflow:hidden;
  background:#dce8df;
}

.fieldMap map{width:100%;height:100%}

.mapLoading{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fbe3b0ee;
  color:#3b1d0b;
  font-size:14px;
}

.fieldPanel{
  box-sizing:border-box;
  flex:0 1 auto;
  min-height:120px;
  max-height:calc(var(--vh,100vh) - var(--nav-height,64px) - 180px);
  background:#f6dca8;
  border-top:3px solid #3b1c0a;
  box-shadow:inset 0 4px 0 #4d9a3b,inset 0 6px 0 #82cf6f;
}

.fieldPanelContent{
  width:100%;
  box-sizing:border-box;
  padding:8px 12px calc(10px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  display:flex;
  flex-direction:column;
  gap:6px;
}

.demoNote,.fieldMsg,.fieldError{margin:0}
.modeTabs{margin:0}
.modeTabs .sdvPill{gap:6px}

.editorStatusCard{
  padding:7px 10px;
  display:flex;
  flex-direction:column;
  gap:4px;
}

.instruction{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  line-height:1.45;
  color:#332012;
}

.fieldStats{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.statsValue{
  font-size:calc(12px * var(--font-scale,1));
  color:#5e4c3c;
}

.editorTools{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:8px;
}

.fieldValidBox{
  padding:8px 12px;
  background:#d4ebba;
  border:2px solid #2c6122;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ecf7df;
}

.fieldValid{
  display:block;
  font-size:calc(13px * var(--font-scale,1));
  color:#2c6122;
}

.fieldSaveHint{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  color:#5e4c3c;
}

.fieldFootnote{
  display:block;
  color:#5e4c3c;
  font-size:12px;
  line-height:1.5;
}

.large .editorTools{
  grid-template-columns:1fr;
}
