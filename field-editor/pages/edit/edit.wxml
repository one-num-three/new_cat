<view class="screen fieldScreen {{themeMode==='night'?'sdvNight sdvDeepNight':themeMode==='dusk'?'sdvNight sdvDusk':nightMode?'sdvNight sdvDeepNight':''}} {{fontScale>1.15?'large':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--safe-bottom:{{safeBottom}}px">
  <nav-bar pinned="{{true}}" title="集合点与活动范围" back="{{true}}" preview="{{devPreview}}" />

  <view class="editorTopBar">
    <view class="sdvPaperCard editorHeading">
      <picker class="fieldPicker" range="{{mapOptions}}" range-key="label" value="{{mapIndex}}" bindchange="selectMap" disabled="{{!editable || busy}}">
        <view class="fieldNamePill">
          <text class="fieldName">{{venueName}}</text>
          <text class="fieldArrow" aria-hidden="true">▾</text>
        </view>
      </picker>
      <text class="sdvBadge {{canSave?'sdvBadgeGreen':'sdvBadgeAmber'}}">{{canSave?'已就绪':'编辑中'}}</text>
    </view>
  </view>

  <view class="fieldMap">
    <map id="fieldMap" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" polygons="{{polygons}}" polyline="{{polyline}}" enable-scroll="{{true}}" enable-zoom="{{true}}" show-location="{{false}}" bindregionchange="mapMoved" bindtap="tapMap" bindmarkertap="tapMarker" bindcallouttap="tapMarker" />
    <view wx:if="{{loading || initialLocating}}" class="mapLoading">
      <text>{{initialLocating?'定位中…':'读取中…'}}</text>
    </view>
  </view>

  <scroll-view scroll-y class="fieldPanel">
    <view class="fieldPanelContent">
      <text wx:if="{{devPreview}}" class="sdvNotice demoNote">预览模式 · 不读取GPS</text>
      <text wx:if="{{locationHint}}" class="sdvNotice fieldMsg" role="status">{{locationHint}}</text>
      <text wx:if="{{mapHint}}" class="sdvNotice fieldMsg">{{mapHint}}</text>

      <view class="sdvPillGroup modeTabs">
        <button id="boundaryMode" class="sdvPill {{mode==='boundary'?'sdvPillActive':''}}" hover-class="sdvPressed" data-mode="boundary" bindtap="setMode" disabled="{{!editable || busy}}">
          <map-icon kind="route" size="14" color="{{mode==='boundary'?'#fffdf6':'#5e3616'}}" />
          <text>框选范围</text>
        </button>
        <button id="meetingMode" class="sdvPill {{mode==='meeting'?'sdvPillActive':''}}" hover-class="sdvPressed" data-mode="meeting" bindtap="setMode" disabled="{{!editable || busy}}">
          <map-icon kind="pin" size="14" color="{{mode==='meeting'?'#fffdf6':'#5e3616'}}" />
          <text>集合点</text>
        </button>
      </view>

      <view class="sdvPaperCard editorStatusCard">
        <view class="fieldStats">
          <text class="statsValue">{{points.length}}/16点 · {{areaText}}</text>
          <text class="sdvBadge {{meeting?'sdvBadgeGreen':'sdvBadgeAmber'}}">{{meeting?'集合点已选':'待选集合点'}}</text>
        </view>
        <text wx:if="{{!canSave}}" class="instruction">{{instruction}}</text>
      </view>

      <view class="editorTools">
        <button class="sdvBtn sdvBtnPaper sdvBtnSm" hover-class="sdvPressed" bindtap="undo" disabled="{{!canUndo || busy || !editable}}">
          <map-icon kind="undo" size="14" color="#3b1d0b" />
          <text>撤销</text>
        </button>
        <button class="sdvBtn sdvBtnPaper sdvBtnSm" hover-class="sdvPressed" bindtap="clear" disabled="{{!points.length || busy || !editable}}">
          <map-icon kind="trash" size="14" color="#3b1d0b" />
          <text>重画</text>
        </button>
        <button class="sdvBtn sdvBtnWood sdvBtnSm" hover-class="sdvPressed" bindtap="locate" disabled="{{busy || !editable}}">
          <map-icon kind="locate" size="14" color="#3b1d0b" />
          <text>定位</text>
        </button>
      </view>

      <button wx:if="{{selected>=0}}" class="sdvBtn sdvBtnRed sdvBtnSm" hover-class="sdvPressed" bindtap="remove" disabled="{{busy || !editable}}">
        <map-icon kind="trash" size="14" color="#fffdf6" />
        <text>删除顶点 {{selected+1}}</text>
      </button>

      <view wx:if="{{error}}" class="sdvError sdvErrorRow fieldError" bindtap="clearError" role="alert">
        <text class="errorText">{{error}}</text>
        <text class="errorClose" aria-hidden="true">×</text>
      </view>
      <view wx:if="{{validation}}" class="sdvError fieldError" role="status">
        <text class="errorText">{{validation}}</text>
      </view>
      <button wx:if="{{needSetting}}" class="sdvBtn sdvBtnBlue sdvBtnSm permLinkBtn" hover-class="sdvPressed" bindtap="openPermSettings">去开启定位权限</button>
      <button wx:if="{{!editable && !loading}}" class="sdvBtn sdvBtnPaper sdvBtnSm" hover-class="sdvPressed" bindtap="loadRoom">重试</button>
    </view>
  </scroll-view>

  <view class="fieldFooter">
    <view class="fieldFooterRow {{points.length>=3 && (!meeting || mode==='meeting' || validation==='集合点需要在活动范围内')?'hasAutoMeeting':''}}">
      <button wx:if="{{points.length>=3 && (!meeting || mode==='meeting' || validation==='集合点需要在活动范围内')}}" class="sdvBtn sdvBtnGreen sdvBtnSm" hover-class="sdvPressed" bindtap="autoMeeting" disabled="{{busy || !editable}}">
        <map-icon kind="pin" size="14" color="#fffdf6" />
        <text>一键中心集合点</text>
      </button>
      <button class="sdvBtn sdvBtnAmber fieldSave" hover-class="sdvPressed" bindtap="save" disabled="{{!canSave || busy}}" loading="{{busy}}">
        <map-icon kind="check" size="16" color="#fffdf6" />
        <text>{{roomId?'保存范围':'确认范围'}}</text>
      </button>
    </view>
  </view>
</view>
