# Local embedded PostgreSQL-compatible store: copy to .env only if you use an env loader.
PORT=4000
HOST=127.0.0.1
DATA_DIR=./data
# Local two-identity engineering test only. Never enable outside a local test run.
# NODE_ENV=test
# ENABLE_LOCAL_TEST_IDENTITIES=true
# Production requires a PostgreSQL connection string and real WeChat credentials.
# DATABASE_URL=postgres://catmouse:<secret>@127.0.0.1:5432/catmouse
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
