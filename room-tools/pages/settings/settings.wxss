@import "../../../utils/pixel-theme.wxss";
.settingsScreen{padding:calc(var(--nav-height,64px) + 18px) 16px calc(28px + env(safe-area-inset-bottom));min-height:100vh}.settingsCard{padding:18px;margin-bottom:16px}.settingsTitle{display:block;font-size:calc(21px * var(--font-scale,1));line-height:1.4}.settingsSwitch{display:flex;align-items:center;justify-content:space-between;margin:12px 0}.settingsCopy,.settingsNote,.settingsError{display:block;font-size:calc(15px * var(--font-scale,1));line-height:1.65;margin-top:12px}.settingsNote{color:#637562}.settingsError{color:#a4462c}.saveSettings{font:inherit;color:#fffdf6;background:#477f60;border:2px solid #243b31;border-radius:2px;margin-top:20px;min-height:48px;line-height:1.5;padding:12px}
