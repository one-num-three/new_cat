@import "../../../utils/pixel-theme.wxss";

.tracksScreen{
  min-height:var(--vh,100vh);
  box-sizing:border-box;
  display:flex;
  flex-direction:column;
  padding:calc(var(--nav-height,64px) + 12px) 14px 0;
  color:#332012;
}

.tracksWrap{
  flex:1;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.tracksWrap .sdvMeadowFooter{
  margin-top:8px;
}

.tracksHeader{
  padding:10px 12px;
  display:flex;
  flex-direction:column;
  gap:4px;
}

.tracksTitleRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.tracksTitle{
  font-size:calc(19px * var(--font-scale,1));
  color:#24451c;
}

.tracksSub{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  color:#2c6122;
}

.trackMapCard{
  padding:0;
  overflow:hidden;
}

.trackMap{
  display:block;
  width:100%;
  height:calc(var(--vh,100vh) * .35);
  min-height:200px;
  max-height:340px;
  background:#dce8df;
}

.trackEmpty{
  padding:36px 18px;
  text-align:center;
  background:#f5dcab;
  color:#5e3616;
  font-size:calc(14px * var(--font-scale,1));
}

.trackLegendBar{
  display:flex;
  align-items:center;
  gap:14px;
  padding:6px 10px;
  background:#f2cf94;
  border-top:2px solid #7b3c14;
  font-size:12px;
  color:#4f2304;
}

.trackLegendItem{
  display:inline-flex;
  align-items:center;
  gap:5px;
}

.legendDot{
  width:10px;
  height:10px;
  border:1.5px solid #3b1c0a;
  flex:none;
}

.legendDotCat{background:#e27b20}
.legendDotMouse{background:#4e8b3c}
.trackLegendMuted{margin-left:auto;color:#5e4c3c}

.trackSummary{
  padding:6px 8px;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.trackSummaryHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.trackPlayer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:8px 10px;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8,0 2px 0 #e2be7b;
}

.trackIdentity{
  display:flex;
  align-items:center;
  gap:8px;
  flex:1;
  min-width:0;
}

.trackRoleIcon{
  width:20px;
  height:20px;
  flex:none;
  image-rendering:pixelated;
}

.trackNickname{
  font-size:calc(14px * var(--font-scale,1));
  color:#332012;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.trackPointCount{
  flex:none;
  white-space:nowrap;
  font-size:calc(14px * var(--font-scale,1));
  color:#5e4c3c;
  font-variant-numeric:tabular-nums;
}

.tracksNotice,.trackError{margin:0}

.trackExportCard{
  padding:8px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.trackActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.trackFileBadge{
  display:block;
  padding:6px 10px;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ffe9bf,0 2px 0 #cfa362;
  font-size:calc(12px * var(--font-scale,1));
  color:#4f2304;
  overflow-wrap:anywhere;
}

.trackFootnote{padding:10px 12px}

.tracksFootText{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.55;
  color:#5e4c3c;
  overflow-wrap:anywhere;
}

.fontLarge .trackActions{grid-template-columns:1fr}
