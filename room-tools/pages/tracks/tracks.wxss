@import "../../../utils/pixel-theme.wxss";
.sendTrackFile{font:inherit;min-height:48px;padding:12px;background:#fcf8ed;color:#243b31;border:2px solid #477f60;margin-top:14px;line-height:1.5;overflow-wrap:anywhere}
.tracksScreen{min-height:100vh;padding:calc(var(--nav-height,64px) + 18px) 14px calc(24px + env(safe-area-inset-bottom))}.tracksTitle{display:block;font-size:calc(22px * var(--font-scale,1))}.tracksNote,.trackError{display:block;font-size:calc(14px * var(--font-scale,1));line-height:1.6;margin:12px 0;color:#637562}.trackError{color:#a4462c}.trackMap{width:100%;height:44vh;min-height:240px;border:2px solid #d6dfcb}.trackEmpty{padding:40px 20px;text-align:center}.trackSummary{padding:16px;margin-top:14px}.trackPlayer{display:flex;justify-content:space-between;gap:12px;font-size:calc(14px * var(--font-scale,1));margin-top:10px}.trackPlayer text:first-child{overflow-wrap:anywhere}.trackActions{display:flex;flex-wrap:wrap;gap:12px}.trackActions button{flex:1;min-width:130px;min-height:48px;white-space:normal;font:inherit;font-size:calc(16px * var(--font-scale,1));line-height:1.4;padding:12px;background:#477f60;color:#fffdf6;border:2px solid #243b31;border-radius:2px}
