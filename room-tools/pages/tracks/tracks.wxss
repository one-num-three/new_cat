@import "../../../utils/pixel-theme.wxss";
.sendTrackFile{width:100%!important;font:inherit;font-size:calc(16px * var(--font-scale,1));min-height:48px;padding:12px;background:#fcf8ed;color:#243b31;border:2px solid #477f60;margin-top:14px;line-height:1.5;overflow-wrap:anywhere}
.tracksScreen{min-height:var(--vh,100vh);padding:calc(var(--nav-height,64px) + 18px) 14px calc(24px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)))}.tracksTitle{display:block;font-size:calc(22px * var(--font-scale,1))}.tracksNote,.trackError{display:block;font-size:calc(14px * var(--font-scale,1));line-height:1.6;margin:12px 0;color:#637562}.trackError{color:#a4462c}.trackMap{width:100%;height:calc(var(--vh,100vh) * .44);min-height:220px;max-height:400px;border:2px solid #d6dfcb}.trackEmpty{padding:40px 20px;text-align:center}.trackSummary{padding:16px;margin-top:14px}.trackPlayer{display:flex;justify-content:space-between;gap:12px;font-size:calc(14px * var(--font-scale,1));margin-top:10px}.trackIdentity{flex:1;min-width:0}.trackNickname{display:block;overflow-wrap:anywhere}.trackRole{display:block;margin-top:4px;font-size:calc(12px * var(--font-scale,1));color:#637562}.trackPointCount{flex:none;white-space:nowrap}.trackActions{display:flex;flex-wrap:wrap;gap:12px}.trackActions button{display:flex;align-items:center;justify-content:center;flex:1 1 0;min-width:0;width:auto!important;margin:0;min-height:48px;white-space:normal;font:inherit;font-size:calc(16px * var(--font-scale,1));line-height:1.4;padding:12px;background:#477f60;color:#fffdf6;border:2px solid #243b31;border-radius:2px}

.tracksNote,.trackError{overflow-wrap:anywhere}
