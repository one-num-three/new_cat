@import "../../../utils/pixel-theme.wxss";

.shareScreen{
  min-height:var(--vh,100vh);
  box-sizing:border-box;
  display:flex;
  flex-direction:column;
  padding:calc(var(--nav-height,64px) + 8px) 14px calc(78px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
}

.shareWrap{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:8px;
}

.shareHeader{
  padding:10px 12px;
  display:flex;
  flex-direction:column;
  gap:4px;
}

.shareTitleRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.shareTitle{
  font-size:calc(19px * var(--font-scale,1));
  color:#24451c;
}

.shareSub{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  color:#2c6122;
}

.posterCard{
  width:100%;
  max-width:308px;
  margin:0 auto;
  padding:4px;
  background:transparent;
}

.fontLarge .posterCard{max-width:100%}

.posterImage{
  display:block;
  width:100%;
  height:auto;
  border:2px solid #4c7a3d;
  border-radius:0;
}

.shareEmpty{
  padding:24px 14px;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  background:#f5dcab;
  border:2px dashed #7d481e;
  border-radius:0;
}

.shareEmptyArt{
  width:118px;
  aspect-ratio:240 / 95;
  height:auto!important;
  image-rendering:pixelated;
}

.shareLoadingDots{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
}

.shareLoadingDots>view{
  width:7px;
  height:7px;
  background:#4a943b;
  border:1.5px solid #2c6122;
}

.shareEmptyTitle{
  display:block;
  font-size:calc(16px * var(--font-scale,1));
  color:#3b1d0b;
}

.shareEmptySub{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  color:#5e4c3c;
  line-height:1.45;
}

.shareMiniNote{
  padding:6px 10px;
  display:flex;
  align-items:center;
  gap:6px;
  font-size:11px;
  color:#5e3616;
}

.shareBanner,.shareFeedback,.shareError{
  margin:0;
  overflow-wrap:anywhere;
}

.shareDock{z-index:30}

.shareDock .shareError,
.shareDock .shareFeedback{
  max-height:84px;
  overflow-y:auto;
  margin:0 0 8px;
}

.shareActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.fontLarge .shareActions{grid-template-columns:1fr}

.posterCanvas{
  position:fixed;
  left:-2000px;
  top:0;
  pointer-events:none;
}
