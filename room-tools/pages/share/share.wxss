@import "../../../utils/pixel-theme.wxss";
.shareScreen{min-height:100vh;padding:calc(var(--nav-height,64px) + 18px) 14px calc(210px + env(safe-area-inset-bottom))}.shareTitle{display:block;font-size:calc(22px * var(--font-scale,1))}.shareNote,.shareError,.shareFeedback{display:block;margin:12px 0;font-size:calc(14px * var(--font-scale,1));line-height:1.6;color:#637562}.shareError{color:#a4462b}.shareFeedback{color:#356b49}.posterImage{display:block;width:100%;height:auto;border:1px solid #e0d8ba}.shareEmpty{padding:32px 16px;text-align:center}.shareDock{position:fixed;bottom:0;left:0;right:0;z-index:30;padding:10px 14px calc(12px + env(safe-area-inset-bottom));background:#fffdf0;border-top:2px solid #243b31}.shareDock .shareError,.shareDock .shareFeedback{margin:0 0 8px}.shareActions{display:flex;gap:12px;flex-wrap:wrap}.shareActions button,.shareEmpty button{font-size:calc(16px * var(--font-scale,1));font-family:inherit;white-space:normal;min-height:48px;padding:12px;line-height:1.5;background:#477f60;color:#fffdf6;border:2px solid #243b31;border-radius:2px}.shareActions button{flex:1;min-width:125px;margin:0}.shareActions button:first-child{background:#fffdf0;color:#243b31}.shareActions button[disabled]{opacity:.5}.posterCanvas{position:fixed;left:-2000px;top:0;pointer-events:none}
