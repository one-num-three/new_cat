<view class="screen shareScreen {{nightMode?'sdvNight':''}} {{fontScale>1.15?'fontLarge':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--safe-bottom:{{safeBottom}}px">
  <nav-bar pinned="{{true}}" title="个人轨迹海报" back="{{true}}" />

  <view class="shareWrap">
    <view class="sdvWoodCard posterCard">
      <image wx:if="{{posterPath}}" class="posterImage" src="{{posterPath}}" mode="widthFix" show-menu-by-longpress="{{true}}" bindtap="previewImage" />
      <view wx:else class="shareEmpty">
        <image class="shareEmptyArt" src="/assets/sdv-v1/demo-cat-mouse.png" mode="widthFix" aria-hidden="true" />
        <view wx:if="{{loading}}" class="shareLoadingDots" aria-hidden="true"><view></view><view></view><view></view></view>
        <text class="shareEmptyTitle">{{loading?'正在合成海报…':'海报未就绪'}}</text>
        <text class="shareEmptySub">{{loading?'正在绘制本次路线与里程数据…':'返回重试或检查网络后再生成'}}</text>
        <text wx:if="{{error}}" class="sdvError shareError">{{error}}</text>
        <button wx:if="{{!loading}}" class="sdvBtn sdvBtnWood sdvBtnSm" hover-class="sdvPressed" bindtap="load">重试</button>
      </view>
    </view>

    <text wx:if="{{notice && !posterPath}}" class="sdvNotice shareBanner">{{notice}}</text>

    <view class="sdvPaperCard shareMiniNote">
      <map-icon kind="info" size="13" color="#5e3616" />
      <text>仅含本人有效GPS · 断线不连线 · © OpenStreetMap</text>
    </view>
  </view>

  <view class="sdvStickyBar shareDock">
    <text wx:if="{{feedback}}" class="sdvNotice shareFeedback" role="status">{{feedback}}</text>
    <text wx:if="{{error && posterPath}}" class="sdvError shareError" role="alert">{{error}}</text>
    <button wx:if="{{needAlbumSetting}}" class="sdvBtn sdvBtnBlue sdvBtnSm permLinkBtn" hover-class="sdvPressed" bindtap="openAlbumSetting">去开启相册权限</button>
    <view class="shareActions">
      <button class="sdvBtn sdvBtnWood" hover-class="sdvPressed" bindtap="saveImage" disabled="{{!posterPath || loading || saving}}" loading="{{saving && action==='save'}}">
        <map-icon kind="download" size="16" color="#3b1d0b" />
        <text>保存相册</text>
      </button>
      <button class="sdvBtn sdvBtnGreen" hover-class="sdvPressed" bindtap="shareImage" disabled="{{!posterPath || loading || saving}}" loading="{{saving && action==='share'}}">
        <map-icon kind="share" size="16" color="#fffdf6" />
        <text>转发海报</text>
      </button>
    </view>
  </view>

  <canvas id="posterCanvas" type="2d" class="posterCanvas" style="width:941px;height:1672px" />
</view>
