@import "../../../utils/pixel-theme.wxss";
.inviteScreen{min-height:100vh;padding:calc(var(--nav-height,64px) + 24rpx) 28rpx calc(28rpx + env(safe-area-inset-bottom));color:#243b31}.invitation{padding:30rpx 26rpx;text-align:center}.inviteTitle,.inviteNote,.codeLabel,.inviteCode,.scanNote{display:block}.inviteTitle{font-size:calc(42rpx * var(--font-scale,1))}.inviteNote{font-size:calc(26rpx * var(--font-scale,1));margin:12rpx 0 22rpx;color:#637562}.roomQr{width:100%;max-width:280px;aspect-ratio:1;height:auto;background:white;display:block;margin:0 auto}.emptyQr{height:240px;display:flex;align-items:center;justify-content:center;color:#637562}.codeLabel{margin-top:20rpx;font-size:26rpx}.inviteCode{font-size:calc(40rpx * var(--font-scale,1));letter-spacing:2rpx;overflow-wrap:anywhere}.scanNote{font-size:calc(25rpx * var(--font-scale,1));line-height:1.5;margin-top:20rpx;color:#637562}.inviteActions{display:flex;flex-direction:column;gap:18rpx;margin-top:24rpx}.inviteActions button{font:inherit;font-size:calc(31rpx * var(--font-scale,1));line-height:1.4;padding:20rpx 10rpx;min-height:44px;width:100%;border:3rpx solid #243b31;border-radius:2px;background:#fcf8ed;color:#243b31}.inviteActions .shareButton{background:#477f60;color:white;box-shadow:inset 0 -6rpx #335944}.inviteError{display:block;font-size:26rpx;color:#a4462c;margin-top:18rpx;line-height:1.5}
