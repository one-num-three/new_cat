@import "../../../utils/pixel-theme.wxss";

.inviteScreen{
  min-height:var(--vh,100vh);
  box-sizing:border-box;
  display:flex;
  flex-direction:column;
  padding:calc(var(--nav-height,64px) + 12px) 14px max(var(--safe-bottom,0px),env(safe-area-inset-bottom));
  color:#332012;
}

.inviteWrap{
  flex:1;
  display:flex;
  flex-direction:column;
  gap:14px;
}

.inviteWrap .sdvMeadowFooter{
  margin-top:auto;
}

.invitation{
  padding:0;
  overflow:hidden;
}

.inviteBanner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:10px 14px;
  border:0;
  border-bottom:2px solid #38692c;
  border-radius:0;
}

.inviteTitle{
  font-size:calc(18px * var(--font-scale,1));
  color:#24451c;
}

.inviteBody{
  padding:16px 16px 16px;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
}

.inviteNote{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  line-height:1.5;
  color:#5e4c3c;
  overflow-wrap:anywhere;
}

.qrBox{
  width:100%;
  max-width:244px;
  padding:8px;
  background:#ffffff;
  border:3px solid #3b1c0a;
  border-radius:0;
  box-shadow:inset 0 0 0 3px #b5652a,inset 0 0 0 5px #e8a254,0 3px 0 #cfa96c;
  box-sizing:border-box;
}

.roomQr{
  width:100%;
  aspect-ratio:1;
  height:auto;
  display:block;
  background:#ffffff;
}

.emptyQr{
  min-height:200px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f5dcab;
  border:2px dashed #7d481e;
  border-radius:0;
  color:#5e3616;
  font-size:calc(14px * var(--font-scale,1));
}

.codePlate{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:8px 12px;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ffe9bf,inset 0 -2px 0 #cfa362,0 2px 0 #cfa96c;
  box-sizing:border-box;
}

.inviteCode{
  flex:1;
  min-width:0;
  text-align:left;
  font-size:calc(21px * var(--font-scale,1));
  letter-spacing:1.5px;
  color:#3b1d0b;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.inviteActions{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.inviteError{margin:0}
