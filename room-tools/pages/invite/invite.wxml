<view class="screen inviteScreen {{nightMode?'sdvNight':''}} {{fontScale>1.15?'fontLarge':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--safe-bottom:{{safeBottom}}px">
  <nav-bar pinned="{{true}}" title="邀请成员" back="{{true}}" />

  <view class="inviteWrap">
    <view class="sdvWoodCard invitation">
      <view class="sdvPlank inviteBanner">
        <view class="sdvIconTitle">
          <map-icon kind="code" size="18" color="#24451c" />
          <text class="inviteTitle">房间邀请码</text>
        </view>
        <text class="sdvBadge {{code?'sdvBadgeGreen':'sdvBadgeGray'}}">{{code?'可加入':'读取中'}}</text>
      </view>

      <view class="inviteBody">
        <text class="inviteNote">{{joinHint || '扫码或输码加入'}}</text>

        <view class="qrBox">
          <image wx:if="{{image}}" class="roomQr" src="{{image}}" mode="aspectFit" aria-label="房间邀请二维码" />
          <view wx:else class="roomQr emptyQr">
            <text>{{loading?'生成邀请码中…':'邀请码尚未就绪'}}</text>
          </view>
        </view>

        <view class="codePlate">
          <text class="inviteCode" selectable bindtap="copy">{{code || '—'}}</text>
          <button class="sdvIconBtn sdvIconBtnSm {{copied?'sdvBtnGreen':'sdvBtnPaper'}}" hover-class="sdvPressed" bindtap="copy" disabled="{{!code}}" aria-label="复制房间码">
            <map-icon kind="{{copied?'check':'copy'}}" size="17" color="{{copied?'#fffdf6':'#3b1d0b'}}" />
          </button>
        </view>

        <view class="inviteActions">
          <button class="sdvBtn sdvBtnGreen" hover-class="sdvPressed" open-type="share" disabled="{{!code || loading}}">
            <map-icon kind="share" size="18" color="#fffdf6" />
            <text>微信转发</text>
          </button>
          <button class="sdvBtn sdvBtnPaper sdvBtnSm" hover-class="sdvPressed" wx:if="{{error}}" bindtap="load">重新加载</button>
        </view>
      </view>
    </view>

    <text wx:if="{{error}}" class="sdvError inviteError" role="alert">{{error}}</text>
    <view class="meadowFooterStage meadowBleed14">
      <image class="fenceMascot" src="/assets/sdv-v1/hud-cat.png" mode="aspectFit" aria-hidden="true" />
      <image class="sdvMeadowFooter" src="/assets/sdv-v1/meadow-strip.png" mode="widthFix" aria-hidden="true" />
    </view>
  </view>
</view>
