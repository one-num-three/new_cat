@import "../../utils/pixel-theme.wxss";

.homeScreen{
  --vw:100vw;
  --vh:100vh;
  box-sizing:border-box;
  width:var(--vw,100vw);
  min-height:var(--vh);
  padding-top:var(--nav-height,64px);
  padding-bottom:calc(12rpx + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;
  overflow-x:hidden;
}

.homeMain{
  padding:12rpx 22rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:10rpx;
  box-sizing:border-box;
}

.bulletinBoard{
  position:relative;
  overflow:visible;
  padding:0;
  margin-top:4px;
}

.heroStage{
  overflow:hidden;
  padding:0;
}

.boardPost{
  position:absolute;
  top:-16px;
  width:14px;
  height:6px;
  background:#8a4d1e;
  border:2px solid #3b1c0a;
  border-bottom:0;
  box-shadow:inset 0 2px 0 #c9813f;
  pointer-events:none;
  z-index:2;
}

.boardPostLeft{left:22px}
.boardPostRight{right:22px}

.boardGroundShadow{
  position:absolute;
  left:10px;
  right:10px;
  bottom:-16px;
  height:6px;
  background:rgba(72,118,46,.32);
  pointer-events:none;
  z-index:0;
}

.boardBody{
  padding:8rpx 8rpx 6rpx;
  display:flex;
  flex-direction:column;
  gap:8rpx;
}

.boardDivider{
  height:0;
  border-top:2px dashed #b58447;
  margin:2rpx 0;
}

.joinSection{
  display:flex;
  flex-direction:column;
  gap:8rpx;
}

.homeHero{
  display:block;
  width:100%;
  aspect-ratio:750 / 288!important;
  height:auto!important;
  image-rendering:pixelated;
}

.heroCaption{
  padding:7rpx 14rpx;
  background:#d4ebba;
  border-top:2px solid #4f2710;
  box-shadow:inset 0 2px 0 #ecf7df,inset 0 -2px 0 #a9cf88;
  text-align:center;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.3;
  color:#24451c;
}

.resumeBand{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  width:100%!important;
  margin:0;
  padding:2px 8px;
  min-height:40px;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#4f2304;
  text-align:left;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.3;
}

.resumeBand::after{border:0}
.resumeLeft{display:flex;align-items:center;gap:8rpx;flex:1;min-width:0}
.resumeText{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.resumeAction{flex:none;color:#7b3c14;font-size:calc(24rpx * var(--font-scale,1))}
.resumeBand[disabled]{opacity:.65}

.identityBar{
  display:flex;
  align-items:center;
  gap:8rpx;
  padding:0;
}

.randNameBtn{
  flex:none;
}

.identityLabelWrap{
  display:flex;
  align-items:center;
  gap:6rpx;
  flex:none;
}

.identityLabel{
  font-size:calc(27rpx * var(--font-scale,1));
  line-height:1.3;
  color:#332012;
  white-space:nowrap;
}

.identityInput{
  flex:1;
  min-width:0;
  height:calc(66rpx * var(--font-scale,1));
  min-height:40px;
  font-size:calc(28rpx * var(--font-scale,1));
}

.fieldPlaceholder{
  color:#6e5a44;
  font-weight:400;
}

.entryCard{
  padding:6rpx 8rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:10rpx;
}

.cardHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
}

.codeEntryRow{
  display:flex;
  align-items:center;
  gap:8rpx;
}

.codeInput{
  flex:1;
  min-width:0;
  height:calc(80rpx * var(--font-scale,1));
  min-height:44px;
  font-size:calc(28rpx * var(--font-scale,1));
  letter-spacing:1rpx;
}

.pasteIconBtn,
.scanIconBtn{
  flex:none;
  width:calc(84rpx * var(--font-scale,1))!important;
  min-width:46px;
  height:calc(80rpx * var(--font-scale,1));
  min-height:44px;
}

.inviteLandingHint{
  display:block;
  overflow-wrap:anywhere;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.4;
  color:#2c6122;
}

.cardAction{margin-top:2rpx}
.homeError{margin:0}

.guideMiniCard{
  padding:12rpx 12rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:8rpx;
}

.guideStepStrip{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:6rpx;
  padding:4rpx 2rpx 8rpx;
}

.guideStepItem{
  display:flex;
  align-items:center;
  gap:5rpx;
  min-width:0;
}

.stepNum{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:32rpx;
  height:32rpx;
  flex:none;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  color:#4f2304;
  font-size:calc(20rpx * var(--font-scale,1));
  line-height:1;
}

.guideStepIcon{
  display:block;
  width:36rpx;
  height:36rpx;
  flex:none;
  image-rendering:pixelated;
}

.stepLabel{
  font-size:calc(24rpx * var(--font-scale,1));
  color:#3b1d0b;
  line-height:1.25;
  white-space:nowrap;
}

.stepArrow{
  flex:none;
  font-size:calc(24rpx * var(--font-scale,1));
  color:#9c6430;
  line-height:1;
}

.signpostRow{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:14rpx;
  padding-top:6rpx;
  border-top:2px dashed #b58447;
}

.signpostLink{
  display:inline-flex!important;
  align-items:center;
  justify-content:center;
  gap:6rpx;
  width:auto!important;
  min-height:36px;
  margin:0!important;
  padding:4px 10px!important;
  background:transparent;
  color:#5e3616;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-size:calc(25rpx * var(--font-scale,1));
  line-height:1.3;
  border-radius:0;
}

.signpostLink::after{border:0}
.signpostDivider{color:#9db890;font-size:24rpx}

.devLink{
  width:auto;
  min-height:40px;
  margin:0 auto;
  padding:6rpx 18rpx;
  background:transparent;
  color:#5e4c3c;
  font-size:calc(24rpx * var(--font-scale,1));
  font-weight:400;
  line-height:1.5;
  text-decoration:underline;
  border-radius:0;
}

.devLink::after{border:0}

.narrowCanvas .homeMain{padding:14rpx 16rpx 8rpx}
.narrowCanvas .codeInput{font-size:calc(25rpx * var(--font-scale,1))}
.fontLarge .identityBar{flex-wrap:wrap}
.fontLarge .identityLabelWrap{flex-basis:100%}
.fontLarge .identityInput{flex-basis:100%;width:100%}
.fontLarge .guideStepStrip{flex-wrap:wrap;justify-content:center;row-gap:8rpx}
