@import "../../utils/pixel-theme.wxss";

.homeScreen{
  --vw:100vw;
  --vh:100vh;
  box-sizing:border-box;
  width:var(--vw,100vw);
  min-height:var(--vh);
  padding-top:var(--nav-height,64px);
  padding-bottom:calc(12rpx + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;
  overflow-x:hidden;
}

.homeMain{
  padding:12rpx 22rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:10rpx;
  box-sizing:border-box;
}

.bulletinBoard{
  overflow:visible;
  padding:0;
  margin-top:4px;
}

.heroStage{
  overflow:hidden;
  padding:0;
}

.boardPost{
  position:absolute;
  top:-16px;
  width:14px;
  height:6px;
  background:#8a4d1e;
  border:2px solid #3b1c0a;
  border-bottom:0;
  box-shadow:inset 0 2px 0 #c9813f;
  pointer-events:none;
  z-index:2;
}

.boardPostLeft{left:22px}
.boardPostRight{right:22px}

.boardTuft{
  position:absolute;
  width:4px;
  height:4px;
  pointer-events:none;
  z-index:3;
}

.boardTuftLeft{
  left:-14px;
  top:92px;
  background:#4a943b;
  box-shadow:0 4px 0 #2c6122,4px 4px 0 #82cf6f,-4px 4px 0 #2c6122,0 -4px 0 #82cf6f,4px 0 0 #ffe066;
}

.boardTuftRight{
  right:-14px;
  bottom:-10px;
  background:#4a943b;
  box-shadow:-4px 0 0 #82cf6f,0 -4px 0 #2c6122,4px 0 0 #2c6122,-4px -4px 0 #ffe066,-8px 0 0 #4a943b;
}

.boardBody{
  padding:8rpx 8rpx 6rpx;
  display:flex;
  flex-direction:column;
  gap:8rpx;
}

.boardDivider{
  height:0;
  border-top:2px dashed #b58447;
  margin:2rpx 0;
}

.joinSection{
  display:flex;
  flex-direction:column;
  gap:8rpx;
}

.homeHero{
  display:block;
  width:100%;
  aspect-ratio:750 / 288!important;
  height:auto!important;
  image-rendering:pixelated;
}

.heroCaption{
  padding:7rpx 14rpx;
  background:#d4ebba;
  border-top:2px solid #4f2710;
  box-shadow:inset 0 2px 0 #ecf7df,inset 0 -2px 0 #a9cf88;
  text-align:center;
  font-size:calc(22rpx * var(--font-scale,1));
  line-height:1.3;
  color:#24451c;
}

.resumeBand{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  width:100%!important;
  margin:0;
  padding:6rpx 12rpx;
  min-height:38px;
  border-width:8px;
  border-image-width:8px;
  text-align:left;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.3;
}

.resumeBand::after{border:0}
.resumeLeft{display:flex;align-items:center;gap:8rpx;flex:1;min-width:0}
.resumeText{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.resumeAction{flex:none;color:#a64d0b;font-size:calc(23rpx * var(--font-scale,1))}
.resumeBand[disabled]{opacity:.65}

.identityBar{
  display:flex;
  align-items:center;
  gap:8rpx;
  padding:0;
}

.randNameBtn{
  flex:none;
}

.identityLabelWrap{
  display:flex;
  align-items:center;
  gap:6rpx;
  flex:none;
}

.identityLabel{
  font-size:calc(27rpx * var(--font-scale,1));
  line-height:1.3;
  color:#332012;
  white-space:nowrap;
}

.identityInput{
  flex:1;
  min-width:0;
  height:calc(66rpx * var(--font-scale,1));
  min-height:40px;
  font-size:calc(28rpx * var(--font-scale,1));
}

.fieldPlaceholder{
  color:#8d9986;
  font-weight:400;
}

.entryCard{
  padding:6rpx 8rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:10rpx;
}

.cardHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
}

.codeEntryRow{
  display:flex;
  align-items:center;
  gap:8rpx;
}

.codeInput{
  flex:1;
  min-width:0;
  height:calc(80rpx * var(--font-scale,1));
  min-height:44px;
  font-size:calc(28rpx * var(--font-scale,1));
  letter-spacing:1rpx;
}

.pasteIconBtn,
.scanIconBtn{
  flex:none;
  width:calc(84rpx * var(--font-scale,1))!important;
  min-width:46px;
  height:calc(80rpx * var(--font-scale,1));
  min-height:44px;
}

.inviteLandingHint{
  display:block;
  overflow-wrap:anywhere;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.4;
  color:#2c6122;
}

.cardAction{margin-top:2rpx}
.homeError{margin:0}

.guideMiniCard{
  padding:12rpx 12rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:10rpx;
}

.guideFlowRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:6rpx;
}

.guideFlowItem{
  flex:1;
  min-width:0;
  padding:8rpx 4rpx;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8,inset 0 -2px 0 #e6cb99;
  text-align:center;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:4rpx;
}

.guideFlowArrow{
  flex:none;
  color:#7c522b;
  font-size:28rpx;
  line-height:1;
}

.guideStepIcon{
  width:38rpx;
  height:38rpx;
  display:block;
}

.guideStepIconBox{
  width:38rpx;
  height:38rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.guideStepTitle{
  display:block;
  font-size:calc(22rpx * var(--font-scale,1));
  color:#2c6122;
  line-height:1.25;
}

.signpostRow{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:14rpx;
  padding-top:6rpx;
  border-top:2px dashed #b58447;
}

.signpostLink{
  display:inline-flex!important;
  align-items:center;
  justify-content:center;
  gap:6rpx;
  width:auto!important;
  min-height:36px;
  margin:0!important;
  padding:4px 10px!important;
  background:transparent;
  color:#5e3616;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.3;
  border-radius:0;
}

.signpostLink::after{border:0}
.signpostDivider{color:#9db890;font-size:24rpx}

.devLink{
  width:auto;
  min-height:40px;
  margin:0 auto;
  padding:6rpx 18rpx;
  background:transparent;
  color:#5e4c3c;
  font-size:calc(23rpx * var(--font-scale,1));
  font-weight:400;
  line-height:1.5;
  text-decoration:underline;
  border-radius:0;
}

.devLink::after{border:0}

.narrowCanvas .homeMain{padding:14rpx 16rpx 8rpx}
.narrowCanvas .codeInput{font-size:calc(25rpx * var(--font-scale,1))}
.fontLarge .identityBar{flex-wrap:wrap}
.fontLarge .identityLabelWrap{flex-basis:100%}
.fontLarge .identityInput{flex-basis:100%;width:100%}
.fontLarge .guideFlowRow{flex-wrap:wrap}
