@import "../../utils/pixel-theme.wxss";

.homeScreen{
  --vw:100vw;
  --vh:100vh;
  box-sizing:border-box;
  width:var(--vw,100vw);
  min-height:var(--vh);
  display:flex;
  flex-direction:column;
  padding-top:var(--nav-height,64px);
  padding-bottom:0;
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;
  overflow-x:hidden;
}

.homeMain{
  flex:1;
  padding:6rpx 22rpx 0;
  display:flex;
  flex-direction:column;
  gap:0;
  box-sizing:border-box;
}

.homeContent{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:16rpx;
  padding:8rpx 0 8rpx;
  box-sizing:border-box;
}

.homeMain .sdvMeadowFooter{
  margin-top:0;
  flex:none;
}

.bulletinBoard{
  position:relative;
  overflow:visible;
  padding:0;
  margin-top:2px;
}

.heroStage{
  overflow:hidden;
  padding:0;
}

.boardPost{
  position:absolute;
  top:-16px;
  width:14px;
  height:6px;
  background:#8a4d1e;
  border:2px solid #3b1c0a;
  border-bottom:0;
  box-shadow:inset 0 2px 0 #c9813f;
  pointer-events:none;
  z-index:2;
}

.boardPostLeft{left:22px}
.boardPostRight{right:22px}

.boardGroundShadow{
  position:absolute;
  left:10px;
  right:10px;
  bottom:-16px;
  height:6px;
  background:rgba(72,118,46,.32);
  pointer-events:none;
  z-index:0;
}

.boardBody{
  padding:14rpx 14rpx 12rpx;
  display:flex;
  flex-direction:column;
  gap:12rpx;
}

.boardDivider{
  height:0;
  border-top:2px dashed #b58447;
  margin:4rpx 0;
}

.joinSection{
  display:flex;
  flex-direction:column;
  gap:12rpx;
}

.homeHero{
  display:block;
  width:100%;
  aspect-ratio:384 / 256!important;
  height:auto!important;
  image-rendering:pixelated;
}

.heroCaption{
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  padding:5rpx 12rpx;
  background:#d4ebba;
  border-top:2px solid #4f2710;
  box-shadow:inset 0 2px 0 #ecf7df,inset 0 -2px 0 #a9cf88;
  text-align:center;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.3;
  color:#24451c;
}

.resumeBandRow{
  display:flex;
  align-items:stretch;
  gap:6rpx;
}

.resumeBand{
  flex:1;
  min-width:0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  width:100%!important;
  margin:0;
  padding:2px 8px;
  min-height:40px;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#4f2304;
  text-align:left;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.3;
}

.resumeBand::after{border:0}
.resumeLeft{display:flex;align-items:center;gap:8rpx;flex:1;min-width:0}
.resumeText{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.resumeAction{flex:none;color:#7b3c14;font-size:calc(24rpx * var(--font-scale,1))}
.resumeBand[disabled]{opacity:.65}

.resumeDismiss{
  flex:none;
  font-size:18px;
  color:#5e3616;
}

.identityBar{
  display:flex;
  align-items:center;
  gap:12rpx;
  padding:0;
}

.identityCompact{
  display:flex;
  align-items:center;
  gap:12rpx;
}

.identityCompactBtn{
  flex:1;
  min-width:0;
  display:flex;
  align-items:center;
  gap:8rpx;
  min-height:36px;
  padding:4rpx 12rpx;
  background:#fff3d6;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8;
  box-sizing:border-box;
}

.identityCompactLabel{
  flex:none;
  font-size:calc(24rpx * var(--font-scale,1));
  color:#5e3616;
  white-space:nowrap;
}

.identityCompactName{
  flex:1;
  min-width:0;
  font-size:calc(28rpx * var(--font-scale,1));
  color:#3b1d0b;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.randNameBtn{
  flex:none;
}

.identityLabelWrap{
  display:flex;
  align-items:center;
  gap:6rpx;
  flex:none;
}

.identityLabel{
  font-size:calc(27rpx * var(--font-scale,1));
  line-height:1.3;
  color:#332012;
  white-space:nowrap;
}

.identityInput{
  flex:1;
  min-width:0;
  height:calc(66rpx * var(--font-scale,1));
  min-height:40px;
  font-size:calc(28rpx * var(--font-scale,1));
}

.fieldPlaceholder{
  color:#6e5a44;
  font-weight:400;
}

.secondaryActionWrap{
  padding:4rpx 0;
}

.cardHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
}

.codeEntryRow{
  display:flex;
  align-items:center;
  gap:12rpx;
}

.codeInputWrap{
  position:relative;
  flex:1;
  min-width:0;
}

.codeInput{
  width:100%;
  min-width:0;
  height:calc(74rpx * var(--font-scale,1));
  min-height:40px;
  font-size:calc(28rpx * var(--font-scale,1));
  letter-spacing:1rpx;
}

.codeInput.hasClear{
  padding-right:34px;
}

.clearCodeBtn{
  position:absolute;
  right:6px;
  top:50%;
  transform:translateY(-50%);
  width:24px!important;
  min-width:24px;
  height:24px;
  min-height:24px;
  margin:0!important;
  padding:0!important;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#e8d8b7;
  border:1.5px solid #7b3c14;
  color:#3b1d0b;
  font-size:15px;
  line-height:1;
}

.clearCodeBtn::after{border:0}

.pasteIconBtn,
.scanIconBtn{
  flex:none;
  width:calc(80rpx * var(--font-scale,1))!important;
  min-width:44px;
  height:calc(74rpx * var(--font-scale,1));
  min-height:40px;
}

.clipSuggestChip{
  display:flex!important;
  align-items:center;
  gap:8rpx;
  width:100%!important;
  margin:0!important;
  padding:4rpx 10rpx!important;
  min-height:32px;
  background:#d4ebba;
  border:2px solid #35692a;
  border-radius:0;
  box-shadow:inset 0 1px 0 #ecf7df;
  color:#24451c;
  font-size:calc(23rpx * var(--font-scale,1));
  line-height:1.3;
  text-align:left;
  box-sizing:border-box;
}

.clipSuggestChip::after{border:0}

.clipSuggestText{
  flex:1;
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.clipSuggestAction{
  flex:none;
  padding:2rpx 10rpx;
  background:#4a943b;
  border:1.5px solid #2c6122;
  color:#fffdf6;
  font-size:calc(21rpx * var(--font-scale,1));
  line-height:1.25;
}

.clipManualChip{
  background:#fff2d4;
  border-color:#b58447;
  color:#5e3616;
  box-shadow:inset 0 1px 0 #fff9e8;
}

.clipManualAction{
  background:#b58447;
  border-color:#7b3c14;
  color:#fffdf6;
}

.inviteLandingHint{
  display:block;
  overflow-wrap:anywhere;
  font-size:calc(24rpx * var(--font-scale,1));
  line-height:1.4;
  color:#2c6122;
}

.cardAction{margin-top:6rpx}
.homeError{margin:0}

.signpostBar{
  padding:4rpx 10rpx;
}

.signpostRow{
  display:flex;
  align-items:center;
  justify-content:space-evenly;
  gap:6rpx;
}

.signpostLink{
  display:inline-flex!important;
  align-items:center;
  justify-content:center;
  gap:6rpx;
  width:auto!important;
  min-height:34px;
  margin:0!important;
  padding:4px 6px!important;
  background:transparent;
  color:#5e3616;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-size:calc(23rpx * var(--font-scale,1));
  line-height:1.3;
  border-radius:0;
  white-space:nowrap;
}

.signpostLink::after{border:0}
.signpostDivider{color:#9db890;font-size:24rpx}

.devLink{
  width:auto;
  min-height:40px;
  margin:0 auto;
  padding:6rpx 18rpx;
  background:transparent;
  color:#5e4c3c;
  font-size:calc(24rpx * var(--font-scale,1));
  font-weight:400;
  line-height:1.5;
  text-decoration:underline;
  border-radius:0;
}

.devLink::after{border:0}

.guideStepList{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.guideStepCard{
  padding:8px 10px;
  background:#fff3d6;
  border:2px solid #b58447;
  box-shadow:inset 0 1px 0 #fff9e8;
}

.guideStepTitle{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  color:#2c6122;
  margin-bottom:2px;
}

.guideStepDesc{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.45;
  color:#3b1d0b;
}

.consentList{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.consentCard{
  padding:8px 10px;
  background:#fff3d6;
  border:2px solid #b58447;
  box-shadow:inset 0 1px 0 #fff9e8;
}

.consentTitle{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  color:#2c6122;
  margin-bottom:3px;
}

.consentCopy{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.5;
  color:#3b1d0b;
}

.consentLinkBtn{
  width:auto!important;
  margin:6px 0 0!important;
  padding:2px 0!important;
  min-height:24px;
  text-align:left;
  background:transparent;
  color:#1e5880;
  font-size:calc(12px * var(--font-scale,1));
  text-decoration:underline;
}

.consentLinkBtn::after{border:0}

.narrowCanvas .homeMain{padding:6rpx 16rpx 0}
.narrowCanvas .codeInput{font-size:calc(25rpx * var(--font-scale,1))}
.fontLarge .identityBar{flex-wrap:wrap}
.fontLarge .identityLabelWrap{flex-basis:100%}
.fontLarge .identityInput{flex-basis:100%;width:100%}
