/* pages/index/index.wxss */
.container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-top: 10rpx;
}

/* 昵称设置 */
.nickname-section {
  width: 100%;
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
}

.nickname-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  display: block;
}

.nickname-input-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  background: #fafafa;
}

.nickname-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  color: #333;
}

.nickname-count {
  font-size: 24rpx;
  color: #999;
}

.game-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 40rpx;
  width: 100%;
}

.action-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 30rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
}

.action-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.action-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.tips {
  margin-top: 60rpx;
  width: 100%;
}

.tip-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  color: rgba(255,255,255,0.9);
  font-size: 28rpx;
}

.tip-icon {
  margin-right: 15rpx;
  font-size: 32rpx;
}

.footer {
  margin-top: auto;
  padding: 40rpx 0;
  text-align: center;
}

.tip {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* 测试区域 */
.test-section {
  margin-top: 40rpx;
  width: 100%;
  text-align: center;
}

.test-btn {
  background: rgba(255,255,255,0.2);
  color: #fff;
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 12rpx;
  padding: 20rpx 40rpx;
  font-size: 26rpx;
}

.test-btn::after {
  border: none;
}

.test-result {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,0.2);
  padding: 15rpx 20rpx;
  border-radius: 8rpx;
}

.version {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
}
