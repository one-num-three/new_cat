<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="logo">🐱🐭</view>
    <text class="title">猫鼠游戏</text>
    <text class="subtitle">线下实景追逐 · 线上实时定位</text>
  </view>

  <!-- 游戏操作区 -->
  <view class="game-actions">
    <view class="action-card" bindtap="onCreateGame">
      <text class="action-icon">➕</text>
      <text class="action-text">创建游戏</text>
    </view>
    
    <view class="action-card" bindtap="onJoinGame">
      <text class="action-icon">🚪</text>
      <text class="action-text">加入游戏</text>
    </view>
  </view>

  <!-- 游戏说明 -->
  <view class="tips">
    <view class="tip-item">
      <text class="tip-icon">📍</text>
      <text class="tip-text">开启位置权限，实时显示位置</text>
    </view>
    <view class="tip-item">
      <text class="tip-icon">🐱</text>
      <text class="tip-text">猫抓老鼠，老鼠躲避</text>
    </view>
    <view class="tip-item">
      <text class="tip-icon">🎒</text>
      <text class="tip-text">使用道具：加速、隐身、雷达</text>
    </view>
    <view class="tip-item">
      <text class="tip-icon">⏱️</text>
      <text class="tip-text">时间到或全被抓则游戏结束</text>
    </view>
  </view>

  <!-- 底部说明 -->
  <view class="footer">
    <text class="tip">🎮 线下进行，线上显示位置</text>
    <text class="version" wx:if="{{serverVersion}}">v{{serverVersion}} ({{serverVersionDate}})</text>
  </view>
</view>
