<view class="sdvScreen homeScreen {{themeMode==='night'?'sdvNight sdvDeepNight':themeMode==='dusk'?'sdvNight sdvDusk':nightMode?'sdvNight sdvDeepNight':''}} {{fontScale>1.15?'fontLarge':''}} {{viewportWidth<350?'narrowCanvas':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--safe-bottom:{{safeBottom}}px">
  <nav-bar pinned="{{true}}" title="猫鼠行动" preview="{{devPreview}}" />
  <view class="homeMain">
    <view class="homeContent">
      <view wx:if="{{resumeKind}}" class="resumeBandRow">
        <button class="sdvPlank resumeBand" hover-class="sdvPressed" disabled="{{resumeKind==='checking'}}" bindtap="restore">
          <view class="resumeLeft">
            <map-icon kind="{{resumeKind==='match'?'flag':'door'}}" size="15" color="#6e3608" />
            <text class="resumeText">{{resumeKind==='room'?'等待中房间 · 点击返回':resumeKind==='match'?'活动进行中 · 一键回到':resumeKind==='result'?'上一场记录 · 查看汇总':resumeKind==='unavailable'?'房间暂不可用':'检查进行中活动…'}}</text>
          </view>
          <text class="resumeAction">{{resumeKind==='unavailable'?'重试':resumeKind==='checking'?'稍候':'继续 ›'}}</text>
        </button>
        <button wx:if="{{resumeKind==='unavailable'}}" class="sdvIconBtn sdvIconBtnSm sdvBtnPaper resumeDismiss" hover-class="sdvPressed" bindtap="dismissResume" aria-label="清除失效房间记录">×</button>
      </view>

      <view class="sdvWoodCard bulletinBoard">
        <view class="boardGroundShadow" aria-hidden="true"></view>
        <view class="heroStage">
          <image class="homeHero" src="/assets/sdv-v1/header-banner.png" mode="widthFix" aria-label="猫鼠行动户外活动工具横幅" />
          <view class="heroCaption"><text>猫追鼠躲</text><view class="sdvDot" aria-hidden="true"></view><text>户外定位</text><view class="sdvDot" aria-hidden="true"></view><text>扫码核验</text></view>
        </view>

        <view class="boardBody">
          <view wx:if="{{nickname && !editingName}}" class="identityCompact">
            <view class="identityCompactBtn" hover-class="sdvPressed" bindtap="startEditName" aria-label="修改称呼">
              <map-icon kind="user" size="15" color="#5e3616" />
              <text class="identityCompactLabel">称呼</text>
              <text class="identityCompactName">{{nickname}}</text>
              <map-icon kind="edit" size="13" color="#7c522b" />
            </view>
            <button class="sdvIconBtn sdvIconBtnSm sdvBtnPaper randNameBtn" hover-class="sdvPressed" bindtap="randomNickname" aria-label="随机称呼">
              <map-icon kind="dice" size="18" color="#5e3616" />
            </button>
          </view>
          <view wx:else class="identityBar">
            <view class="identityLabelWrap">
              <map-icon kind="user" size="16" color="#5e3616" />
              <text class="identityLabel">称呼</text>
            </view>
            <input class="sdvInput identityInput" value="{{nickname}}" maxlength="20" placeholder="输入你的称呼" placeholder-class="fieldPlaceholder" focus="{{editingName}}" bindinput="nameInput" bindblur="finishEditName" bindconfirm="finishEditName" aria-label="我的称呼" />
            <button class="sdvIconBtn sdvIconBtnSm sdvBtnPaper randNameBtn" hover-class="sdvPressed" bindtap="randomNickname" aria-label="随机称呼">
              <map-icon kind="dice" size="18" color="#5e3616" />
            </button>
          </view>

          <view class="boardDivider" aria-hidden="true"></view>

          <view class="joinSection">
            <view class="codeEntryRow">
              <view class="codeInputWrap">
                <input class="sdvInput codeInput {{code?'hasClear':''}}" value="{{code}}" maxlength="10" placeholder="输入10位房间码" placeholder-class="fieldPlaceholder" bindinput="codeInput" aria-label="10 位房间码" />
                <button wx:if="{{code}}" class="clearCodeBtn" hover-class="sdvPressed" bindtap="clearCode" aria-label="清空房间码">×</button>
              </view>
              <button class="sdvIconBtn sdvBtnWood scanIconBtn" hover-class="sdvPressed" bindtap="scanInvite" disabled="{{loading}}" aria-label="扫码获取房间码">
                <map-icon kind="scan" size="22" color="#3b1d0b" />
              </button>
            </view>
            <button wx:if="{{clipCode && !code}}" class="clipSuggestChip" hover-class="sdvPressed" bindtap="pasteClipCode" aria-label="填入剪贴板房间码">
              <map-icon kind="paste" size="14" color="#2c6122" />
              <text class="clipSuggestText">粘贴房间码 {{clipCode}}</text>
              <text class="clipSuggestAction">填入</text>
            </button>
            <button wx:elif="{{!code}}" class="clipSuggestChip clipManualChip" hover-class="sdvPressed" bindtap="readClipboardCode" aria-label="从剪贴板读取房间码">
              <map-icon kind="paste" size="14" color="#5e3616" />
              <text class="clipSuggestText">从剪贴板识别房间码</text>
              <text class="clipSuggestAction clipManualAction">粘贴</text>
            </button>
            <text wx:if="{{inviteHint}}" class="inviteLandingHint">{{inviteHint}}</text>
            <view class="cardAction">
              <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-home-join.png" label="{{code?'加入活动':'扫码加入'}}" tone="orange" dynamic="{{!code}}" loading="{{loading}}" disabled="{{loading}}" font-scale="{{fontScale}}" bindaction="joinOrScan" />
            </view>
          </view>
        </view>
      </view>

      <view class="secondaryActionWrap">
        <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-home-create.png" label="创建活动" tone="plain" loading="{{loading}}" disabled="{{loading}}" font-scale="{{fontScale}}" bindaction="create" />
      </view>

      <text wx:if="{{error}}" class="sdvError homeError" role="alert">{{error}}</text>

      <view class="sdvPaperCard signpostBar">
        <view class="signpostRow">
          <button class="signpostLink" hover-class="sdvPressed" bindtap="openVenue">
            <map-icon kind="map" size="14" color="#5e3616" />
            <text>场地地图</text>
          </button>
          <text class="signpostDivider" aria-hidden="true">|</text>
          <button class="signpostLink" hover-class="sdvPressed" bindtap="openHistory">
            <map-icon kind="clock" size="14" color="#5e3616" />
            <text>战绩</text>
          </button>
          <text class="signpostDivider" aria-hidden="true">|</text>
          <button class="signpostLink" hover-class="sdvPressed" bindtap="openGuide">
            <map-icon kind="info" size="14" color="#5e3616" />
            <text>说明</text>
          </button>
          <text class="signpostDivider" aria-hidden="true">|</text>
          <button class="signpostLink" hover-class="sdvPressed" bindtap="toggleNightMode" aria-label="{{themeMode==='night'?'切换白天模式':themeMode==='dusk'?'切换夜晚模式':'切换傍晚模式'}}">
            <map-icon kind="{{themeMode==='night'?'moon':themeMode==='dusk'?'dusk':'sun'}}" size="15" color="{{themeMode==='night'?'#b9d0ff':themeMode==='dusk'?'#ffb86c':'#5e3616'}}" />
            <text>{{themeMode==='night'?'夜晚':themeMode==='dusk'?'傍晚':'白天'}}</text>
          </button>
        </view>
      </view>

      <button wx:if="{{devAvailable}}" class="devLink" bindtap="openDev">界面调试台</button>
    </view>
    <image class="sdvMeadowFooter meadowBleed22" src="/assets/sdv-v1/meadow-strip.png" mode="widthFix" aria-hidden="true" />
  </view>

  <sdv-modal
    visible="{{guideOpen}}"
    mode="dialog"
    title="使用说明"
    content=""
    showCancel="{{false}}"
    confirmText="知道了"
    confirmTone="green"
    fontScale="{{fontScale}}"
    bindconfirm="closeGuide"
    bindclose="closeGuide"
  >
    <view class="guideStepList">
      <view class="guideStepCard">
        <text class="guideStepTitle">1. 猫队目标</text>
        <text class="guideStepDesc">按地图位置与队友配合追捕，双方停下后当面扫码完成核验。</text>
      </view>
      <view class="guideStepCard">
        <text class="guideStepTitle">2. 鼠队躲藏</text>
        <text class="guideStepDesc">利用 30 秒准备时间分散躲藏，留意近距预警或 120m 共享视野。</text>
      </view>
      <view class="guideStepCard">
        <text class="guideStepTitle">3. 安全与核验</text>
        <text class="guideStepDesc">奔走时优先留意路况，核验前务必停步；遇突发情况可随时紧急暂停。</text>
      </view>
      <button class="consentLinkBtn" hover-class="sdvPressed" bindtap="openConsent">查看《户外安全与隐私须知》</button>
    </view>
  </sdv-modal>

  <sdv-modal
    visible="{{consentOpen}}"
    mode="dialog"
    title="户外安全与隐私须知"
    content=""
    showCancel="{{true}}"
    cancelText="暂不"
    confirmText="同意并继续"
    confirmTone="green"
    fontScale="{{fontScale}}"
    bindconfirm="confirmConsent"
    bindcancel="closeConsent"
    bindclose="closeConsent"
  >
    <view class="consentList">
      <view class="consentCard">
        <text class="consentTitle">户外安全承诺</text>
        <text class="consentCopy">1. 请选择开阔平坦且远离车流、深水与台阶的公园/广场区域。\n2. 奔跑时随时留意环境与行人，扫码核验前双方务必完全停步。\n3. 如遇身体不适或现场风险，任意成员均可点击「紧急暂停」。</text>
      </view>
      <view class="consentCard">
        <text class="consentTitle">位置与隐私说明</text>
        <text class="consentCopy">本活动仅在对局选点、准备与进行期间按房间授权收集位置；轨迹仅保留 7 天，可随时在微信设置中管理位置授权。</text>
        <button class="consentLinkBtn" hover-class="sdvPressed" bindtap="openWxPrivacy">查看 {{privacyContractName}} ›</button>
      </view>
    </view>
  </sdv-modal>
</view>
