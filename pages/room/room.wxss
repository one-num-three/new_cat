@import "../../utils/pixel-theme.wxss";

page{
  height:100%;
  overflow:hidden;
}

.roomScreen{
  --vw:100vw;
  --vh:100vh;
  box-sizing:border-box;
  width:var(--vw,100vw);
  height:var(--vh,100vh);
  min-height:0;
  display:flex;
  flex-direction:column;
  padding-top:var(--nav-height,64px);
  padding-bottom:0;
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;
  overflow:hidden;
}

.createContent,.readyContent{
  flex:1;
  min-height:0;
  padding:0;
  display:flex;
  flex-direction:column;
  gap:0;
  overflow:hidden;
  box-sizing:border-box;
}

.createBody{
  flex:1;
  min-height:0;
  padding:6rpx 22rpx 0;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  box-sizing:border-box;
}

.createMain{
  flex:1;
  min-height:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:10rpx;
  padding:4rpx 0 4rpx;
  box-sizing:border-box;
}

.readyScroll{
  flex:1;
  min-height:0;
  width:100%;
  height:100%;
}

.readyInner{
  min-height:100%;
  padding:8rpx 22rpx 0;
  display:flex;
  flex-direction:column;
  box-sizing:border-box;
}

.readyMainStack{
  flex:1;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:18rpx;
  padding:8rpx 0 10rpx;
  box-sizing:border-box;
}

.roomFenceDock{
  flex:none;
  display:flex;
  flex-direction:column;
  line-height:0;
  font-size:0;
  pointer-events:none;
  margin-top:0;
}

.roomFenceDock .sdvMeadowFooter{
  display:block;
  width:100%;
  margin-top:0;
  flex:none;
}

.readyInner .meadowFooterStage{
  margin-top:0;
  flex:none;
  padding-top:12px;
}

.createHeroCard{
  flex:0 1 auto;
  min-height:0;
  display:flex;
  flex-direction:column;
  padding:0;
  overflow:hidden;
}

.createHeroMedia{
  flex:0 1 auto;
  min-height:42px;
  max-height:calc((var(--vh,100vh) - var(--nav-height,64px)) * 0.17);
  overflow:hidden;
  display:flex;
  align-items:center;
}

.createHeroImg{
  flex:none;
  display:block;
  width:100%;
  aspect-ratio:750 / 234!important;
  height:auto!important;
  image-rendering:pixelated;
}

.stepCard,.inviteCard,.rosterCard{
  padding:10rpx 12rpx;
  display:flex;
  flex-direction:column;
  gap:12rpx;
}

.createMain .stepCard{
  flex:none;
  padding:8rpx 10rpx;
  gap:8rpx;
}

.createMain .presetRow .sdvPill{
  min-height:32px;
  padding:4px 6px;
}

.summaryRibbon{
  padding:8rpx 12rpx;
  background:rgba(251,227,176,.92);
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 1px 0 #fff3d6;
  display:flex;
  flex-direction:column;
  gap:8rpx;
  box-sizing:border-box;
}

.createParamBar{
  flex:none;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-wrap:wrap;
  gap:2rpx;
  padding:2rpx 8rpx;
  text-align:center;
  font-size:calc(23rpx * var(--font-scale,1));
  line-height:1.35;
  color:#5e3616;
}

.createParamBtn{
  width:100%!important;
  margin:0;
  min-height:30px;
}

.createParamBtn::after{border:0}

.paramToggleTag{
  margin-left:6rpx;
  padding:1rpx 8rpx;
  background:#ffdba3;
  border:1.5px solid #a64d0b;
  color:#7a3303;
  font-size:calc(20rpx * var(--font-scale,1));
  line-height:1.25;
}

.sdvInfoChipTap{
  border-color:#4a943b;
}

.stepHeader,.inviteTopRow,.rosterHeading,.summaryHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  flex-wrap:wrap;
}

.presetRow{margin:0}

.teamSpriteStrip{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  padding:5rpx 8px;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8;
}

.teamSpriteGroup{
  display:flex;
  align-items:center;
  gap:8rpx;
  flex:1;
  min-width:0;
}

.teamSpriteItem{
  display:flex;
  align-items:center;
  gap:6rpx;
  flex:none;
  min-width:0;
}

.teamSpriteIcon{
  width:38rpx;
  height:38rpx;
  flex:none;
}

.teamSpriteText{
  font-size:calc(25rpx * var(--font-scale,1));
  color:#332012;
  white-space:nowrap;
}

.customIconBtn{
  flex:none;
}

.teamInputs{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12rpx;
}

.teamField{
  position:relative;
  min-width:0;
}

.teamField text{
  display:block;
  font-size:calc(24rpx * var(--font-scale,1));
  margin-bottom:6rpx;
  color:#5e4c3c;
}

.teamField input{
  width:100%;
  height:40px;
  border:2px solid #4f2710;
  border-radius:0;
  background:#fff3d6;
  box-shadow:inset 0 2px 0 #d1b482,inset 0 -2px 0 #fff9e8;
  text-align:center;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-weight:400;
  font-size:20px;
  color:transparent;
}

.teamField input.editing{color:#332012}

.teamField .teamValue{
  position:absolute;
  left:2px;
  right:2px;
  bottom:2px;
  height:36px;
  line-height:36px;
  margin:0;
  text-align:center;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-size:20px;
  color:#332012;
  pointer-events:none;
}

.roomInlineError,.roomError{flex:none;margin:0}
.permLinkBtn{flex:none}

.venueDropdown{display:block;width:100%}

.venueDropInner{
  display:flex;
  align-items:center;
  gap:8rpx;
  min-height:36px;
  padding:4px 10px;
  background:#fff3d6;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #d9bc88,0 2px 0 #cfa96c;
  box-sizing:border-box;
}

.venueDropValue{
  flex:1;
  min-width:0;
  font-size:calc(26rpx * var(--font-scale,1));
  color:#3b1d0b;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.venueDropArrow{
  flex:none;
  font-size:calc(24rpx * var(--font-scale,1));
  color:#3b1d0b;
}

.venuePreviewRow{
  display:flex;
  align-items:stretch;
  gap:16rpx;
}

.venuePreviewCopy{
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.venueState{
  display:flex;
  align-items:flex-start;
  gap:10rpx;
}

.locationPinBadge{
  flex:none;
  width:24px;
  height:24px;
  margin-top:2rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff3d6;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 1px 0 #fff9e8,0 1px 0 #cfa96c;
}

.locationPinBadge.confirmed{
  background:#4a943b;
  border-color:#2c6122;
  box-shadow:inset 0 1px 0 #82cf6f,0 1px 0 #9bc97b;
}

.venueStateCopy{min-width:0;flex:1}
.venueTitle{display:block;font-size:calc(27rpx * var(--font-scale,1));line-height:1.35;color:#332012}
.venueHint{display:block;margin-top:2rpx;font-size:calc(22rpx * var(--font-scale,1));line-height:1.35;color:#5e4c3c;overflow-wrap:anywhere}

.venueRangeBtn{
  margin-top:8rpx;
  align-self:flex-start;
  gap:6px;
}

.venueGuide{
  position:relative;
  flex:0 0 108px;
  min-width:0;
  padding:5rpx;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8,0 2px 0 #e2be7b;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}

.venueGuideImage{display:block;width:100%;height:104rpx}
.venueGuideLoading{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;height:104rpx;font-size:22rpx;color:#5e3616;text-align:center}

.codeRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:12rpx;
  padding:10rpx 14rpx;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ffe9bf,inset 0 -2px 0 #cfa362;
}

.roomCode{
  flex:1 1 auto;
  min-width:0;
  font-size:calc(32rpx * var(--font-scale,1));
  line-height:1.2;
  letter-spacing:0;
  font-variant-numeric:tabular-nums;
  color:#3b1d0b;
  white-space:nowrap;
}

.codeIconGroup{
  display:flex;
  align-items:center;
  gap:10px;
  flex:none;
}

.codeShareBtn{
  width:auto!important;
  flex:none;
  min-height:36px;
  height:36px;
  padding:0 10px;
  font-size:calc(13px * var(--font-scale,1));
  gap:4px;
}

.summaryVenueWrap{
  flex:1;
  min-width:0;
}

.summaryVenue{
  font-size:calc(26rpx * var(--font-scale,1));
  color:#3b1d0b;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.summaryChips{
  gap:6px;
}

.chipSprite{
  width:16px;
  height:16px;
  flex:none;
}

.rosterHeadRight{
  display:flex;
  align-items:center;
  gap:8rpx;
  flex:none;
}

.roomLocationSignal{
  flex:none;
  --signal-bg:#fff2d4;
  --signal-border:2px solid #b58447;
  --signal-border-image:none;
  --signal-pad:2px 7px;
  --signal-min-h:26px;
  --signal-shadow:inset 0 1px 0 #fff9e8;
  --signal-filter:none;
  --signal-color:#3b1d0b;
}

.rosterGrid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10rpx;
}

.playerCard{
  display:flex;
  align-items:center;
  gap:8rpx;
  width:100%;
  min-width:0;
  min-height:68rpx;
  padding:5rpx 8rpx;
  border-width:6px;
  border-image-width:6px;
}

.playerAvatar{display:block;flex:none;width:44rpx;height:42rpx;image-rendering:pixelated}

.playerName{
  display:block;
  flex:1;
  min-width:0;
  font-size:calc(25rpx * var(--font-scale,1));
  line-height:1.35;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.readyMark{
  flex:none;
  width:24px;
  height:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:0;
}

.hostMark{
  flex:none;
  width:18px;
  height:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#ffdba3;
  border:1.5px solid #a64d0b;
  border-radius:0;
}

.readyMark.isReady{
  background:#d4ebba;
  border:2px solid #2c6122;
}

.readyMark.isWaiting{
  background:#e8d8b7;
  border:2px solid #8a6d43;
}

.readyDot{
  color:#6b4d2b;
  font-size:16px;
  line-height:1;
}

.emptyRoster{
  padding:20rpx 14rpx;
  text-align:center;
  font-size:calc(24rpx * var(--font-scale,1));
  color:#5e4c3c;
}

.inviteSlotStack{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.stickyHint{
  display:block;
  text-align:center;
  font-size:calc(23rpx * var(--font-scale,1));
  line-height:1.35;
  color:#2c6122;
  margin-bottom:8rpx;
}

.roomActions{
  display:flex;
  flex-direction:row;
  align-items:stretch;
  gap:18rpx;
}

.roomActions .pixelControl{
  flex:1 1 0;
  min-width:0;
}

.roomActionsHostReady .pixelControl:first-child{
  flex:1.75 1 0;
}

.roomActionsHostReady .pixelControl:last-child{
  flex:0.85 1 0;
  opacity:.9;
}

.roomFooterBar{
  position:static;
  flex:none;
  width:100%;
  padding:10px 14px calc(8px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
}

.roomScreen .nativeAction{
  padding:9px 14px;
  font-size:calc(18px * var(--action-scale,1));
}

.roomActions .nativeAction{
  font-size:calc(17px * var(--action-scale,1));
  padding:11px 8px;
}

.sdvNight.sdvDeepNight .locationPinBadge{
  background:#1d1814;
  border-color:#544230;
  box-shadow:none;
}

.sdvNight.sdvDeepNight .locationPinBadge.confirmed{
  background:#2d4f2c;
  border-color:#446e42;
  box-shadow:none;
}

.narrowCanvas .createBody,.narrowCanvas .readyInner{padding:6rpx 16rpx 0}
.narrowCanvas .roomFenceDock.meadowBleed22,.narrowCanvas .meadowFooterStage.meadowBleed22{width:calc(100% + 32rpx)!important;margin-left:-16rpx;margin-right:-16rpx;}
.narrowCanvas .roomCode{font-size:calc(34rpx * var(--font-scale,1))}
.fontLarge .venuePreviewRow{flex-wrap:wrap}
.fontLarge .venueGuide{flex:0 0 100%}
.fontLarge .rosterGrid{grid-template-columns:1fr}
.fontLarge .codeRow{flex-wrap:wrap}
.fontLarge .roomActions{flex-direction:column}
