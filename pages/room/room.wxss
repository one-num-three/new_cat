@import "../../utils/pixel-theme.wxss";

.roomScreen{
  --vw:100vw;
  --vh:100vh;
  box-sizing:border-box;
  width:var(--vw,100vw);
  min-height:var(--vh);
  display:flex;
  flex-direction:column;
  padding-top:var(--nav-height,64px);
  padding-bottom:calc(104px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;
  overflow-x:hidden;
}

.createContent,.readyContent{
  padding:10rpx 22rpx 0;
  display:flex;
  flex-direction:column;
  gap:10rpx;
  box-sizing:border-box;
}

.readyContent{
  flex:1;
}

.readyContent .sdvMeadowFooter{
  margin-top:auto;
  padding-top:8rpx;
}

.createHeroCard{
  overflow:hidden;
  padding:0;
}

.createHeroImg{
  display:block;
  width:100%;
  aspect-ratio:750 / 234!important;
  height:auto!important;
  image-rendering:pixelated;
}

.stepCard,.inviteCard,.summaryToolCard,.rosterCard{
  padding:6rpx 8rpx;
  display:flex;
  flex-direction:column;
  gap:8rpx;
}

.paramBar{
  padding:4rpx 6rpx;
}

.paramChips{
  justify-content:space-between;
}

.stepHeader,.inviteTopRow,.rosterHeading,.summaryHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  flex-wrap:wrap;
}

.presetRow{margin:0}

.teamSpriteStrip{
  display:flex;
  align-items:center;
  gap:10rpx;
  padding:8rpx 10px;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8;
}

.teamSpriteItem{
  display:flex;
  align-items:center;
  gap:6rpx;
  flex:1;
  min-width:0;
}

.teamSpriteIcon{
  width:38rpx;
  height:38rpx;
  flex:none;
}

.teamSpriteText{
  font-size:calc(25rpx * var(--font-scale,1));
  color:#332012;
  white-space:nowrap;
}

.customIconBtn{
  flex:none;
}

.teamInputs{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12rpx;
}

.teamField{
  position:relative;
  min-width:0;
}

.teamField text{
  display:block;
  font-size:calc(24rpx * var(--font-scale,1));
  margin-bottom:6rpx;
  color:#5e4c3c;
}

.teamField input{
  width:100%;
  height:48px;
  border:2px solid #4f2710;
  border-radius:0;
  background:#fff3d6;
  box-shadow:inset 0 2px 0 #d1b482,inset 0 -2px 0 #fff9e8;
  text-align:center;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-weight:400;
  font-size:24px;
  color:transparent;
}

.teamField input.editing{color:#332012}

.teamField .teamValue{
  position:absolute;
  left:2px;
  right:2px;
  bottom:2px;
  height:44px;
  line-height:44px;
  margin:0;
  text-align:center;
  font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;
  font-size:24px;
  color:#332012;
  pointer-events:none;
}

.roomInlineError,.roomError{margin:0}

.venueDropdown{display:block;width:100%}

.venueDropInner{
  display:flex;
  align-items:center;
  gap:8rpx;
  min-height:42px;
  padding:6px 10px;
  background:#fff3d6;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #d9bc88,0 2px 0 #cfa96c;
  box-sizing:border-box;
}

.venueDropValue{
  flex:1;
  min-width:0;
  font-size:calc(26rpx * var(--font-scale,1));
  color:#3b1d0b;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.venueDropArrow{
  flex:none;
  font-size:calc(24rpx * var(--font-scale,1));
  color:#3b1d0b;
}

.venuePreviewRow{
  display:flex;
  align-items:stretch;
  gap:14rpx;
}

.venuePreviewCopy{
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.venueState{
  display:flex;
  align-items:flex-start;
  gap:12rpx;
}

.locationPin{
  position:relative;
  flex:none;
  width:28rpx;
  height:28rpx;
  margin-top:4rpx;
  border:4rpx solid #4f2710;
  border-radius:50% 50% 50% 0;
  transform:rotate(-45deg);
  background:#d8e3cd;
}

.locationPin::after{
  content:"";
  position:absolute;
  inset:6rpx;
  background:#fffdf6;
  border-radius:50%;
  border:2rpx solid #4f2710;
}

.locationPin.confirmed{background:#4a943b}

.venueStateCopy{min-width:0;flex:1}
.venueTitle{display:block;font-size:calc(27rpx * var(--font-scale,1));line-height:1.35;color:#332012}
.venueHint{display:block;margin-top:4rpx;font-size:calc(22rpx * var(--font-scale,1));line-height:1.4;color:#5e4c3c;overflow-wrap:anywhere}

.venueGuide{
  flex:0 0 42%;
  min-width:0;
  padding:8rpx;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8,0 2px 0 #e2be7b;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}

.venueGuideImage{display:block;width:100%;height:140rpx}
.venueGuideLoading{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;height:140rpx;font-size:22rpx;color:#5e3616;text-align:center}

.codeRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10rpx;
  padding:8rpx 12rpx;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ffe9bf,inset 0 -2px 0 #cfa362;
}

.roomCode{
  flex:1;
  min-width:0;
  font-size:calc(40rpx * var(--font-scale,1));
  line-height:1.2;
  letter-spacing:0.5rpx;
  font-variant-numeric:tabular-nums;
  color:#3b1d0b;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.codeIconGroup{
  display:flex;
  align-items:center;
  gap:6px;
  flex:none;
}

.summaryVenueWrap{
  flex:1;
  min-width:0;
}

.summaryVenue{
  font-size:calc(26rpx * var(--font-scale,1));
  color:#3b1d0b;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.summaryChips{
  gap:6px;
}

.chipSprite{
  width:16px;
  height:16px;
  flex:none;
}

.rosterHeadRight{
  display:flex;
  align-items:center;
  gap:8rpx;
  flex:none;
}

.rosterGrid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:6rpx;
}

.playerCard{
  display:flex;
  align-items:center;
  gap:6rpx;
  width:100%;
  min-width:0;
  min-height:66rpx;
  padding:3rpx 6rpx;
  border-width:6px;
  border-image-width:6px;
}

.playerAvatar{display:block;flex:none;width:44rpx;height:42rpx}

.playerName{
  display:block;
  flex:1;
  min-width:0;
  font-size:calc(25rpx * var(--font-scale,1));
  line-height:1.35;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.readyMark{
  flex:none;
  width:24px;
  height:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:0;
}

.hostMark{
  flex:none;
  width:18px;
  height:18px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#ffdba3;
  border:1.5px solid #a64d0b;
  border-radius:0;
}

.readyMark.isReady{
  background:#d4ebba;
  border:2px solid #2c6122;
}

.readyMark.isWaiting{
  background:#e8d8b7;
  border:2px solid #8a6d43;
}

.readyDot{
  color:#6b4d2b;
  font-size:16px;
  line-height:1;
}

.emptyRoster{
  padding:20rpx 14rpx;
  text-align:center;
  font-size:calc(24rpx * var(--font-scale,1));
  color:#5e4c3c;
}

.inviteSlotStack{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.stickyHint{
  display:block;
  text-align:center;
  font-size:calc(23rpx * var(--font-scale,1));
  line-height:1.35;
  color:#2c6122;
  margin-bottom:8rpx;
}

.roomActions{
  display:flex;
  flex-direction:row;
  align-items:stretch;
  gap:10rpx;
}

.roomActions .pixelControl{
  flex:1 1 0;
  min-width:0;
}

.roomActions .nativeAction{
  font-size:calc(17px * var(--action-scale,1));
  padding:11px 8px;
}

.narrowCanvas .createContent,.narrowCanvas .readyContent{padding:14rpx 16rpx 0}
.narrowCanvas .roomCode{font-size:calc(34rpx * var(--font-scale,1))}
.fontLarge .venuePreviewRow{flex-wrap:wrap}
.fontLarge .venueGuide{flex:0 0 100%}
.fontLarge .rosterGrid{grid-template-columns:1fr}
.fontLarge .codeRow{flex-wrap:wrap}
.fontLarge .roomActions{flex-direction:column}
