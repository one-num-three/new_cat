@import "../../utils/pixel-theme.wxss";
.roomScreen{--vw:100vw;--vh:100vh;box-sizing:border-box;width:100%;min-height:var(--vh);padding-top:var(--nav-height,64px);padding-bottom:calc(20rpx + env(safe-area-inset-bottom));background:#fcf8ed;color:#050b14;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;overflow-x:hidden}
.roomHero{display:block;width:100%;height:auto}
