.paperFrame{position:relative;box-sizing:border-box;background:#fcf9f0;border:3rpx solid #e8dfce;clip-path:polygon(14rpx 0,calc(100% - 14rpx) 0,calc(100% - 14rpx) 4rpx,calc(100% - 6rpx) 4rpx,calc(100% - 6rpx) 10rpx,100% 10rpx,100% calc(100% - 10rpx),calc(100% - 6rpx) calc(100% - 10rpx),calc(100% - 6rpx) calc(100% - 4rpx),calc(100% - 14rpx) calc(100% - 4rpx),calc(100% - 14rpx) 100%,14rpx 100%,14rpx calc(100% - 4rpx),6rpx calc(100% - 4rpx),6rpx calc(100% - 10rpx),0 calc(100% - 10rpx),0 10rpx,6rpx 10rpx,6rpx 4rpx,14rpx 4rpx)}
.sectionLabel{display:block;font-size:calc(34rpx * var(--font-scale));font-weight:400;line-height:1.35}
.totalCard{padding:13rpx 20rpx 15rpx}.totalPicker{display:block;width:58%;min-width:210rpx;margin:-2rpx auto 10rpx}.countControl{display:flex;justify-content:center;align-items:center;gap:20rpx;padding:5rpx 20rpx;min-height:92rpx}.countValue{font-size:calc(79rpx * var(--font-scale));font-weight:400;line-height:1.06;white-space:nowrap;font-variant-numeric:tabular-nums}.countUnit{font-size:.72em;margin-left:5rpx}.countAffordance{display:flex;flex-direction:column;align-items:center;gap:10rpx;flex:none;font-size:calc(21rpx * var(--font-scale));line-height:1.4;color:#746e5e;font-weight:400}.pickerArrow{width:13rpx;height:13rpx;border-right:4rpx solid #ff7c14;border-bottom:4rpx solid #ff7c14;transform:rotate(45deg)}
.teamSplit{display:flex;align-items:center;justify-content:center;gap:35rpx;min-height:72rpx;background:#f2e9d8;padding:5rpx 10rpx;box-sizing:border-box}.teamNumber{display:flex;align-items:center;justify-content:center;gap:18rpx;min-width:0;flex:1;font-size:calc(44rpx * var(--font-scale));font-weight:400;line-height:1.2}.teamNumber image{display:block;flex:none;width:67rpx;height:64rpx}.splitDivider{height:43rpx;width:2rpx;background:#d4c8b2;flex:none}
.venueCard{display:flex;align-items:stretch;gap:16rpx;margin-top:15rpx;padding:16rpx 18rpx}.venueCopy{display:flex;flex-direction:column;justify-content:space-between;gap:12rpx;flex:1;min-width:0}.venueHeading{font-size:calc(31rpx * var(--font-scale))}.venueState{display:flex;align-items:center;gap:12rpx;min-height:100rpx}.venueStateCopy{min-width:0;flex:1}.venueTitle{display:block;font-size:calc(30rpx * var(--font-scale));line-height:1.4;font-weight:400}.venueHint{display:block;font-size:calc(22rpx * var(--font-scale));line-height:1.45;font-weight:400;margin-top:6rpx}.locationPin{position:relative;flex:none;width:29rpx;height:29rpx;border:5rpx solid #050b14;border-radius:50% 50% 50% 0;transform:rotate(-45deg);background:#c3c0b7;margin:0 3rpx 12rpx 4rpx}.locationPin::after{content:"";position:absolute;inset:7rpx;background:#fcf8ed;border-radius:50%;border:2rpx solid #050b14}.locationPin.confirmed{background:#5dab58}.venueGuide{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:0 0 51%;min-width:0;background:#f1efdc;box-sizing:border-box;padding:7rpx 7rpx 9rpx}.venueGuideImage{display:block;width:100%;height:226rpx}.guideCaption{font-size:calc(22rpx * var(--font-scale));font-weight:400;line-height:1.35;margin-top:5rpx;text-align:center}.guideFootnote{font-size:calc(18rpx * var(--font-scale));font-weight:400;line-height:1.4;color:#727466;text-align:center;margin-top:3rpx}
.rulesCard{margin-top:15rpx;padding:12rpx 20rpx 12rpx}.rulesGrid{display:flex;align-items:stretch;margin-top:11rpx}.ruleItem{display:flex;flex-direction:column;align-items:center;justify-content:flex-start;flex:1;min-width:0;box-sizing:border-box;padding:0 6rpx;text-align:center}.ruleItem+.ruleItem{border-left:2rpx solid #e8dfce}.ruleItem image{display:block;width:67rpx;height:72rpx;margin-bottom:4rpx}.ruleValue{display:block;font-size:calc(37rpx * var(--font-scale));font-weight:400;line-height:1.25;white-space:nowrap}.ruleLabel{display:block;font-size:calc(27rpx * var(--font-scale));font-weight:400;line-height:1.4}.rulesNote{display:flex;align-items:center;gap:17rpx;justify-content:center;border-top:2rpx dashed #e3d7c0;padding-top:11rpx;margin-top:14rpx;font-size:calc(25rpx * var(--font-scale));font-weight:400;line-height:1.45}.noteMark{display:flex;align-items:center;justify-content:center;flex:none;width:36rpx;height:36rpx;background:#ff821c;color:#fff;font-size:31rpx;font-weight:400;border-radius:9rpx}.createAction{margin:13rpx -1rpx 0}
.inviteCard{padding:10rpx 21rpx 13rpx;text-align:center}.inviteLabel{font-size:calc(32rpx * var(--font-scale));text-align:center}.codeRow{display:flex;align-items:center;justify-content:center;gap:13rpx;min-width:0;margin:1rpx 0 2rpx}.roomCode{display:block;min-width:0;font-size:calc(70rpx * var(--font-scale));font-weight:400;line-height:1.22;letter-spacing:-1.5rpx;font-variant-numeric:tabular-nums;white-space:nowrap}.copyAction{display:block;flex:none;width:76rpx}.inviteHint{display:block;color:#666468;font-size:calc(27rpx * var(--font-scale));line-height:1.45;font-weight:400}
.roomRules{padding:10rpx 15rpx 12rpx;margin-top:11rpx}.roomRuleNumbers{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.readyTeam{display:flex;align-items:center;gap:12rpx;min-width:0;flex:1;font-size:calc(32rpx * var(--font-scale));font-weight:400;white-space:nowrap;line-height:1.25}.readyTeam image{display:block;flex:none;width:65rpx;height:65rpx}.orangeNumber{color:#ff710c;font-size:calc(53rpx * var(--font-scale));font-weight:400;line-height:1.15}.targetNumber{display:flex;align-items:center;justify-content:center;gap:12rpx;min-width:0;flex:1;border-left:2rpx solid #e2d6c0;font-size:calc(29rpx * var(--font-scale));font-weight:400;line-height:1.3;white-space:nowrap}.roomRuleText{display:block;margin-top:7rpx;text-align:center;white-space:pre-line;font-size:calc(24rpx * var(--font-scale));font-weight:400;line-height:1.4;color:#626066}
.rosterHeader{padding:17rpx 8rpx 6rpx}.rosterHeading{display:flex;align-items:baseline;justify-content:space-between;gap:12rpx}.rosterHeading .sectionLabel{font-size:calc(31rpx * var(--font-scale));white-space:nowrap}.readyCount{font-size:calc(25rpx * var(--font-scale));font-weight:400;color:#787b6b;line-height:1.4;text-align:right}.readyCount.allReady{color:#17631c}.rosterHint{display:block;color:#626066;font-size:calc(23rpx * var(--font-scale));font-weight:400;line-height:1.4;margin-top:1rpx}
.rosterGrid{display:flex;flex-wrap:wrap;gap:7rpx 10rpx}.playerCard{display:flex;align-items:center;gap:8rpx;flex:0 0 calc(50% - 5rpx);width:calc(50% - 5rpx);min-width:0;min-height:74rpx;padding:4rpx 10rpx}.playerAvatar{display:block;flex:none;width:63rpx;height:59rpx}.playerName{display:block;flex:1;min-width:0;font-size:calc(29rpx * var(--font-scale));font-weight:400;line-height:1.4;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.readyBadge{display:block;flex:none;box-sizing:border-box;border-radius:14rpx;padding:5rpx 12rpx;font-size:calc(24rpx * var(--font-scale));font-weight:400;line-height:1.4;white-space:nowrap}.isReady{background:#4a9a44;color:#fff}.notReady{background:#e8e2d5;color:#787363}.emptyRoster{padding:28rpx 18rpx;font-size:calc(27rpx * var(--font-scale));line-height:1.55;color:#717164;text-align:center}.readySummary,.ownerHint{display:block;text-align:center;color:#727365;font-size:calc(25rpx * var(--font-scale));font-weight:400;line-height:1.45;margin-top:13rpx}.roomActions{display:flex;flex-direction:column;gap:8rpx;margin:9rpx -3rpx 0}.ownerHint{margin:3rpx 8rpx 5rpx}.roomError{display:block;padding:16rpx 18rpx;margin:16rpx 27rpx 0;background:#ffedd9;border:2rpx solid #e8b295;color:#a53b1e;font-size:calc(25rpx * var(--font-scale));line-height:1.55;overflow-wrap:break-word}
.fontLarge .totalPicker{width:74%;margin-top:9rpx}.fontLarge .venueCard{flex-wrap:wrap}.fontLarge .venueCopy{flex-basis:100%}.fontLarge .venueGuide{flex-basis:100%;padding:10rpx}.fontLarge .venueGuideImage{height:270rpx}.fontLarge .venueState{min-height:0;padding:7rpx 0}.fontLarge .ruleValue{font-size:calc(32rpx * var(--font-scale))}.fontLarge .rulesNote{align-items:flex-start}.fontLarge .roomRuleNumbers{flex-wrap:wrap;gap:10rpx}.fontLarge .readyTeam,.fontLarge .targetNumber{flex-basis:100%;justify-content:center}.fontLarge .targetNumber{border-left:0;border-top:2rpx solid #e2d6c0;padding-top:8rpx}.fontLarge .rosterHeading{flex-wrap:wrap;gap:3rpx}.fontLarge .roomCode{font-size:calc(58rpx * var(--font-scale))}.fontLarge .copyAction{width:94rpx}.fontLarge .playerCard{flex-wrap:wrap;gap:4rpx 7rpx;padding:7rpx 10rpx}.fontLarge .playerAvatar{width:56rpx;height:55rpx}.fontLarge .playerName{font-size:calc(28rpx * var(--font-scale))}.fontLarge .readyBadge{margin-left:auto;font-size:calc(23rpx * var(--font-scale));padding:3rpx 10rpx}.narrowCanvas .venueCard{gap:10rpx;padding-left:14rpx;padding-right:14rpx}.narrowCanvas .venueHeading{font-size:calc(29rpx * var(--font-scale))}.narrowCanvas .venueTitle{font-size:calc(28rpx * var(--font-scale))}.narrowCanvas .readyTeam{gap:8rpx}.narrowCanvas .targetNumber{gap:8rpx;font-size:calc(27rpx * var(--font-scale))}.narrowCanvas .playerCard{gap:5rpx;padding-left:7rpx;padding-right:7rpx}.narrowCanvas .playerAvatar{width:54rpx;height:56rpx}.narrowCanvas .readyBadge{font-size:calc(23rpx * var(--font-scale));padding-left:8rpx;padding-right:8rpx}

.roomScreen{width:var(--vw,100vw)}
.rosterGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.playerCard{width:100%;min-width:0}

.fontLarge .codeRow{flex-wrap:wrap}.fontLarge .copyAction{width:110px}

.teamInputs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}.teamField{min-width:0}.teamField text{display:block;font-size:14px;margin-bottom:6px}.teamField input{width:100%;height:48px;border:2px solid #273d27;background:#fffdf4;text-align:center;font-size:24px}.teamHint{display:block;margin-top:12px;font-size:12px;line-height:1.8;color:#496b35}

.teamField input{font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;font-weight:400}.copyAction .nativeAction{padding:6px 2px;font-size:calc(14px * var(--action-scale,1))}.copyAction .actionLabel{white-space:nowrap}

/* Native input editing retains its real caret; idle values use the UI font. */
.teamField{position:relative}.teamField input{color:transparent}.teamField input.editing{color:#050b14}.teamField .teamValue{position:absolute;left:2px;right:2px;bottom:2px;height:44px;line-height:44px;margin:0;text-align:center;font-family:CatMouseFusionUI,ParkReplicaUI,sans-serif;font-size:24px;pointer-events:none}

.venueSelectCard{margin-top:15rpx;padding:16rpx 18rpx}.venuePicker{margin-top:12rpx}.venuePickerValue{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;padding:7px 10px;box-sizing:border-box;border:2px solid #436346;background:#fcf8ed;font-size:calc(14px*var(--font-scale))}.venueSelectionNote{display:block;margin-top:6px;font-size:calc(12px*var(--font-scale));line-height:1.45;color:#61705a}.venueGuideLoading{display:flex;flex-direction:column;align-items:center;justify-content:center;height:226rpx;font-size:12px;color:#61705a}
