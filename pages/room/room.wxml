<view class="sdvScreen roomScreen {{nightMode?'sdvNight':''}} {{fontScale>1.15?'fontLarge':''}} {{viewportWidth<350?'narrowCanvas':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vh:{{viewportHeight}}px;--safe-bottom:{{safeBottom}}px;--vw:{{viewportWidth}}px">
  <nav-bar pinned="{{true}}" title="{{roomId?'活动准备':'发起活动'}}" back="{{true}}" preview="{{devPreview}}" />

  <view wx:if="{{!roomId}}" class="createContent">
    <view class="sdvWoodCard createHeroCard">
      <image class="createHeroImg" src="/assets/sdv-v1/create-banner.png" mode="widthFix" aria-label="户外活动路线与集合点木牌横幅" />
    </view>

    <view class="sdvWoodCard stepCard">
      <view class="stepHeader">
        <view class="sdvIconTitle">
          <map-icon kind="team" size="18" color="#2c6122" />
          <text>人数</text>
        </view>
        <text class="sdvBadge sdvBadgeAmber">目标 {{targetCount}} 人</text>
      </view>
      <view class="sdvPillGroup presetRow">
        <button wx:for="{{presets}}" wx:key="*this" data-total="{{item}}" bindtap="applyPreset" hover-class="sdvPressed" class="sdvPill {{total===item?'sdvPillActive':''}}">{{item}}人</button>
      </view>
      <view class="teamSpriteStrip">
        <view class="teamSpriteItem">
          <image class="teamSpriteIcon" src="/assets/sdv-v1/hud-cat.png" mode="aspectFit" aria-hidden="true" />
          <text class="teamSpriteText">{{catsCount}}人</text>
        </view>
        <view class="teamSpriteItem">
          <image class="teamSpriteIcon" src="/assets/sdv-v1/hud-mouse.png" mode="aspectFit" aria-hidden="true" />
          <text class="teamSpriteText">{{miceCount}}人</text>
        </view>
        <button class="sdvIconBtn sdvIconBtnSm {{customTeamOpen?'sdvBtnBlue':'sdvBtnPaper'}} customIconBtn" hover-class="sdvPressed" bindtap="toggleCustomTeam" aria-label="{{customTeamOpen?'收起自定义人数':'自定义人数'}}">
          <map-icon kind="{{customTeamOpen?'close':'edit'}}" size="16" color="{{customTeamOpen?'#fffdf6':'#3b1d0b'}}" />
        </button>
      </view>
      <view wx:if="{{customTeamOpen}}" class="teamInputs">
        <view class="teamField">
          <text>总人数</text>
          <input type="number" value="{{total}}" maxlength="2" data-field="total" bindinput="teamInput" bindfocus="teamFocus" bindblur="teamBlur" class="{{editingField==='total'?'editing':''}}" aria-label="总人数" />
          <text wx:if="{{editingField!=='total'}}" class="teamValue" aria-hidden="true">{{total}}</text>
        </view>
        <view class="teamField">
          <text>猫队</text>
          <input type="number" value="{{catsCount}}" maxlength="2" data-field="catsCount" bindinput="teamInput" bindfocus="teamFocus" bindblur="teamBlur" class="{{editingField==='catsCount'?'editing':''}}" aria-label="猫队人数" />
          <text wx:if="{{editingField!=='catsCount'}}" class="teamValue" aria-hidden="true">{{catsCount}}</text>
        </view>
        <view class="teamField">
          <text>鼠队</text>
          <input type="number" value="{{miceCount}}" maxlength="2" data-field="miceCount" bindinput="teamInput" bindfocus="teamFocus" bindblur="teamBlur" class="{{editingField==='miceCount'?'editing':''}}" aria-label="鼠队人数" />
          <text wx:if="{{editingField!=='miceCount'}}" class="teamValue" aria-hidden="true">{{miceCount}}</text>
        </view>
      </view>
      <text wx:if="{{teamError}}" class="sdvError roomInlineError" role="alert">{{teamError}}</text>
    </view>

    <view class="sdvWoodCard stepCard">
      <view class="stepHeader">
        <view class="sdvIconTitle">
          <map-icon kind="pin" size="18" color="#2c6122" />
          <text>场地</text>
        </view>
        <text class="sdvBadge {{venue?'sdvBadgeGreen':'sdvBadgeGray'}}">{{venue?'已定':'待设'}}</text>
      </view>
      <picker class="venueDropdown" range="{{venueOptions}}" range-key="label" value="{{venueMapIndex}}" bindchange="selectVenueMap" disabled="{{loading}}">
        <view class="venueDropInner">
          <map-icon kind="map" size="16" color="#1c4763" />
          <text class="venueDropValue">{{venueName}}</text>
          <text class="venueDropArrow" aria-hidden="true">▾</text>
        </view>
      </picker>
      <view class="venuePreviewRow">
        <view class="venuePreviewCopy">
          <view class="venueState">
            <view class="locationPin {{venue?'confirmed':''}}" aria-hidden="true"></view>
            <view class="venueStateCopy">
              <text class="venueTitle">{{venue?'集合点就绪':'未设集合点'}}</text>
              <text class="venueHint">{{venue?venueSummaryText:'点下方框选或定位'}}</text>
            </view>
          </view>
        </view>
        <view class="venueGuide">
          <view wx:if="{{nativeOnly}}" class="venueGuideLoading"><text>实时地图</text></view>
          <image wx:elif="{{venueResource==='ready'}}" class="venueGuideImage" src="{{venueSource}}" mode="aspectFit" aria-label="{{venueName}}场地导览" />
          <view wx:else class="venueGuideLoading"><text>{{venueResource==='error'?'加载失败':'加载中…'}}</text><button wx:if="{{venueResource==='error'}}" class="sdvBtn sdvBtnPaper sdvBtnSm" bindtap="loadVenueArt">重试</button></view>
        </view>
      </view>
      <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-create-location.png" label="{{venue?'调整范围':'设定范围'}}" tone="blue" dynamic="{{!venue}}" font-scale="{{fontScale}}" bindaction="openVenueActionSheet" />
    </view>

    <view class="sdvPaperCard paramBar">
      <view class="sdvChipRow paramChips">
        <view class="sdvInfoChip"><map-icon kind="clock" size="13" color="#2c6122" /><text>30s准备</text></view>
        <view class="sdvInfoChip"><map-icon kind="flag" size="13" color="#a64d0b" /><text>6分钟</text></view>
        <view class="sdvInfoChip"><map-icon kind="team" size="13" color="#1e5880" /><text>自动分组</text></view>
      </view>
    </view>

    <view wx:if="{{error}}" class="sdvError sdvErrorRow roomError" bindtap="clearError" role="alert">
      <text class="errorText">{{error}}</text>
      <text class="errorClose" aria-hidden="true">×</text>
    </view>
    <button wx:if="{{needSetting}}" class="sdvBtn sdvBtnBlue sdvBtnSm permLinkBtn" hover-class="sdvPressed" bindtap="openPermSettings">去开启定位权限</button>

    <view class="sdvStickyBar">
      <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-create-submit.png" label="创建活动" tone="green" loading="{{loading}}" disabled="{{loading || !!teamError || venueResource!=='ready'}}" font-scale="{{fontScale}}" bindaction="create" />
    </view>
  </view>

  <view wx:else class="readyContent">
    <view class="sdvWoodCard inviteCard">
      <view class="inviteTopRow">
        <view class="sdvIconTitle">
          <map-icon kind="code" size="18" color="#1e5880" />
          <text>房间码</text>
        </view>
        <text class="sdvBadge {{connection==='实时连接'?'sdvBadgeGreen':'sdvBadgeBlue'}}">{{devPreview?'预览':connection==='实时连接'?'在线':connection || '同步中'}}</text>
      </view>
      <view class="codeRow">
        <text class="roomCode" selectable bindtap="copy">{{code || '同步中'}}</text>
        <view class="codeIconGroup">
          <button class="sdvIconBtn sdvIconBtnSm {{copyTip==='已复制'?'sdvBtnGreen':'sdvBtnPaper'}}" hover-class="sdvPressed" bindtap="copy" disabled="{{!code}}" aria-label="复制房间码">
            <map-icon kind="{{copyTip==='已复制'?'check':'copy'}}" size="17" color="{{copyTip==='已复制'?'#fffdf6':'#3b1d0b'}}" />
          </button>
          <button class="sdvIconBtn sdvIconBtnSm sdvBtnWood" hover-class="sdvPressed" bindtap="invite" disabled="{{!code}}" aria-label="邀请二维码">
            <map-icon kind="code" size="17" color="#3b1d0b" />
          </button>
          <button class="sdvIconBtn sdvIconBtnSm sdvBtnBlue" hover-class="sdvPressed" open-type="share" disabled="{{!code || devPreview}}" aria-label="微信转发">
            <map-icon kind="share" size="17" color="#fffdf6" />
          </button>
        </view>
      </view>
    </view>

    <view class="sdvPaperCard summaryToolCard">
      <view class="summaryHead">
        <view class="sdvIconTitle summaryVenueWrap">
          <map-icon kind="pin" size="16" color="#2c6122" />
          <text class="summaryVenue">{{venueName}}</text>
        </view>
        <button class="sdvIconBtn sdvIconBtnSm sdvBtnWood" hover-class="sdvPressed" bindtap="openConfigSheet" aria-label="活动配置与规则">
          <map-icon kind="settings" size="18" color="#3b1d0b" />
        </button>
      </view>
      <view class="sdvChipRow summaryChips">
        <view class="sdvInfoChip">
          <image class="chipSprite" src="/assets/sdv-v1/hud-cat.png" mode="aspectFit" aria-hidden="true" />
          <text>{{catsCount}}</text>
          <image class="chipSprite" src="/assets/sdv-v1/hud-mouse.png" mode="aspectFit" aria-hidden="true" />
          <text>{{(rules?rules.total:total)-catsCount}}</text>
        </view>
        <view class="sdvInfoChip">
          <map-icon kind="scan" size="13" color="#a64d0b" />
          <text>目标{{targetCount}}</text>
        </view>
        <view class="sdvInfoChip">
          <map-icon kind="eye" size="13" color="#1e5880" />
          <text>{{mouseTeamVision?'共享':'独立'}}</text>
        </view>
        <view class="sdvInfoChip">
          <text>{{venueSummaryText}}</text>
        </view>
      </view>
    </view>

    <view class="sdvWoodCard rosterCard">
      <view class="rosterHeading">
        <view class="sdvIconTitle">
          <map-icon kind="team" size="18" color="#2c6122" />
          <text>成员 {{roster.length}}/{{rules?rules.total:total}}</text>
        </view>
        <view class="rosterHeadRight">
          <location-signal wx:if="{{!devPreview}}" signal="{{locationSignal}}" font-scale="{{fontScale}}" />
          <text class="sdvBadge {{canStart?'sdvBadgeGreen':'sdvBadgeAmber'}}">{{canStart?'全员就绪':readyCount+'就绪'}}</text>
        </view>
      </view>
      <view class="rosterGrid">
        <view wx:for="{{roster}}" wx:key="id" class="sdvPaperCard playerCard">
          <image class="playerAvatar" src="/assets/pixel-v1/ready-avatar-{{index%8}}.png" mode="aspectFit" aria-hidden="true" />
          <text class="playerName" aria-label="{{item.nickname}}">{{item.nickname}}</text>
          <view wx:if="{{index===0}}" class="hostMark" aria-label="组织者">
            <map-icon kind="crown" size="11" color="#a64d0b" />
          </view>
          <view class="readyMark {{item.ready?'isReady':'isWaiting'}}" aria-label="{{item.ready?'已准备':'未准备'}}">
            <map-icon wx:if="{{item.ready}}" kind="check" size="13" color="#2c6122" />
            <text wx:else class="readyDot">·</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!roster.length}}" class="emptyRoster">点上方按钮邀请成员</view>
    </view>

    <view wx:if="{{error}}" class="sdvError sdvErrorRow roomError" bindtap="clearError" role="alert">
      <text class="errorText">{{error}}</text>
      <text class="errorClose" aria-hidden="true">×</text>
    </view>
    <button wx:if="{{needSetting}}" class="sdvBtn sdvBtnBlue sdvBtnSm permLinkBtn" hover-class="sdvPressed" bindtap="openPermSettings">去开启定位权限</button>
    <image class="sdvMeadowFooter" src="/assets/sdv-v1/meadow-strip.png" mode="widthFix" aria-hidden="true" />

    <view class="sdvStickyBar">
      <text wx:if="{{!canStart}}" class="stickyHint">{{startHint}}</text>
      <view class="roomActions">
        <pixel-action class="pixelControl" wx:if="{{owner}}" skin="/assets/pixel-v1/button-ready-start.png" label="{{canStart?'开始活动':'等待就绪'}}" tone="orange" dynamic="{{!canStart}}" disabled="{{!canStart || loading}}" loading="{{loading}}" font-scale="{{fontScale}}" bindaction="start" />
        <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-ready-cancel.png" label="{{ready?'取消准备':'定位准备'}}" tone="{{ready?'plain':'green'}}" dynamic="{{!ready}}" font-scale="{{fontScale}}" bindaction="toggleReady" />
      </view>
    </view>
  </view>

  <sdv-modal
    visible="{{venueSheetOpen}}"
    mode="sheet"
    title="设定场地"
    items="{{venueSheetItems}}"
    cancelText="取消"
    fontScale="{{fontScale}}"
    bindselect="onSelectVenueAction"
    bindcancel="closeVenueActionSheet"
    bindclose="closeVenueActionSheet"
  />

  <sdv-modal
    visible="{{inviteSheetOpen}}"
    mode="sheet"
    title="邀请成员（{{code}}）"
    cancelText="关闭"
    fontScale="{{fontScale}}"
    bindcancel="closeInviteSheet"
    bindclose="closeInviteSheet"
  >
    <view class="inviteSlotStack">
      <button class="sdvBtn sdvBtnGreen" open-type="share" disabled="{{!code || devPreview}}">微信转发</button>
      <button class="sdvBtn sdvBtnWood sdvBtnSm" bindtap="invite" disabled="{{!code}}">邀请二维码</button>
      <button class="sdvBtn sdvBtnPaper sdvBtnSm" bindtap="copy" disabled="{{!code}}">复制房间码</button>
    </view>
  </sdv-modal>

  <sdv-modal
    visible="{{configSheetOpen}}"
    mode="sheet"
    title="配置与规则"
    items="{{configSheetItems}}"
    cancelText="关闭"
    fontScale="{{fontScale}}"
    bindselect="onSelectConfig"
    bindcancel="closeConfigSheet"
    bindclose="closeConfigSheet"
  />

  <sdv-modal
    visible="{{rulesModalOpen}}"
    mode="dialog"
    title="活动规则"
    content="• 30秒准备 · 6分钟活动 · 目标 {{targetCount}} 人。\n• 中途按比例补入，目标按鼠队 60% 更新。\n• 有效GPS保留7天；当面停下再扫码核验。"
    showCancel="{{false}}"
    confirmText="知道了"
    confirmTone="green"
    fontScale="{{fontScale}}"
    bindconfirm="closeRulesModal"
    bindclose="closeRulesModal"
  />
</view>
