<view class="screen roomScreen {{fontScale>1.15?'fontLarge':''}} {{viewportWidth<350?'narrowCanvas':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vh:{{viewportHeight}}px;--vw:{{viewportWidth}}px">
  <nav-bar pinned="{{true}}" title="猫鼠行动" back="{{true}}" preview="{{devPreview}}" />
  <image class="roomHero {{roomId?'readyHero':'createHero'}}" src="{{roomId?'/assets/pixel-v1/ready-hero.png':'/assets/pixel-v1/create-hero.png'}}" mode="widthFix" aria-label="{{roomId?'房间准备，猫鼠伙伴在公园集合':'组织一场追逐'}}" />
  <view wx:if="{{!roomId}}" class="createContent">
    <view class="paperFrame totalCard">
      <text class="sectionLabel">本局人数</text>
      <view class="teamInputs"><view class="teamField"><text>总人数</text><input type="number" value="{{total}}" maxlength="2" data-field="total" bindinput="teamInput" bindfocus="teamFocus" bindblur="teamBlur" class="{{editingField==='total'?'editing':''}}" aria-label="总人数" /><text wx:if="{{editingField!=='total'}}" class="teamValue" aria-hidden="true">{{total}}</text></view><view class="teamField"><text>猫人数</text><input type="number" value="{{catsCount}}" maxlength="2" data-field="catsCount" bindinput="teamInput" bindfocus="teamFocus" bindblur="teamBlur" class="{{editingField==='catsCount'?'editing':''}}" aria-label="猫人数" /><text wx:if="{{editingField!=='catsCount'}}" class="teamValue" aria-hidden="true">{{catsCount}}</text></view><view class="teamField"><text>鼠人数</text><input type="number" value="{{miceCount}}" maxlength="2" data-field="miceCount" bindinput="teamInput" bindfocus="teamFocus" bindblur="teamBlur" class="{{editingField==='miceCount'?'editing':''}}" aria-label="鼠人数" /><text wx:if="{{editingField!=='miceCount'}}" class="teamValue" aria-hidden="true">{{miceCount}}</text></view></view>
      <text class="teamHint">猫 + 鼠 = 总人数 · 各至少1人 · 总计2–60人</text><text wx:if="{{teamError}}" class="roomError" role="alert">{{teamError}}</text>
    </view>
    <view class="paperFrame venueSelectCard"><text class="sectionLabel">场地地图</text><picker class="venuePicker" range="{{venueOptions}}" range-key="label" value="{{venueMapIndex}}" bindchange="selectVenueMap"><view class="venuePickerValue"><text>{{venueName}}</text><text aria-hidden="true">›</text></view></picker><text class="venueSelectionNote">切换场地后，请重新到场确认集合点</text></view>
    <view class="paperFrame venueCard">
      <view class="venueCopy"><text class="sectionLabel venueHeading">集合点与活动范围</text><view class="venueState"><view class="locationPin {{venue?'confirmed':''}}" aria-hidden="true"></view><view class="venueStateCopy"><text class="venueTitle">{{venue?'集合点已确认':'还未确认集合点'}}</text><text class="venueHint">{{venue?venueSummaryText:'可到场确认，也可在地图上框选'}}</text></view></view><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-create-location.png" label="{{venue?'重选位置':'确认位置'}}" tone="plain" dynamic="{{!venue}}" font-scale="{{fontScale}}" bindaction="chooseVenue" /><button class="textButton venueEditorEntry" bindtap="openVenueEditor">地图框选范围</button></view>
      <view class="venueGuide"><image wx:if="{{venueResource==='ready'}}" class="venueGuideImage" src="{{venueSource}}" mode="aspectFit" aria-label="{{venueName}}场地导览" /><view wx:else class="venueGuideLoading"><text>{{venueResource==='error'?'地图加载失败':'正在加载地图…'}}</text><button wx:if="{{venueResource==='error'}}" class="textButton" bindtap="loadVenueArt">重试</button></view><text class="guideCaption">{{venueName}}</text><text class="guideFootnote">示意图不代表定位结果</text></view>
    </view>
    <view class="paperFrame rulesCard"><text class="sectionLabel">规则摘要</text><view class="rulesGrid"><view class="ruleItem"><image src="/assets/pixel-v1/rules-icon-clock.png" mode="aspectFit" aria-hidden="true" /><text class="ruleValue">30秒</text><text class="ruleLabel">躲藏时间</text></view><view class="ruleItem"><image src="/assets/pixel-v1/rules-icon-clock.png" mode="aspectFit" aria-hidden="true" /><text class="ruleValue">6分钟</text><text class="ruleLabel">追逐时间</text></view><view class="ruleItem"><image src="/assets/pixel-v1/rules-icon-cat.png" mode="aspectFit" aria-hidden="true" /><text class="ruleValue">抓满{{targetCount}}人</text><text class="ruleLabel">猫获胜</text></view></view><view class="rulesNote"><text class="noteMark" aria-hidden="true">!</text><text>倒计时结束未达标时，鼠获胜</text></view></view>
    <view class="createAction"><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-create-submit.png" label="创建并邀请" tone="green" loading="{{loading}}" disabled="{{loading || !!teamError || venueResource!=='ready'}}" font-scale="{{fontScale}}" bindaction="create" /></view>
  </view>
  <view wx:else class="readyContent">
    <view class="paperFrame inviteCard"><text class="sectionLabel inviteLabel">房间码</text><view class="codeRow"><text class="roomCode" selectable>{{code || '同步中'}}</text><view class="copyAction"><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-ready-copy.png" label="复制" tone="plain" disabled="{{!code}}" font-scale="{{fontScale}}" bindaction="copy" /></view></view><text class="inviteHint">分享房间码，邀请好友加入</text><view class="inviteButtons"><button open-type="share" disabled="{{!code || devPreview}}">微信邀请</button><button bindtap="invite" disabled="{{!code}}">邀请二维码</button></view></view>
    <view class="paperFrame roomRules"><view class="roomRuleNumbers"><view class="readyTeam"><image src="/assets/pixel-v1/rules-icon-cat.png" mode="aspectFit" aria-hidden="true" /><text><text class="orangeNumber">{{catsCount}}</text>猫 <text class="orangeNumber">{{(rules?rules.total:total)-catsCount}}</text>鼠</text></view><view class="targetNumber"><text>捕获目标</text><text class="orangeNumber">{{targetCount}}人</text></view></view><text class="venueSelectionNote">{{venueName}} · {{venueSummaryText}}</text><text class="roomRuleText">30秒躲藏，6分钟追逐；捕获{{targetCount}}人猫胜，
倒计时结束未达标鼠胜。</text></view>
    <button wx:if="{{owner && (!match || match.phase==='FINISHED' || match.phase==='CANCELLED')}}" class="textButton" bindtap="openVenueEditor">修改集合点与范围</button><button wx:if="{{owner && (!match || match.phase==='FINISHED' || match.phase==='CANCELLED')}}" class="textButton" bindtap="openCalibration">图片与真实位置标定</button>
    <button class="textButton" bindtap="openSettings">玩法设置 · 鼠队视野{{mouseTeamVision?'共享':'独立'}}</button><text wx:if="{{trackRecordingSupported}}" class="rosterHint">本局记录有效行动轨迹，每人可赛后导出本人，房主可导出全员，保留7天。本人海报可含GPS速度与近猫距离估计，不展示猫路线。</text>
    <view class="rosterHeader"><view class="rosterHeading"><text class="sectionLabel">玩家列表（{{roster.length}}/{{rules?rules.total:total}}）</text><text class="readyCount {{canStart?'allReady':''}}">{{canStart?'所有玩家已准备':readyCount+'人已准备'}}</text></view><text class="rosterHint">阵营将在开始后分配 · {{devPreview?'界面预览':connection || '正在同步'}}</text></view>
    <view class="rosterGrid"><view wx:for="{{roster}}" wx:key="id" class="paperFrame playerCard"><image class="playerAvatar" src="/assets/pixel-v1/ready-avatar-{{index%8}}.png" mode="aspectFit" aria-hidden="true" /><text class="playerName" aria-label="{{item.nickname}}">{{item.nickname}}</text><text class="readyBadge {{item.ready?'isReady':'notReady'}}">{{item.ready?'已准备':'未准备'}}</text></view></view>
    <view wx:if="{{!roster.length}}" class="paperFrame emptyRoster">伙伴还未加入，把房间码发给他们吧。</view>
    <text wx:if="{{!canStart}}" class="readySummary">{{startHint}}</text>
    <text class="rosterHint">开局后按比例补入猫鼠；目标按累计鼠人数的60%向上取整，倒计时不变。断线回来保留原身份。</text>
    <location-signal wx:if="{{!devPreview}}" signal="{{locationSignal}}" font-scale="{{fontScale}}" />
    <view class="roomActions"><pixel-action class="pixelControl" wx:if="{{owner}}" skin="/assets/pixel-v1/button-ready-start.png" label="{{canStart?'开始30秒躲藏':'等待所有人准备'}}" tone="orange" dynamic="{{!canStart}}" disabled="{{!canStart || loading}}" loading="{{loading}}" font-scale="{{fontScale}}" bindaction="start" /><text wx:else class="ownerHint">{{canStart?'已全部准备，等待房主开始':'准备后，等待房主开始本局'}}</text><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-ready-cancel.png" label="{{ready?'取消准备':'定位并准备'}}" tone="{{ready?'plain':'green'}}" dynamic="{{!ready}}" font-scale="{{fontScale}}" bindaction="toggleReady" /></view>
  </view>
  <text wx:if="{{error}}" class="roomError" role="alert">{{error}}</text>
</view>
