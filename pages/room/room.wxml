<!--pages/room/room.wxml - 房间等待页面-->
<view class="container">
  <!-- 房间头部 -->
  <view class="room-header">
    <view class="room-id-box">
      <text class="room-label">房间号</text>
      <text class="room-id">{{roomId}}</text>
      <view class="copy-btn" bindtap="onCopyRoomId">复制</view>
    </view>
    <view class="room-status">
      <text class="status-dot"></text>
      <text class="status-text">等待玩家加入...</text>
    </view>
  </view>

  <!-- 玩家列表 -->
  <view class="players-section">
    <view class="section-header">
      <text class="section-title">玩家列表</text>
      <text class="player-count">{{players.length}} 人</text>
    </view>
    
    <view class="players-grid">
      <view class="player-card" wx:for="{{players}}" wx:key="id">
        <view class="player-avatar">
          <text wx:if="{{!item.avatarUrl}}">👤</text>
          <image wx:else src="{{item.avatarUrl}}" mode="aspectFill"/>
        </view>
        <view class="player-info">
          <text class="player-nickname">{{item.nickname}}</text>
          <text class="player-join-time" wx:if="{{item.joinedAt}}">已加入</text>
        </view>
        <view class="player-badge" wx:if="{{item.isOwner}}">房主</view>
      </view>
      
      <!-- 空位提示 -->
      <view class="empty-slot" wx:if="{{players.length === 0}}">
        <text class="empty-text">等待其他玩家加入...</text>
      </view>
    </view>
  </view>

  <!-- 身份选择（开发模式） -->
  <view class="role-select-section" wx:if="{{devMode && !playerId}}">
    <view class="section-header">
      <text class="section-title">🎭 选择身份（开发模式）</text>
      <text class="dev-badge">DEV</text>
    </view>
    <view class="role-options">
      <view class="role-option {{selectedRole === 'cat' ? 'selected' : ''}}" 
            bindtap="onSelectRole" data-role="cat">
        <text class="role-icon">🐱</text>
        <text class="role-name">猫</text>
        <text class="role-desc">追捕老鼠</text>
      </view>
      <view class="role-option {{selectedRole === 'mouse' ? 'selected' : ''}}" 
            bindtap="onSelectRole" data-role="mouse">
        <text class="role-icon">🐭</text>
        <text class="role-name">鼠</text>
        <text class="role-desc">躲避追捕</text>
      </view>
    </view>
  </view>

  <!-- 已选择身份提示 -->
  <view class="selected-role-tip" wx:if="{{devMode && playerId && selectedRole}}">
    <text class="tip-icon">{{selectedRole === 'cat' ? '🐱' : '🐭'}}</text>
    <text class="tip-text">你选择了：{{selectedRole === 'cat' ? '猫' : '鼠'}}</text>
  </view>

  <!-- 游戏设置（仅房主可见） -->
  <view class="settings-section" wx:if="{{isOwner && roomInfo}}">
    <view class="section-header">
      <text class="section-title">⚙️ 游戏设置</text>
      <text class="edit-btn" bindtap="onEditSettings">修改</text>
    </view>
    <view class="settings-grid">
      <view class="setting-item">
        <text class="setting-label">🐱 猫</text>
        <text class="setting-value">{{roomInfo.settings.catCount}}只</text>
      </view>
      <view class="setting-item">
        <text class="setting-label">🐭 鼠</text>
        <text class="setting-value">{{roomInfo.settings.mouseCount}}只</text>
      </view>
      <view class="setting-item">
        <text class="setting-label">⏱️ 时长</text>
        <text class="setting-value">{{durationText}}</text>
      </view>
      <view class="setting-item">
        <text class="setting-label">📍 范围</text>
        <text class="setting-value">{{rangeText}}</text>
      </view>
      <view class="setting-item full-width">
        <text class="setting-label">🎭 揭秘时间</text>
        <text class="setting-value">{{revealTimeText}}</text>
      </view>
    </view>
  </view>

  <!-- 设置编辑弹窗 -->
  <view class="modal-mask" wx:if="{{showSettingsModal}}" bindtap="onCloseSettingsModal">
    <view class="modal-content" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">游戏设置</text>
        <text class="modal-close" bindtap="onCloseSettingsModal">×</text>
      </view>
      
      <view class="modal-body">
        <!-- 猫的数量 -->
        <view class="setting-row">
          <text class="setting-row-label">🐱 猫的数量</text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="onDecrease" data-field="catCount" data-min="1" data-max="5">−</view>
            <text class="stepper-value">{{tempSettings.catCount}}</text>
            <view class="stepper-btn" bindtap="onIncrease" data-field="catCount" data-min="1" data-max="5">+</view>
          </view>
        </view>
        
        <!-- 老鼠数量 -->
        <view class="setting-row">
          <text class="setting-row-label">🐭 老鼠数量</text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="onDecrease" data-field="mouseCount" data-min="3" data-max="20">−</view>
            <text class="stepper-value">{{tempSettings.mouseCount}}</text>
            <view class="stepper-btn" bindtap="onIncrease" data-field="mouseCount" data-min="3" data-max="20">+</view>
          </view>
        </view>
        
        <!-- 游戏时长 -->
        <view class="setting-row">
          <text class="setting-row-label">⏱️ 游戏时长</text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="onDecrease" data-field="gameDuration" data-min="5" data-max="30" data-step="5">−</view>
            <text class="stepper-value">{{tempSettings.gameDuration}}分钟</text>
            <view class="stepper-btn" bindtap="onIncrease" data-field="gameDuration" data-min="5" data-max="30" data-step="5">+</view>
          </view>
        </view>
        
        <!-- 活动范围 -->
        <view class="setting-row">
          <text class="setting-row-label">📍 活动范围</text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="onDecrease" data-field="mapRange" data-min="500" data-max="5000" data-step="500">−</view>
            <text class="stepper-value">{{tempSettings.mapRange / 1000}}km</text>
            <view class="stepper-btn" bindtap="onIncrease" data-field="mapRange" data-min="500" data-max="5000" data-step="500">+</view>
          </view>
        </view>
        
        <!-- 揭秘身份时间 -->
        <view class="setting-row">
          <text class="setting-row-label">🎭 揭秘身份时间</text>
          <view class="stepper">
            <view class="stepper-btn" bindtap="onDecrease" data-field="revealTime" data-min="0" data-max="10" data-step="1">−</view>
            <text class="stepper-value">{{tempSettings.revealTime}}分钟</text>
            <view class="stepper-btn" bindtap="onIncrease" data-field="revealTime" data-min="0" data-max="10" data-step="1">+</view>
          </view>
        </view>
        <text class="setting-tip">游戏开始后多久公开身份（0=立即揭秘）</text>
      </view>
      
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="onCloseSettingsModal">取消</button>
        <button class="btn-confirm" bindtap="onSaveSettings">保存</button>
      </view>
    </view>
  </view>

  <!-- 底部操作区 -->
  <view class="action-bar">
    <!-- 房主未创建房间：显示创建按钮 -->
    <button class="btn-start" wx:if="{{isOwner && !roomId}}" bindtap="onCreateRoom">
      <text class="btn-text">🏠 创建房间</text>
      <text class="btn-subtitle" wx:if="{{devMode && !selectedRole}}">（未选身份，将随机分配）</text>
    </button>
    
    <!-- 房主已创建房间：显示开始游戏按钮 -->
    <button class="btn-start" wx:elif="{{isOwner && roomId}}" bindtap="onStartGame">
      <text class="btn-text">🎮 开始游戏</text>
      <text class="btn-subtitle" wx:if="{{players.length < 2}}">（至少 2 人）</text>
    </button>
    
    <!-- 非房主未加入：显示加入按钮 -->
    <button class="btn-start" wx:elif="{{!isOwner && roomId && !playerId}}" bindtap="onJoinRoom">
      <text class="btn-text">🚪 加入房间</text>
      <text class="btn-subtitle" wx:if="{{devMode && !selectedRole}}">（未选身份，将随机分配）</text>
    </button>
    
    <!-- 非房主已加入：等待提示 -->
    <view class="waiting-tip" wx:elif="{{!isOwner && playerId}}">
      <text class="tip-icon">⏳</text>
      <text class="tip-text">等待房主开始游戏</text>
    </view>
  </view>

  <!-- 分享按钮 -->
  <view class="share-section">
    <button class="btn-share" open-type="share">
      <text class="share-icon">📤</text>
      <text class="share-text">邀请好友加入</text>
    </button>
  </view>
</view>
