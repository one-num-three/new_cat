<view wx:if="{{available}}" class="screen devScreen {{fontScale>1.15?'fontLarge':''}} {{viewportWidth<350?'narrowCanvas':''}}" style="--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--safe-bottom:{{safeBottom}}px">
  <nav-bar pinned="{{true}}" title="猫鼠行动" />

  <view class="devWrap">
    <view class="sdvWoodCard devIntro">
      <view class="devTitleRow">
        <text class="devTitle">界面调试台</text>
        <text class="sdvBadge sdvBadgeGreen">样例数据</text>
      </view>
      <text class="devDescription">晴日公园 · 16-bit 像素</text>
      <text class="devNote">样例数据 · 不连接真实对局</text>
      <button class="sdvBtn sdvBtnGreen venuePreviewEntry" bindtap="openVenue">三处场地地图 · 完整导览</button>
    </view>

    <view wx:for="{{groups}}" wx:key="title" class="sdvPaperCard previewGroup">
      <text class="sdvSectionTitle groupTitle">{{item.title}}</text>
      <view class="previewGrid">
        <button wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="previewItem" data-id="{{entry.id}}" bindtap="open">
          <text class="entryNumber">{{index+1}}</text>
          <text class="entryTitle">{{entry.label}}</text>
          <text class="entryArrow">›</text>
        </button>
      </view>
    </view>

    <view class="sdvWoodCard devToolsCard">
      <text class="sdvSectionTitle groupTitle">地图位置标定 · 开发预览</text>
      <view class="devActionList">
        <button class="sdvBtn sdvBtnWood sdvBtnSm" data-map="seu-jiulonghu-v1" bindtap="openCampus">九龙湖 · 定位演示</button>
        <button class="sdvBtn sdvBtnWood sdvBtnSm" data-map="seu-sipailou-v1" bindtap="openCampus">四牌楼 · 定位演示</button>
        <button class="sdvBtn sdvBtnPaper sdvBtnSm" bindtap="simulateJiulonghu">九龙湖 · 电脑模拟本人定位</button>
        <button class="sdvBtn sdvBtnPaper sdvBtnSm" bindtap="simulateJiulonghuBoundary">九龙湖 · 东北校界模拟</button>
        <button class="sdvBtn sdvBtnAmber sdvBtnSm" bindtap="openCalibration">地图位置标定 · 开发预览</button>
        <button class="sdvBtn sdvBtnBlue sdvBtnSm" bindtap="openVenueEditor">集合点与多边形 · 开发预览</button>
      </view>
    </view>

    <button class="sdvBtn sdvBtnPaper homeButton" bindtap="home">返回首页</button>
  </view>
</view>
