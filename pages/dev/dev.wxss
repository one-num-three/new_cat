@import "../../utils/pixel-theme.wxss";

.devScreen{
  width:var(--vw,100vw);
  min-height:var(--vh,100vh);
  padding:calc(var(--nav-height,64px) + 12px) 14px calc(28px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
}

.devScreen,.devScreen button,.devScreen text{
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
  font-weight:400;
}

.devWrap{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.devIntro,.previewGroup,.devToolsCard{
  padding:8px;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.devTitleRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.devTitle{
  display:block;
  font-size:calc(22px * var(--font-scale,1));
  line-height:1.35;
  color:#332012;
}

.devDescription{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  color:#4a943b;
}

.devNote{
  display:block;
  font-size:12px;
  color:#5e4c3c;
}

.venuePreviewEntry{margin-top:4px}
.groupTitle{margin-bottom:4px}

.previewGrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.previewItem{
  display:flex;
  align-items:center;
  gap:6px;
  width:100%!important;
  margin:0!important;
  padding:4px 5px;
  min-height:48px;
  background:transparent;
  border:6px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:6px;
  border-image-repeat:round;
  image-rendering:pixelated;
  font-size:calc(13px * var(--font-scale,1));
  line-height:1.35;
  color:#3b1d0b;
  text-align:left;
}

.previewItem::after{border:0}

.entryNumber{
  font-size:11px;
  color:#2a6e99;
  flex:none;
}

.entryTitle{
  flex:1;
  min-width:0;
  font-weight:400;
}

.entryArrow{
  font-size:20px;
  color:#4a943b;
  flex:none;
}

.devActionList{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.homeButton{margin-top:4px}

.fontLarge .previewGrid{grid-template-columns:1fr}
.narrowCanvas .previewItem{padding:9px 6px;gap:5px;font-size:calc(12px * var(--font-scale,1))}
