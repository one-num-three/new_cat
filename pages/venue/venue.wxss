@import "../../utils/pixel-theme.wxss";

.venueScreen{display:flex;flex-direction:column;box-sizing:border-box;width:var(--vw,100vw);height:var(--vh,100vh);min-height:0;overflow:hidden;padding-top:var(--nav-height,64px);padding-bottom:max(var(--safe-bottom,0px),env(safe-area-inset-bottom));background:#F5FAF1}
.venueHeading{display:flex;align-items:center;justify-content:space-between;flex:none;gap:10px;padding:8px 16px 10px}
.venueSubtitle{flex:1;min-width:0;font-size:calc(14px * var(--font-scale));font-weight:400;line-height:1.5;color:#476451}
.venueBack{display:flex;align-items:center;justify-content:center;flex:none;box-sizing:border-box;min-width:76px;min-height:44px;margin:0;padding:8px 13px;border:1px solid #AFCBAB;border-radius:12px;background:#fff;color:#175C35;font-size:calc(14px * var(--font-scale));font-weight:400;line-height:1.3}
.venueFrame{position:relative;flex:1;min-height:0;margin:0 12px 12px}
.venueFrame venue-art{display:block;width:100%;height:100%;min-height:0}
.narrowCanvas .venueHeading{padding-left:12px;padding-right:12px;gap:6px}
.narrowCanvas .venueFrame{margin-left:8px;margin-right:8px}
.fontLarge .venueSubtitle{font-size:calc(13px * var(--font-scale))}
.venueBack{width:auto!important}
.gpsInfo{flex:none;min-height:22px;padding:0 16px 6px;color:#3e5949;font-size:11px;line-height:1.5;overflow-wrap:anywhere}.gpsInfo text{display:block}.gpsCoordinates{font-family:monospace;font-size:11px}.gpsMessage{color:#776037}.guideNativeMap{width:100%;height:100%}.guideTools{position:absolute;right:8px;top:8px;display:flex;flex-direction:column;gap:6px;z-index:5}.guideIcon{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px!important;min-width:44px;height:44px;margin:0;padding:0;border:2px solid #24342d;border-radius:3px;background:#fcf8ed}.guideIcon.active{background:#ddecbe}.guideIcon::after{border:0}

.venuePickerValue{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:44px;padding:4px 8px;border:1px solid #829575;background:#fcf8ed;box-sizing:border-box;color:#24342d}.venueReference{display:block;margin-top:5px;font-size:11px;line-height:1.45;color:#61705a}

.venueFrame campus-model{display:block;width:100%;height:100%}
