@import "../../utils/pixel-theme.wxss";

.venueScreen{
  display:flex;
  flex-direction:column;
  box-sizing:border-box;
  width:var(--vw,100vw);
  height:var(--vh,100vh);
  min-height:0;
  overflow:hidden;
  padding-top:var(--nav-height,64px);
  padding-bottom:calc(10px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
}

.venueHeaderWrap{
  flex:none;
  display:flex;
  flex-direction:column;
  gap:8px;
  padding:8px 12px 8px;
}

.venueBar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  padding:6px 10px;
}

.venuePicker{
  flex:1;
  min-width:0;
}

.venuePickerValue{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  min-height:36px;
  padding:4px 10px;
  background:#fff3d6;
  border:2px solid #2a6b94;
  border-radius:0;
  box-shadow:inset 0 2px 0 #d1b482;
  box-sizing:border-box;
  color:#3b1d0b;
}

.venuePickerText{
  flex:1;
  min-width:0;
  font-size:calc(15px * var(--font-scale,1));
  line-height:1.3;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.venuePickerArrow{
  flex:none;
  font-size:14px;
  color:#2a6e99;
}

.gpsInfo{
  padding:6px 10px;
  display:flex;
  flex-direction:column;
  gap:2px;
}

.gpsTopRow{
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
}

.venueReference{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.35;
  color:#2c6122;
}

.gpsMain{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.35;
  color:#332012;
  overflow-wrap:anywhere;
}

.gpsCoordinates{
  display:block;
  font-family:monospace;
  font-size:11px;
  color:#5e4c3c;
}

.gpsMessage{
  display:block;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.4;
  color:#a64d0b;
  overflow-wrap:anywhere;
}

.venueFrame{
  position:relative;
  flex:1;
  min-height:0;
  margin:0 12px;
  border:3px solid #3b1c0a;
  border-radius:0;
  background:#a8d481;
  box-shadow:0 3px 0 #79a857;
  overflow:hidden;
}

.venueFrame venue-art,
.venueFrame campus-model,
.guideNativeMap{
  display:block;
  width:100%;
  height:100%;
  min-height:0;
}

.guideTools{
  position:absolute;
  right:10px;
  top:10px;
  display:flex;
  flex-direction:column;
  gap:7px;
  z-index:5;
}

.guideIcon{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:2px;
  box-sizing:border-box;
  width:46px!important;
  min-width:46px;
  min-height:46px;
  height:46px;
  margin:0!important;
  padding:0!important;
  border:6px solid transparent;
  border-radius:0;
  background:transparent;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:6px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
}

.guideIcon.active{
  border-image-source:url("data:image/png;base64,");
  color:#24451c;
}

.guideIcon.guideStop{
  border-image-source:url("data:image/png;base64,");
  color:#731d0f;
}

.guideIcon::after{border:0}
.guideIcon[disabled]{opacity:.45}

.guideLabel{
  display:block;
  font-size:10px;
  line-height:1.1;
  color:inherit;
  white-space:nowrap;
}

.narrowCanvas .venueHeaderWrap{padding-left:8px;padding-right:8px}
.narrowCanvas .venueFrame{margin-left:8px;margin-right:8px}
