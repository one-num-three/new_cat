/* pages/history/history.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  color: #fff;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.stat-num.win {
  color: #4cd964;
}

.stat-num.lose {
  color: #ff6b6b;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-top: 10rpx;
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255,255,255,0.3);
}

/* 历史区域 */
.history-section {
  margin: 0 30rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  font-weight: normal;
}

/* 空状态 */
.empty-state {
  background: #fff;
  border-radius: 20rpx;
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  display: block;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 50rpx;
}

.btn-primary {
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 80rpx;
  font-size: 30rpx;
}

/* 历史列表 */
.history-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: #f9f9f9;
}

/* 角色徽章 */
.role-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.role-badge.cat {
  background: #ffe5e5;
  color: #ff6b6b;
}

.role-badge.mouse {
  background: #e5f3ff;
  color: #4a90d9;
}

/* 游戏信息 */
.game-info {
  flex: 1;
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.game-id {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.game-time {
  font-size: 24rpx;
  color: #999;
}

.game-details {
  display: flex;
  gap: 20rpx;
}

.detail-item {
  font-size: 24rpx;
  color: #666;
}

.detail-icon {
  margin-right: 5rpx;
}

/* 结果徽章 */
.result-badge {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.result-badge.win {
  background: #e8f5e9;
  color: #4caf50;
}

.result-badge.lose {
  background: #ffebee;
  color: #f44336;
}

/* 加载状态 */
.loading-more, .no-more {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #999;
}
