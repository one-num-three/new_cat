/* pages/task/task.wxss */
.task-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 开发模式：显示答案 */
.dev-answer {
  position: fixed;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 193, 7, 0.9);
  color: #333;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  z-index: 999;
  box-shadow: 0 4rpx 15rpx rgba(255, 193, 7, 0.5);
}

/* 标题区 */
.task-header {
  text-align: center;
  padding: 40rpx 0;
}

.task-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.task-subtitle {
  display: block;
  font-size: 28rpx;
  color: #aaa;
}

/* 游戏状态 */
.game-status {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin: 40rpx 0;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 24rpx 40rpx;
  border-radius: 20rpx;
}

.status-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.status-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

/* 结果反馈区 */
.result-area {
  margin: 40rpx 0;
}

.result-hint {
  background: rgba(78, 205, 196, 0.2);
  border: 2rpx solid #4ECDC4;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
}

.result-hint.placeholder {
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx dashed rgba(255, 255, 255, 0.2);
}

.result-label {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 16rpx;
}

.result-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
}

.result-number {
  font-size: 80rpx;
  font-weight: bold;
  color: #4ECDC4;
}

.result-unit {
  font-size: 32rpx;
  color: #4ECDC4;
}

/* 猜测记录 */
.history-area {
  margin: 40rpx 0;
  max-height: 300rpx;
}

.history-title {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 16rpx;
  padding-left: 10rpx;
}

.history-list {
  max-height: 250rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 16rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.history-item:last-child {
  border-bottom: none;
}

.history-guess {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  font-family: monospace;
  letter-spacing: 8rpx;
}

.history-result {
  font-size: 26rpx;
  color: #4ECDC4;
}

/* 输入区 */
.input-area {
  margin-top: 40rpx;
}

.input-row {
  margin-bottom: 24rpx;
}

.guess-input {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  text-align: center;
  letter-spacing: 20rpx;
  font-family: monospace;
}

.guess-input.disabled {
  opacity: 0.5;
}

.guess-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 2rpx;
  font-size: 28rpx;
  font-weight: normal;
}

/* 冷却提示 */
.cooldown-hint {
  text-align: center;
  margin: 24rpx 0;
}

.cooldown-text {
  display: block;
  font-size: 28rpx;
  color: #FFD700;
  margin-bottom: 16rpx;
}

.cooldown-bar {
  width: 80%;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  margin: 0 auto;
  overflow: hidden;
}

.cooldown-progress {
  height: 100%;
  background: linear-gradient(90deg, #FFD700, #FFA500);
  border-radius: 6rpx;
  transition: width 0.1s linear;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #4ECDC4 0%, #44B8A8 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
  margin-top: 24rpx;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.submit-btn.disabled {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.5);
}

/* 游戏结束弹窗 */
.game-end-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.modal-content {
  position: relative;
  background: linear-gradient(135deg, #2a2a4a 0%, #1a1a3a 100%);
  border-radius: 30rpx;
  width: 85%;
  max-width: 600rpx;
  border: 2rpx solid rgba(78, 205, 196, 0.5);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.modal-header {
  background: linear-gradient(135deg, #4ECDC4 0%, #44B8A8 100%);
  padding: 40rpx;
  text-align: center;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.modal-body {
  padding: 40rpx;
}

.modal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-item:last-child {
  border-bottom: none;
}

.modal-label {
  font-size: 28rpx;
  color: #888;
}

.modal-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.modal-value.answer {
  font-family: monospace;
  letter-spacing: 8rpx;
  color: #4ECDC4;
}

.modal-value.reward {
  color: #FFD700;
  font-size: 36rpx;
}

.modal-footer {
  padding: 20rpx 40rpx 40rpx;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.modal-btn.restart {
  background: linear-gradient(135deg, #4ECDC4 0%, #44B8A8 100%);
  color: #fff;
}

.modal-btn.back {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}