/* pages/quiz/quiz.wxss */
.quiz-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx;
  box-sizing: border-box;
}

/* 标题区 */
.quiz-header {
  text-align: center;
  padding: 40rpx 0;
}

.quiz-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.quiz-subtitle {
  display: block;
  font-size: 28rpx;
  color: #aaa;
}

/* 状态区 */
.quiz-status {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin: 30rpx 0;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 24rpx 40rpx;
  border-radius: 20rpx;
}

.status-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.status-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.status-value.score {
  color: #FFD700;
}

/* 题目区域 */
.question-area {
  margin-top: 30rpx;
}

.category-tag {
  display: inline-block;
  background: rgba(78, 205, 196, 0.2);
  border: 2rpx solid #4ECDC4;
  color: #4ECDC4;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.question-text {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.question-text text {
  font-size: 32rpx;
  color: #fff;
  line-height: 1.6;
}

/* 选项 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  gap: 20rpx;
  transition: all 0.3s ease;
}

.option-item:active {
  transform: scale(0.98);
}

.option-item.selected {
  border-color: #4ECDC4;
  background: rgba(78, 205, 196, 0.15);
}

.option-item.correct {
  border-color: #2ecc71;
  background: rgba(46, 204, 113, 0.2);
}

.option-item.wrong {
  border-color: #e74c3c;
  background: rgba(231, 76, 60, 0.2);
}

.option-letter {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.option-item.selected .option-letter {
  background: #4ECDC4;
  color: #fff;
}

.option-item.correct .option-letter {
  background: #2ecc71;
  color: #fff;
}

.option-item.wrong .option-letter {
  background: #e74c3c;
  color: #fff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #fff;
}

/* 解析 */
.explanation {
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #4ECDC4;
}

.explanation-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #4ECDC4;
  margin-bottom: 12rpx;
}

.explanation-text {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.5;
}

/* 倒计时 */
.countdown-bar {
  position: relative;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  margin-top: 30rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.countdown-progress {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: linear-gradient(90deg, #4ECDC4, #44B8A8);
  border-radius: 30rpx;
}

.countdown-text {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

/* 游戏结束弹窗 */
.game-end-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.modal-content {
  position: relative;
  background: linear-gradient(135deg, #2a2a4a 0%, #1a1a3a 100%);
  border-radius: 30rpx;
  width: 85%;
  max-width: 600rpx;
  border: 2rpx solid rgba(78, 205, 196, 0.5);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  overflow: hidden;
}

.modal-header {
  background: linear-gradient(135deg, #4ECDC4 0%, #44B8A8 100%);
  padding: 40rpx;
  text-align: center;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.modal-body {
  padding: 40rpx;
}

.modal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-item:last-child {
  border-bottom: none;
}

.modal-label {
  font-size: 28rpx;
  color: #888;
}

.modal-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.modal-value.reward {
  color: #FFD700;
  font-size: 36rpx;
}

.modal-footer {
  padding: 20rpx 40rpx 40rpx;
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.modal-btn.restart {
  background: linear-gradient(135deg, #4ECDC4 0%, #44B8A8 100%);
  color: #fff;
}

.modal-btn.back {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}