<!--pages/qrcode/qrcode.wxml-->
<view class="qrcode-container">
  <view class="qrcode-card {{hasGoldenShield ? 'golden-shield' : ''}}">
    <view class="qrcode-title">🐭 我的二维码</view>
    <view class="qrcode-subtitle">向猫展示此二维码</view>
    
    <!-- 金身保护提示 -->
    <view class="golden-shield-banner" wx:if="{{hasGoldenShield}}">
      <text>🛡️ 金身保护中 - 圈内不可被抓</text>
    </view>
    
    <!-- 二维码区域 -->
    <view class="qrcode-image-wrapper {{hasGoldenShield ? 'protected' : ''}}" bindlongpress="onLongPress">
      <!-- 预缓存的本地图片（秒开） -->
      <image 
        wx:if="{{qrCodePath}}"
        class="qrcode-image" 
        src="{{qrCodePath}}" 
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
      />
      
      <!-- 网络图片（备用） -->
      <image 
        wx:elif="{{qrCodeUrl}}"
        class="qrcode-image" 
        src="{{qrCodeUrl}}" 
        mode="aspectFit"
        bindload="onImageLoad"
        binderror="onImageError"
        show-menu-by-longpress="{{true}}"
      />
      
      <!-- 加载提示 -->
      <view wx:if="{{loading && !qrCodePath}}" class="qrcode-loading">
        <text>⏳ 生成中...</text>
      </view>
    </view>
    
    <!-- 金身完全遮罩（覆盖整个二维码区域） -->
    <view class="golden-shield-full-overlay" wx:if="{{hasGoldenShield}}" catchtouchmove="preventTouch">
      <view class="shield-icon">🛡️</view>
      <view class="shield-title">金身保护中</view>
      <view class="shield-desc">圈内无法被扫码抓住</view>
    </view>
    
    <!-- 玩家信息 -->
    <view class="player-info" wx:if="{{qrData}}">
      <text class="nickname">{{qrData.nickname}}</text>
      <text class="role-tag">🐭 老鼠</text>
    </view>
    
    <!-- 重要提示 -->
    <view class="warning-tip {{hasGoldenShield ? 'protected-tip' : ''}}">
      <text wx:if="{{hasGoldenShield}}">🛡️ 你正在金身保护圈内，猫无法扫码抓住你！</text>
      <text wx:else>⚠️ 被猫扫到即被抓住！</text>
    </view>
    
    <!-- 操作按钮 -->
    <view class="actions">
      <button class="btn-save" bindtap="saveToAlbum">💾 保存到相册</button>
      <button class="btn-back" bindtap="onBack">返回游戏</button>
    </view>
  </view>
</view>