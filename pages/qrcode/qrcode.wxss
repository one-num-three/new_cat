/* pages/qrcode/qrcode.wxss */
.qrcode-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
}

.qrcode-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
  text-align: center;
  max-width: 600rpx;
}

.qrcode-card.golden-shield {
  border: 6rpx solid #FFD700;
  box-shadow: 0 0 40rpx rgba(255, 215, 0, 0.6);
}

.qrcode-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.qrcode-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

/* 金身保护横幅 */
.golden-shield-banner {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #333;
  padding: 16rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  font-weight: bold;
  font-size: 26rpx;
}

.qrcode-image-wrapper {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 30rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #667eea;
  position: relative;
}

.qrcode-image-wrapper.protected {
  border-color: #FFD700;
}

.qrcode-image {
  width: 380rpx;
  height: 380rpx;
}

.qrcode-loading {
  color: #999;
  font-size: 28rpx;
}

/* 金身完全遮罩 - 覆盖整个二维码区域 */
.golden-shield-full-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.95) 0%, rgba(255, 165, 0, 0.95) 100%);
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.shield-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.shield-title {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.shield-desc {
  font-size: 26rpx;
  color: #666;
}

/* 旧的金身遮罩样式保留 */
.golden-shield-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 215, 0, 0.3);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.player-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.role-tag {
  background: #f0932b;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.warning-tip {
  background: #fff3cd;
  color: #856404;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #ffeeba;
}

.warning-tip.protected-tip {
  background: #d4edda;
  color: #155724;
  border-color: #c3e6cb;
}

.tip {
  background: #fff3cd;
  color: #856404;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #ffeeba;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save,
.btn-back {
  border: none;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}

.btn-save {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-back {
  background: #f5f5f5;
  color: #666;
}
