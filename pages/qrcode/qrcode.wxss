@import "../../utils/pixel-theme.wxss";

.codeScreen{
  --vw:100vw;
  --vh:100vh;
  --font-scale:1;
  box-sizing:border-box;
  width:var(--vw);
  min-height:var(--vh);
  display:flex;
  flex-direction:column;
  padding-bottom:max(var(--safe-bottom,0px),env(safe-area-inset-bottom));
  color:#332012;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
}

.codeBody{
  flex:1;
  padding:16px 14px 8px;
  display:flex;
  flex-direction:column;
  gap:12px;
}

.codeBody .sdvMeadowFooter{
  margin-top:auto;
}

.codeCard{
  overflow:hidden;
  padding:0 0 14px;
}

.codePlank{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:10px 14px;
  border:0;
  border-bottom:2px solid #7b3c14;
  border-radius:0;
}

.codePlankTitle{
  font-size:calc(18px * var(--font-scale));
  color:#3b1d0b;
}

.heading{
  display:block;
  margin:14px 16px 4px;
  font-size:calc(20px * var(--font-scale));
  line-height:1.35;
  text-align:center;
  color:#332012;
}

.codeHints{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:2px;
  padding:0 16px;
}

.codeHint{
  display:block;
  font-size:calc(13px * var(--font-scale));
  line-height:1.45;
  color:#5e4c3c;
}

.qrCard{
  width:min(calc(var(--vw) - 72px),256px);
  height:min(calc(var(--vw) - 72px),256px);
  margin:14px auto 12px;
  padding:8px;
  background:#ffffff;
  border:3px solid #3b1c0a;
  border-radius:0;
  box-shadow:inset 0 0 0 3px #b5652a,inset 0 0 0 5px #e8a254,0 3px 0 #cfa96c;
  box-sizing:border-box;
  display:flex;
  align-items:center;
  justify-content:center;
}

.demoCard{background:#f5dcab;border-color:#7d481e;box-shadow:inset 0 2px 0 #ffefc9,inset 0 -2px 0 #dab678,0 3px 0 #cfa96c}
.qr{display:block;width:100%;height:100%}

.qrDemo{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  width:100%;
  height:100%;
  gap:6px;
}

.demoArtFrame{
  width:78%;
  padding:8px 10px;
  background:#fff9e8;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fffdf6,0 2px 0 #dab678;
  box-sizing:border-box;
  display:flex;
  align-items:center;
  justify-content:center;
}

.demoArt{
  display:block;
  width:100%;
  height:auto;
}

.demoTitle{
  display:block;
  font-size:calc(15px * var(--font-scale));
  color:#332012;
}

.demoCaption{
  display:block;
  font-size:calc(12px * var(--font-scale));
  color:#5e4c3c;
}

.qrState{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  text-align:center;
  padding:12px;
}

.qrStateMark{
  display:flex;
  align-items:center;
  justify-content:center;
  width:40px;
  height:40px;
  background:#d1503a;
  color:#fffdf6;
  border:2px solid #4f2710;
  border-radius:0;
  font-size:22px;
}

.qrLoading{
  font-size:calc(14px * var(--font-scale));
  color:#5e4c3c;
  line-height:1.4;
}

.loadingPixels{display:flex;gap:8px}
.loadingPixels view{width:10px;height:10px;background:#4a943b;border:1px solid #2c6122}

.refreshRow{
  display:flex;
  justify-content:center;
  margin-bottom:10px;
}

.refreshBadge{font-size:calc(13px * var(--font-scale))}

.codeError{margin:0 16px 12px}

.safetyNote{
  margin:0 16px 14px;
  padding:9px 12px;
  background:#f5dcab;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff0cf,inset 0 -2px 0 #d9b678,0 2px 0 #cfa96c;
  display:flex;
  align-items:center;
  gap:10px;
}

.safetyMark{
  flex:none;
  width:24px;
  height:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#e87f24;
  border:2px solid #4f2710;
  border-radius:0;
  color:#fffdf6;
  font-size:14px;
  line-height:1;
}

.safetyCopy{
  flex:1;
  min-width:0;
  font-size:calc(13px * var(--font-scale));
  line-height:1.4;
  color:#3b1d0b;
}

.backAction{padding:0 16px}

.codeFooter{
  display:block;
  margin-top:10px;
  text-align:center;
  font-size:calc(12px * var(--font-scale));
  color:#5e4c3c;
}
