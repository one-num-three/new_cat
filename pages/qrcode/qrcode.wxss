/* pages/qrcode/qrcode.wxss */
.qrcode-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
}

.qrcode-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
  text-align: center;
  max-width: 600rpx;
}

.qrcode-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.qrcode-subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.qrcode-image-wrapper {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 30rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 4rpx solid #667eea;
}

.qrcode-image {
  width: 380rpx;
  height: 380rpx;
}

.qrcode-loading {
  color: #999;
  font-size: 28rpx;
}

.player-info {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.nickname {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.role-tag {
  background: #f0932b;
  color: #fff;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.tip {
  background: #fff3cd;
  color: #856404;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #ffeeba;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-save,
.btn-back {
  border: none;
  border-radius: 50rpx;
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}

.btn-save {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-back {
  background: #f5f5f5;
  color: #666;
}
