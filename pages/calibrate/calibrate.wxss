@import "../../utils/pixel-theme.wxss";

.calibrateScreen{
  min-height:var(--vh,100vh);
  padding:calc(var(--nav-height,64px) + 10px) 12px calc(104px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
  color:#332012;
}

.calWrap{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.calHead{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:9px 12px;
}

.calTitle{
  flex:1;
  min-width:0;
  font-size:calc(18px * var(--font-scale,1));
  line-height:1.35;
  color:#24451c;
  overflow-wrap:anywhere;
}

.calCard{
  padding:8px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.calCopy,.calHintNote{
  display:block;
  color:#5e4c3c;
  font-size:calc(13px * var(--font-scale,1));
  line-height:1.55;
  overflow-wrap:anywhere;
}

.calHintNote{
  font-size:calc(12px * var(--font-scale,1));
}

.calArt{
  height:clamp(220px,calc(var(--vh,100vh) * .36),300px);
  border:2px solid #3b1c0a;
  border-radius:0;
  overflow:hidden;
  background:#d4ebba;
}

.calArt .venueArt{
  display:block;
  width:100%;
  height:100%;
}

.calPickBar{
  padding:8px 10px;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ffe9bf,0 2px 0 #cfa362;
}

.calStatusText{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  line-height:1.4;
  color:#4f2304;
}

.calKinds,.calActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.controlMapFrame{
  position:relative;
  height:230px;
  border:2px solid #3b1c0a;
  border-radius:0;
  overflow:hidden;
  background:#dce8df;
}

.controlMap{
  width:100%;
  height:100%;
}

.mapCross{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  color:#e87f24;
  font-size:34px;
  line-height:1;
  text-shadow:0 0 3px #fffdf6;
  pointer-events:none;
}

.calSummaryBar{
  padding:8px 12px;
}

.calSummaryText{
  display:block;
  font-size:calc(14px * var(--font-scale,1));
  line-height:1.4;
  color:#24451c;
}

.calPointList{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.calRow{
  display:flex;
  align-items:center;
  gap:8px;
  padding:8px 10px;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff9e8,0 2px 0 #e2be7b;
}

.calCoord{
  flex:1;
  min-width:0;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.4;
  color:#332012;
  overflow-wrap:anywhere;
}

.calRemoveBtn{
  flex:none;
}

.calMsg{margin:0}

.calStickyRow{
  display:grid;
  grid-template-columns:1.35fr 1fr;
  gap:10px;
}

.fontLarge .calActions,.fontLarge .calStickyRow{
  grid-template-columns:1fr;
}
