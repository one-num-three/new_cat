@import "../../utils/pixel-theme.wxss";
.calibrateScreen{padding:calc(var(--nav-height) + 12px) 14px max(28px,env(safe-area-inset-bottom));background:#fcf8ed}.calTitle{display:block;font-size:24px;line-height:1.5}.calCopy{display:block;color:#496348;font-size:14px;line-height:1.7;margin:10px 0}.calArt{height:340px;border:2px solid #526449}.calStatus{display:block;margin:12px 0;font-size:16px;line-height:1.5}.calKinds,.calActions{display:flex;gap:8px;margin:10px 0}.calKinds button,.calActions button{flex:1;min-width:0;min-height:44px;padding:10px 7px;font-size:14px;line-height:1.5;background:#fffdf5;border:2px solid #668358}.calKinds .selected{background:#e4efce;color:#274d2f}.controlMapFrame{position:relative;height:260px}.controlMap{width:100%;height:100%}.mapCross{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#e5731f;font-size:36px;pointer-events:none}.calRow{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #dbcdb9;font-size:12px}.calRow text{flex:1;min-width:0;overflow-wrap:anywhere}.calRow button{flex:none;min-height:44px;font-size:14px;background:transparent;color:#974b27}.calSave{min-height:48px;width:100%;padding:12px;font-size:20px;color:white;background:#328650;border:2px solid #182d20}
