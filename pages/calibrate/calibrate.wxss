@import "../../utils/pixel-theme.wxss";
.calibrateScreen{padding:calc(var(--nav-height) + 12px) 14px max(28px,max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));background:#fcf8ed}.calTitle{display:block;font-size:calc(24px * var(--font-scale,1));line-height:1.5}.calCopy{display:block;color:#496348;font-size:calc(14px * var(--font-scale,1));line-height:1.7;margin:10px 0}.calArt{height:clamp(240px,calc(var(--vh,100vh) * .42),340px);border:2px solid #526449}.calStatus{display:block;margin:12px 0;font-size:calc(16px * var(--font-scale,1));line-height:1.5}.calKinds,.calActions{display:flex;gap:8px;margin:10px 0}.calKinds button,.calActions button{width:auto!important;white-space:normal;flex:1;min-width:0;min-height:44px;padding:10px 7px;font-size:calc(14px * var(--font-scale,1));line-height:1.5;background:#fffdf5;border:2px solid #668358}.calKinds .selected{background:#e4efce;color:#274d2f}.controlMapFrame{position:relative;height:260px}.controlMap{width:100%;height:100%}.mapCross{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);color:#e5731f;font-size:36px;pointer-events:none}.calRow{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #dbcdb9;font-size:calc(12px * var(--font-scale,1))}.calRow text{flex:1;min-width:0;overflow-wrap:anywhere}.calRow button{flex:none;min-height:44px;font-size:calc(14px * var(--font-scale,1));background:transparent;color:#974b27}.calSave{min-height:48px;width:100%!important;padding:12px;font-size:calc(20px * var(--font-scale,1));color:white;background:#328650;border:2px solid #182d20}
