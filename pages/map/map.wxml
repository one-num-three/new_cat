<!--pages/map/map.wxml-->
<view class="map-container">
  <!-- 地图 - 独立层，确保手势正常 -->
  <!-- show-location="true" 显示系统定位指示器（蓝色水滴） -->
  <!-- markers 只显示其他玩家，不显示自己 -->
  <!-- 引爆动画（使用markers显示在地图上） -->
  <map
    id="gameMap"
    class="game-map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="{{scale}}"
    markers="{{allMarkers}}"
    circles="{{allCircles}}"
    show-location="{{true}}"
    enable-satellite="false"
    enable-overlooking="true"
    enable-zoom="true"
    enable-scroll="true"
    enable-rotate="true"
    bindregionchange="onRegionChange"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
  />
  
  <!-- 轰炸选择遮罩 -->
  <view class="bombard-overlay" wx:if="{{selectingBombard}}">
    <view class="bombard-overlay-content">
      <view class="bombard-title">💣 选择轰炸点</view>
      <view class="bombard-desc">轻触地图选择打击位置</view>
      <view class="bombard-info">半径 150米 | 伤害 50积分 | 30秒后引爆</view>
    </view>
    <view class="bombard-cancel" catchtap="cancelBombardSelect">取消</view>
  </view>
  
  <!-- 轰炸确认按钮 -->
  <view class="bombard-confirm-bar" wx:if="{{showBombardConfirm}}">
    <view class="bombard-confirm-hint">💣 已选择轰炸点，确认设置？</view>
    <view class="bombard-confirm-btns">
      <view class="bombard-reselect-btn" catchtap="onReselectBombard">重新选择</view>
      <view class="bombard-confirm-btn" catchtap="onConfirmBombard">确认轰炸</view>
    </view>
  </view>
  
  <!-- 轰炸倒计时显示 -->
  <view class="bombard-timers">
    <view class="bombard-timer-item" wx:for="{{bombardTimers}}" wx:key="id">
      <view class="bombard-timer-content">
        <text class="bombard-timer-icon">💣</text>
        <text class="bombard-timer-sec {{item.remainingSec <= 5 ? 'urgent' : ''}}">{{item.remainingSec}}s</text>
      </view>
    </view>
  </view>
  
  <!-- 引爆动画标记（通过markers实现） -->
  <!-- 视野范围提示 -->
  <view class="vision-hint-bar {{hasEagleEye ? 'eagle-eye-active' : ''}} {{inGoldenShield ? 'golden-shield-active' : ''}}" wx:if="{{gameStatus === 'playing'}}">
    <text>👁️ 视野: {{displayVisionRange}}米 {{playerRole === 'cat' ? '(猫+30%)' : ''}}</text>
    <text wx:if="{{hasEagleEye}}"> 🦅鹰眼×{{eagleEyeStacks}}</text>
    <text wx:if="{{inGoldenShield}}"> 🛡️金身保护中</text>
  </view>
  
  <!-- 任务点提示 -->
  <view class="task-point-bar {{inTaskPoint ? 'in-range' : ''}}" wx:if="{{taskPoint && taskPoint.status === 'active'}}">
    <view class="task-info">
      <text class="task-icon">📍</text>
      <text class="task-text">{{taskPoint.taskType === 'quiz' ? '趣味问答' : '猜数字'}}</text>
      <text class="task-reward">+{{taskPoint.reward || 50}}分</text>
    </view>
    <view class="task-slots">
      <text class="slot-cat">🐱{{(taskPoint.catSlots || 1) - (taskPoint.catClaimed || 0)}}/{{taskPoint.catSlots || 1}}</text>
      <text class="slot-mouse">🐭{{(taskPoint.mouseSlots || 1) - (taskPoint.mouseClaimed || 0)}}/{{taskPoint.mouseSlots || 1}}</text>
    </view>
  </view>
  
  <!-- 开发模式调试信息 -->
  <view class="debug-info" wx:if="{{devMode}}" style="position:fixed;top:100rpx;left:20rpx;background:rgba(0,0,0,0.9);color:#0f0;padding:20rpx;font-size:20rpx;z-index:999;border-radius:10rpx;max-width:90%;">
    <text>pendingTaskReward: {{pendingTaskReward ? '有' : '无'}}</text>
    <text wx:if="{{pendingTaskReward}}">\n  reward: {{pendingTaskReward.reward}}</text>
    <text>\ntaskPoint: {{taskPoint ? '有' : '无'}}</text>
    <text wx:if="{{taskPoint}}">\n  taskType: {{taskPoint.taskType || '无'}}</text>
    <text>\n实际视野: {{actualVisionRange || visionRange}}米</text>
    <text>\ninTaskPoint: {{inTaskPoint}}</text>
    <text>\ncanClaimTask: {{canClaimTask}}</text>
    <text>\n当前位置: {{currentLatitude ? '有' : '无'}}</text>
  </view>
  
  <!-- 调试：直接显示Storage内容 -->
  <view class="debug-storage" wx:if="{{devMode}}" style="position:fixed;top:320rpx;left:20rpx;background:rgba(0,0,0,0.9);color:#ff0;padding:20rpx;font-size:20rpx;z-index:999;border-radius:10rpx;">
    <text>Storage pendingTaskReward:</text>
    <text>\n{{debugStorageValue || 'null'}}</text>
    <view style="margin-top:10rpx;">
      <text style="background:#f00;padding:5rpx 10rpx;border-radius:5rpx;" bindtap="onDebugClearStorage">清除Storage</text>
    </view>
  </view>
  
  <!-- 待领取奖励提示 -->
  <view class="pending-reward-bar" style="top: {{rewardBarTop}}rpx;" wx:if="{{pendingTaskReward && taskPoint && taskPoint.status === 'active' && !inTaskPoint}}">
    <text class="pending-icon">🎁</text>
    <text class="pending-text">待领取奖励: +{{pendingTaskReward.reward}}分</text>
    <text class="pending-hint">请返回任务点领取</text>
  </view>
  
  <!-- 任务按钮 -->
  <view class="task-btn-wrapper" 
        style="top: {{taskBtnTop}}rpx;"
        wx:if="{{inTaskPoint && taskPoint && taskPoint.status === 'active'}}">
    <!-- 有待领取奖励 -->
    <view class="guess-number-btn reward-mode" wx:if="{{pendingTaskReward}}" bindtap="onClaimReward">
      <text>🎁 领取 +{{pendingTaskReward.reward}}分</text>
    </view>
    <!-- 名额已满 -->
    <view wx:elif="{{canClaimTask === false}}">
      <view class="guess-number-btn disabled">
        <text>{{playerRole === 'cat' ? '🐱名额已满' : '🐭名额已满'}}</text>
      </view>
      <text class="task-remaining">⏱️ 剩余 {{taskPointRemaining}}</text>
    </view>
    <!-- 可以玩游戏 -->
    <view wx:else>
      <view class="guess-number-btn" bindtap="onEnterTask">
        <text>{{taskPoint.taskType === 'quiz' ? '🎯 趣味问答' : '🎯 猜数字'}}</text>
      </view>
      <text class="task-remaining">⏱️ 剩余 {{taskPointRemaining}}</text>
    </view>
  </view>

  <!-- 弹幕区域 -->
  <view class="danmaku-area">
    <view class="danmaku-item {{item.show ? 'show' : ''}}" wx:for="{{danmakuList}}" wx:key="time">
      {{item.message}}
    </view>
  </view>

  <!-- 顶部信息层 -->
  <view class="top-layer">
    <!-- 记分板（小、左上角、可收起） -->
    <view class="score-board-mini" wx:if="{{allPlayers.length > 0}}">
      <view class="score-header" bindtap="toggleScoreBoard">
        <text class="score-icon">🏆</text>
        <text class="score-toggle">{{showScoreBoard ? '▼' : '▶'}}</text>
      </view>
      <view class="score-list-mini" wx:if="{{showScoreBoard}}">
        <!-- 默认显示前5个玩家 -->
        <view class="score-item-mini {{item.isOffline ? 'offline' : ''}}" wx:for="{{allPlayers}}" wx:key="id" wx:if="{{index < 5 || showAllPlayers}}">
          <text class="score-rank-mini">{{index + 1}}</text>
          <text class="score-role-mini">{{item.role === 'cat' ? (item.isOffline ? '🐱💤' : '🐱') : (item.isOffline ? '🐭💤' : '🐭')}}</text>
          <text class="score-name-mini">{{item.nickname}}</text>
          <text class="score-points-mini">{{item.score || 0}}</text>
        </view>
        <!-- 展开/收起按钮 -->
        <view class="score-expand-btn" wx:if="{{allPlayers.length > 5}}" bindtap="toggleAllPlayers">
          <text>{{showAllPlayers ? '收起' : '展开全部 (' + allPlayers.length + '人)'}}</text>
        </view>
      </view>
    </view>

    <!-- 角色提示 -->
    <view class="role-tip" wx:if="{{showRoleTip}}">
      <text wx:if="{{playerRole === 'cat'}}">🐱 你是猫 · 抓住所有老鼠</text>
      <text wx:else>🐭 你是鼠 · 躲避猫的追捕</text>
      <view class="close-tip" bindtap="hideRoleTip">×</view>
    </view>
    
    <!-- 亮屏提示 -->
    <view class="screen-tip" wx:if="{{showScreenTip && gameStatus === 'playing'}}">
      <text>⚠️ 请保持屏幕常亮，否则可能被判定掉线</text>
      <view class="close-tip" bindtap="hideScreenTip">×</view>
    </view>

    <!-- 游戏信息 -->
    <view class="game-info">
      <text>⏱️ {{countdownText}}</text>
      <text>👥 {{catCount}}猫{{mouseCount}}鼠</text>
      <!-- 历史记录按钮 -->
      <text class="history-btn" bindtap="onShowHistory">📜</text>
    </view>
  </view>

  <!-- 道具商店弹窗 -->
  <view class="shop-modal" wx:if="{{showShop}}">
    <view class="shop-mask" bindtap="onCloseShop"></view>
    <view class="shop-content">
      <view class="shop-header">
        <text class="shop-title">🛒 道具商店</text>
        <text class="shop-score">💰 {{myScore}}分</text>
        <view class="shop-close" bindtap="onCloseShop">×</view>
      </view>
      <view class="shop-list">
        <view class="shop-item {{item.id === 'bombard' && hasActiveBombard ? 'disabled' : ''}}" wx:for="{{shopItems}}" wx:key="id">
          <view class="shop-item-icon">{{item.icon}}</view>
          <view class="shop-item-info">
            <text class="shop-item-name">{{item.name}}</text>
            <text class="shop-item-desc">{{item.id === 'bombard' && hasActiveBombard ? '已有轰炸进行中' : item.desc}}</text>
          </view>
          <view class="shop-item-price">{{item.price}}分</view>
          <view class="shop-item-btn {{item.id === 'bombard' && hasActiveBombard ? 'disabled' : ''}}" 
                bindtap="{{item.id === 'bombard' && hasActiveBombard ? '' : 'onBuyItem'}}" 
                data-item="{{item.id}}">
            <text>{{item.id === 'bombard' && hasActiveBombard ? '等待' : '购买'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 左侧按钮层 -->
  <view class="left-layer">
    <!-- 猫：扫码抓人按钮 -->
    <view class="action-btn scan-btn" wx:if="{{playerRole === 'cat'}}" bindtap="onScanQRCode">
      <text>📷 扫码抓人</text>
    </view>

    <!-- 鼠：二维码按钮 -->
    <view class="action-btn qrcode-btn" wx:if="{{playerRole === 'mouse' && !isCaught}}" bindtap="onShowQRCode">
      <text>🐭 我的二维码</text>
    </view>

    <!-- 道具商店按钮（所有玩家可用） -->
    <view class="action-btn shop-btn" bindtap="onOpenShop">
      <text>🛒 商店</text>
    </view>
  </view>

  <!-- 右侧按钮层 -->
  <view class="right-layer">
    <!-- 结束按钮 -->
    <view class="action-btn end-btn" bindtap="onEndGame">
      <text>结束</text>
    </view>

    <!-- 地图缩放控制 -->
    <view class="zoom-controls">
      <view class="zoom-btn" bindtap="onZoomIn">+</view>
      <view class="zoom-btn" bindtap="onZoomOut">−</view>
      <view class="locate-btn" bindtap="onBackToLocation">📍</view>
    </view>
  </view>

  <!-- 历史记录弹窗 -->
  <view class="history-modal" wx:if="{{showHistory}}">
    <view class="history-mask" bindtap="onCloseHistory"></view>
    <view class="history-content">
      <view class="history-header">
        <text class="history-title">📜 战况记录</text>
        <view class="history-close" bindtap="onCloseHistory">×</view>
      </view>
      <view class="history-list">
        <view class="history-item" wx:for="{{events}}" wx:key="time">
          <text class="history-time">{{item.timeText}}</text>
          <text class="history-msg">{{item.message}}</text>
        </view>
        <view class="history-empty" wx:if="{{events.length === 0}}">
          暂无战况记录
        </view>
      </view>
    </view>
  </view>
</view>
