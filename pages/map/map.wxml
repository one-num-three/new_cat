<view bindlayout="remeasureVenue" class="mapPage state-{{uiState}} {{terminal?'documentPage':'playPage'}} {{nightMode?'sdvNight':''}} {{fontScale>1.15?'fontLarge':''}} {{viewportWidth<350?'narrowCanvas':''}}" style="--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--safe-bottom:{{safeBottom}}px;--tray-duration:{{devPreview && motionPreviewMs?motionPreviewMs:260}}ms">
<nav-bar title="猫鼠行动" pinned="{{terminal}}" preview="{{devPreview}}" custom="{{!!(match && !terminal)}}">
  <view wx:if="{{match && !terminal}}" class="hudPlaque navRolePlaque role-{{match.myRole}}" aria-label="阵营与状态">
    <image class="hudAvatar" src="{{(match && match.myRole==='mouse')?'/assets/sdv-v1/hud-mouse.png':'/assets/sdv-v1/hud-cat.png'}}" mode="aspectFit" aria-hidden="true" />
    <text class="roleName">{{roleText}}</text>
    <view class="navRoleDot" aria-hidden="true"></view>
    <text class="phaseName">{{offline?'重连中':uiState==='paused'?'已暂停':uiState==='captured'?'已核验':phaseText}}</text>
    <text wx:if="{{devPreview}}" class="navPreviewTag">预览</text>
  </view>
</nav-bar>
<view wx:if="{{!match}}" class="sdvWoodCard emptyState">
  <text class="emptyTitle">正在同步状态</text>
  <text class="bodyCopy">{{error || '请稍候…'}}</text>
  <button class="sdvBtn sdvBtnWood sdvBtnSm" bindtap="goHome">返回首页</button>
</view>

<scroll-view wx:elif="{{terminal}}" scroll-y class="terminalScroll">
  <view class="terminalWrap">
    <view class="sdvWoodCard summaryHeroCard">
      <image class="resultHero" src="/assets/sdv-v1/summary-banner.png" mode="widthFix" aria-label="户外活动结束手账归档横幅" />
      <view class="sdvPlank summaryPlank">
        <text class="summaryPlankTitle">{{uiState==='cancelled'?'场次已取消':'场次汇总'}}</text>
        <text class="sdvBadge {{uiState==='cancelled'?'sdvBadgeGray':'sdvBadgeGreen'}}">{{uiState==='cancelled'?'已取消':'已归档'}}</text>
      </view>
    </view>

    <view class="sdvWoodCard resultStats">
      <view class="resultVictoryBanner victory-{{uiState}}">
        <image wx:if="{{uiState==='catWin' || uiState==='mouseWin'}}" class="victoryMascot" src="{{uiState==='catWin'?'/assets/sdv-v1/hud-cat.png':'/assets/sdv-v1/hud-mouse.png'}}" mode="aspectFit" aria-hidden="true" />
        <pixel-glyph wx:else kind="flag" size="22" color="#5e3616" />
        <view class="victoryCopy">
          <text class="victoryTitle">{{uiState==='catWin'?'猫队达成目标':uiState==='mouseWin'?'鼠队成功脱险':'场次已取消'}}</text>
          <text class="resultReason">{{uiState==='catWin'?'共 '+(roster.length||match.target)+' 人参与 · 核验完成':uiState==='mouseWin'?'共 '+(roster.length||match.target)+' 人参与 · 计时结束':'本场记录已保存归档'}}</text>
        </view>
        <view wx:if="{{uiState==='catWin' || uiState==='mouseWin'}}" class="victoryMedal" aria-hidden="true">
          <pixel-glyph kind="crown" size="15" color="#a64d0b" />
          <text>胜</text>
        </view>
      </view>
      <view class="resultGrid">
        <view class="resultMetric">
          <view class="statIconHead">
            <pixel-glyph kind="scan" size="13" color="#2c6122" />
            <text class="statLabel">核验</text>
          </view>
          <view class="statValue"><text class="orangeNumber">{{match.captured}}</text><text class="statDenom"> / {{match.target}}</text></view>
        </view>
        <view class="resultMetric resultMetricSky">
          <view class="statIconHead">
            <pixel-glyph kind="pin" size="13" color="#a64d0b" />
            <text class="statLabel">场地</text>
          </view>
          <text class="statVenue">{{venueName}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{uiState==='mouseWin'}}" class="sdvPaperCard resultMapCard">
      <view class="sdvIconTitle">
        <pixel-glyph kind="map" size="16" color="#2c6122" />
        <text>场地范围</text>
      </view>
      <view class="resultMap">
        <map wx:if="{{venueMapId==='native-gcj02-v1'}}" class="gameMap" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{mapScale}}" polygons="{{venuePolygons}}" />
        <venue-art wx:else class="venueArt" image-id="{{venueMapId}}" src="{{parkArt}}" compact="{{true}}" layout-key="{{viewportWidth+'x'+viewportHeight+'-'+fontScale}}" />
      </view>
    </view>

    <view class="sdvPaperCard trackResultCard" wx:if="{{!devPreview && !offline && match.trackVersion==='tracks-v1'}}">
      <view class="sdvIconTitle">
        <pixel-glyph kind="route" size="16" color="#2c6122" />
        <text>轨迹与海报</text>
      </view>
      <view class="trackResultActions">
        <button class="sdvBtn sdvBtnWood sdvBtnSm" bindtap="openTracks" data-scope="self">
          <pixel-glyph kind="image" size="15" color="#3b1d0b" />
          <text>个人海报</text>
        </button>
        <button wx:if="{{owner}}" class="sdvBtn sdvBtnPaper sdvBtnSm" bindtap="openTracks" data-scope="all">
          <pixel-glyph kind="download" size="15" color="#3b1d0b" />
          <text>全员轨迹</text>
        </button>
      </view>
    </view>

    <view class="resultActions">
      <pixel-action class="pixelControl" wx:if="{{canReplay}}" skin="/assets/pixel-v1/button-catwin-replay.png" label="发起下一场" tone="green" font-scale="{{fontScale}}" bindaction="replay" />
      <text wx:else class="waitingHost">{{offline?'重连后可开始下一场':'等待组织者发起下一场'}}</text>
      <view class="resultSubActions">
        <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-catwin-details.png" label="战况" tone="plain" font-scale="{{fontScale}}" bindaction="toggleDrawer" />
        <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-catwin-home.png" label="首页" tone="plain" font-scale="{{fontScale}}" bindaction="goHome" />
      </view>
    </view>
    <text wx:if="{{uiState==='cancelled'}}" class="recordNote">已保留本场记录</text>
    <image class="sdvMeadowFooter meadowBleed14" src="/assets/sdv-v1/meadow-strip.png" mode="widthFix" aria-hidden="true" />
  </view>
</scroll-view>

<block wx:else>
  <view class="mapCanvas" aria-label="活动定位地图">
    <campus-model wx:if="{{modelMode}}" class="campusModel" compact="{{true}}" image-id="{{venueMapId}}" geo-data="{{geoData}}" layout-key="{{viewportWidth+'x'+viewportHeight}}" bindready="onMapReady" bindfallback="useArtMap" />
    <venue-art class="venueArt" style="--venue-dock-display:none;--venue-attr-bottom:calc(68px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)))" wx:elif="{{artMode}}" bindready="onMapReady" src="{{parkArt}}" image-id="{{venueMapId}}" registration="{{mapCalibration}}" osm-reference="{{true}}" geo-data="{{geoData}}" bindprojection="onArtProjection" bindcamera="onArtCamera" auto-tour="{{false}}" compact="{{true}}" layout-key="{{viewportWidth+'x'+viewportHeight+'-'+fontScale+'-'+uiState}}" />
    <map wx:else id="gameMap" class="gameMap" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{mapScale}}" markers="{{markers}}" circles="{{circles}}" polygons="{{venuePolygons}}" show-location="{{false}}" enable-rotate="{{false}}" enable-overlooking="{{false}}" bindregionchange="onMapRegion" />
  </view>

  <view class="playHud compactHud role-{{match.myRole}}" aria-label="本场活动状态">
    <view class="hudPlaque hudMainBar">
      <view class="hudMainMetrics">
        <text class="compactClock {{clockAlert?'clock-'+clockAlert:''}}">{{clock}}</text>
        <view class="compactProgress"><text class="progressTag">已抓</text><text class="orangeNumber">{{match.captured}}</text><text class="progressSep">/{{match.target}}</text></view>
      </view>
      <view wx:if="{{meetingGuideText && !offline}}" class="hudGuideInline" aria-label="集合点方向与距离">
        <pixel-glyph kind="compass" size="12" color="#a64d0b" />
        <text class="hudGuideText">{{meetingGuideText}}</text>
      </view>
      <location-signal class="mapLocationSignal" signal="{{locationSignal}}" font-scale="{{fontScale}}" bindtap="openSignalCheck" />
    </view>
    <view wx:if="{{!devPreview && !offline && !terminal && !backgroundReady && !fgTipDismissed && (match.myStatus==='active' || match.myStatus==='joining')}}" class="fgLocationBanner" role="status">
      <text class="fgLocationText">仅前台定位 · 请保持亮屏勿切出微信</text>
      <button class="fgLocationBtn" hover-class="sdvPressed" bindtap="openLocationSettings">设置</button>
      <button class="fgLocationClose" hover-class="sdvPressed" bindtap="dismissFgTip" aria-label="关闭提示">×</button>
    </view>
  </view>

  <view class="mapTools" aria-label="地图辅助工具">
    <button class="edgeButton {{vibeOn?'vibeActive':'vibeMuted'}}" hover-class="sdvPressed" bindtap="toggleVibe" aria-label="{{vibeOn?'关闭震动提醒':'开启震动提醒'}}">
      <pixel-glyph kind="{{vibeOn?'bell':'bellOff'}}" size="18" color="{{vibeOn?'#2c6122':'#7c522b'}}" />
      <text class="toolLabel">{{vibeOn?'提醒':'静音'}}</text>
    </button>
    <button wx:if="{{modelMode}}" class="edgeButton" hover-class="sdvPressed" bindtap="tiltModel" aria-label="切换3D俯视与斜视">
      <pixel-glyph kind="cube" size="18" color="#332012" />
      <text class="toolLabel">视角</text>
    </button>
    <button class="edgeButton layerButton" hover-class="sdvPressed" wx:if="{{venueMapId!=='native-gcj02-v1'}}" bindtap="toggleMapMode" disabled="{{layerLoading}}" aria-label="选择地图图层">
      <pixel-glyph kind="layers" size="18" color="#332012" />
      <text class="toolLabel">图层</text>
    </button>
    <button class="edgeButton locateButton" hover-class="sdvPressed" bindtap="locateSelf" aria-label="回到本人位置">
      <pixel-glyph kind="locate" size="18" color="#332012" />
      <text class="toolLabel">定位</text>
    </button>
  </view>

  <view class="mapStatusRegion">
    <view wx:if="{{offline}}" class="mapStatus statusReconnect">
      <text class="statusTitle">{{connection==='身份失效'?'身份失效':'断线重连中'}}</text>
      <text>{{connection==='身份失效'?'请回首页重进':'恢复后自动同步'}}</text>
      <button wx:if="{{connection==='身份失效'}}" class="compactButton" bindtap="goHome">回首页</button>
    </view>
    <view wx:elif="{{uiState==='paused'}}" class="mapStatus">
      <text class="statusTitle">活动暂停</text>
      <text>{{pauseReasonText}}</text>
      <button wx:if="{{canResume}}" class="compactButton" bindtap="resume">恢复活动</button>
      <text wx:else>等待组织者恢复</text>
    </view>
    <view wx:elif="{{uiState==='joining'}}" class="mapStatus">
      <text class="statusTitle">已补入{{roleText}}</text>
      <text>请在范围内定位（30s）</text>
    </view>
    <view wx:elif="{{uiState==='left'}}" class="mapStatus">
      <text class="statusTitle">已退出本场</text>
      <text>仅查看公开状态</text>
    </view>
    <view wx:elif="{{uiState==='captured'}}" class="mapStatus">
      <text class="statusTitle">已核验登记</text>
      <text>仅查看公开位置 · 回集合点等待</text>
    </view>
    <view wx:elif="{{uiState==='hiding'}}" class="mapStatus">
      <text class="statusTitle">{{match.myRole==='cat'?'准备倒计时 · 等待出发':'准备倒计时 · 先往范围内'}}</text>
      <text>{{match.myRole==='cat'?'结束后开始行动':'选好位置 · 右下看明细'}}</text>
    </view>
    <view wx:elif="{{nearbyCat}}" class="mapStatus proximityWarning">
      <text class="statusTitle">附近有猫队</text>
      <text>{{mouseTeamVision?'地图已标出视野内猫位置':'近距预警 · 无精确坐标'}}</text>
    </view>
    <view wx:elif="{{sharedCatCount}}" class="mapStatus">
      <text class="statusTitle">同伴共享 {{sharedCatCount}} 处</text>
      <text>猫头像为共享视野，离视野即移除</text>
    </view>
    <view wx:elif="{{artMode && (omittedArtRegions || omittedArtBoundary)}}" class="mapStatus">
      <text>{{omittedArtBoundary?'边界超出像素图，请切实时图':'部分点超出像素图，请切实时图'}}</text>
    </view>
  </view>

  <view wx:if="{{captureRetry && !offline && !terminal}}" class="captureRetryBar">
    <text>核验待确认</text>
    <button class="sdvBtn sdvBtnGreen sdvBtnSm sdvBtnInline" bindtap="retryCapture" disabled="{{loading}}">重试</button>
  </view>

  <view class="mapBottomDock" aria-label="活动主操作栏">
    <button wx:if="{{canScan}}" class="dockBtn dockPrimary sdvBtnAmber" hover-class="sdvPressed" bindtap="scan" disabled="{{loading}}" aria-label="{{loading?'正在确认核验':'双方停下后扫码确认核验'}}">
      <pixel-glyph kind="scan" size="18" color="#fffdf6" />
      <text>扫码核验</text>
    </button>
    <button wx:if="{{canShowCode}}" class="dockBtn dockPrimary sdvBtnGreen" hover-class="sdvPressed" bindtap="showCode" aria-label="停下后展示现场动态核验码">
      <pixel-glyph kind="code" size="18" color="#fffdf6" />
      <text>核验码</text>
    </button>
    <button wx:if="{{canResume}}" class="dockBtn dockPrimary sdvBtnGreen" hover-class="sdvPressed" bindtap="resume" disabled="{{loading}}" aria-label="恢复活动">
      <pixel-glyph kind="check" size="18" color="#fffdf6" />
      <text>恢复</text>
    </button>
    <button class="dockBtn {{(canScan || canShowCode || canResume)?'dockSecondary':'dockPrimary'}} sdvBtnPaper" hover-class="sdvPressed" data-tab="team" bindtap="openDrawer" aria-label="查看成员、战况与设置">
      <pixel-glyph kind="team" size="18" color="#332012" />
      <text>战况</text>
      <view wx:if="{{unreadEvents>0}}" class="dockBadge">{{unreadEvents>9?'9+':unreadEvents}}</view>
    </button>
  </view>
</block>

<view wx:if="{{error && !offline}}" class="sdvError mapError errorDismissible" bindtap="clearError" role="alert" aria-label="关闭提示">
  <text class="errorText">{{error}}</text>
  <text class="errorClose" aria-hidden="true">×</text>
</view>

<view wx:if="{{drawer}}" class="drawerMask {{drawerClosing?'sheetLeaving':''}}" bindtap="closeDrawer" catchtouchmove="ignoreTouch"></view>
<view wx:if="{{drawer}}" class="drawer {{drawerClosing?'sheetLeaving':''}}" bindanimationend="drawerAnimationEnd">
  <view class="sheetGrip" bindtouchstart="sheetTouchStart" bindtouchend="sheetTouchEnd"><view class="drawerHandle"></view></view>
  <view class="drawerHeader">
    <image class="drawerLogo" src="/assets/sdv-v1/drawer-title.png" mode="aspectFit" />
    <text class="drawerHeaderTitle">活动战况</text>
    <button class="sheetCloseButton drawerNightBtn" hover-class="sdvPressed" bindtap="toggleNightMode" aria-label="{{nightMode?'切换日间模式':'切换夜间营火模式'}}"><pixel-glyph kind="{{nightMode?'sun':'moon'}}" size="15" color="{{nightMode?'#ffd269':'#5e3616'}}" /></button>
    <view class="drawerClose">
      <button class="sheetCloseButton" bindtap="closeDrawer" aria-label="关闭战况"><pixel-glyph kind="close" size="16" color="#332012" /></button>
    </view>
  </view>
  <view class="drawerTabs">
    <button data-tab="team" class="{{drawerTab==='team'?'selected':''}}" bindtap="selectDrawerTab">
      <pixel-glyph kind="team" size="14" color="#3b1d0b" />
      <text>成员</text>
    </button>
    <button data-tab="events" class="{{drawerTab==='events'?'selected':''}}" bindtap="selectDrawerTab">
      <pixel-glyph kind="clock" size="14" color="#3b1d0b" />
      <text>动态</text>
    </button>
    <button data-tab="rules" class="{{drawerTab==='rules'?'selected':''}}" bindtap="selectDrawerTab">
      <pixel-glyph kind="settings" size="14" color="#3b1d0b" />
      <text>设置</text>
    </button>
  </view>
  <scroll-view scroll-y class="drawerBody">
    <view class="drawerContent">
      <view wx:if="{{drawerTab==='team'}}" class="squadColumns">
        <view class="squad catsGroup">
          <view class="squadHead"><image src="/assets/sdv-v1/hud-cat.png" mode="aspectFit" /><text>猫队 {{cats.length}}人</text></view>
          <view class="teamGrid catGrid">
            <view wx:for="{{cats}}" wx:key="id" class="teamMember">
              <image src="/assets/sdv-v1/hud-cat.png" mode="aspectFit" />
              <view>
                <text class="rosterName">{{item.nickname}}</text>
                <text class="rosterState">{{item.status==='joining'?'定位中':item.status==='left'?'已退出':item.presence==='online'?'在线':'重连中'}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="squad miceGroup">
          <view class="squadHead"><image src="/assets/sdv-v1/hud-mouse.png" mode="aspectFit" /><text>鼠队 {{mice.length}}人</text></view>
          <view class="teamGrid mouseGrid">
            <view wx:for="{{mice}}" wx:key="id" class="teamMember">
              <image src="/assets/sdv-v1/hud-mouse.png" mode="aspectFit" />
              <view>
                <text class="rosterName">{{item.nickname}}</text>
                <text class="rosterState {{item.status==='captured'?'caught':''}}">{{item.status==='joining'?'定位中':item.status==='captured'?'已核验':item.status==='left'?'已退出':item.presence==='online'?'在线':'重连中'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{drawerTab==='events'}}" class="eventGroup">
        <text wx:if="{{!events.length}}" class="bodyCopy">暂无动态</text>
        <view wx:for="{{events}}" wx:for-item="event" wx:key="seq" class="eventRow">
          <text class="eventTime">{{event.timeText}}</text>
          <text>{{event.kind==='JOIN'?'新成员补入':event.kind==='JOIN_READY'?'补入定位完成':event.kind==='JOIN_EXPIRED'?'入场定位超时':event.kind==='LEAVE'?'成员退出':event.kind==='CAPTURE'?'现场核验 +1':event.kind==='RESULT'?'场次汇总':event.kind==='PAUSE'?'活动暂停':event.kind==='RESUME'?'活动恢复':event.kind==='CHASING'?'开始行动':'开始准备'}}</text>
        </view>
      </view>

      <view wx:if="{{drawerTab==='rules'}}" class="rulesGroup">
        <view class="sdvPaperCard rulesBox">
          <view class="ruleItem"><pixel-glyph kind="pin" size="14" color="#2c6122" /><text class="bodyCopy">{{venueName}}</text></view>
          <view class="ruleItem"><pixel-glyph kind="clock" size="14" color="#a64d0b" /><text class="bodyCopy">30s准备 · 6分 · 目标{{match.target}}人</text></view>
          <view class="ruleItem"><pixel-glyph kind="eye" size="14" color="#2c6122" /><text class="bodyCopy">鼠队视野：{{mouseTeamVision?'120m共享':'独立预警'}}</text></view>
          <view wx:if="{{match.trackVersion==='tracks-v1'}}" class="ruleItem"><pixel-glyph kind="route" size="14" color="#2c6122" /><text class="bodyCopy">轨迹留存7天</text></view>
          <text wx:if="{{!devPreview}}" class="bodyCopy">{{trackingText}} {{trackingNotice}}</text>
        </view>
        <view class="drawerToolRow" wx:if="{{!devPreview && !offline && !terminal && !backgroundReady && (match.myStatus==='active' || match.myStatus==='joining')}}">
          <button class="sdvBtn sdvBtnWood sdvBtnSm" bindtap="retryBackgroundLocation">开启后台定位</button>
          <button class="sdvBtn sdvBtnPaper sdvBtnSm" bindtap="openLocationSettings">定位权限</button>
        </view>
        <view class="drawerActionStack">
          <pixel-action class="pixelControl" wx:if="{{!offline && !terminal && (match.phase==='CHASING' || match.phase==='HIDING')}}" skin="/assets/pixel-v1/button-drawer-pause.png" label="紧急暂停（安全突发）" tone="red" font-scale="{{fontScale}}" bindaction="promptEmergency" />
          <view class="drawerSubActions">
            <button wx:if="{{!offline && owner && (match.phase==='CHASING' || match.phase==='HIDING')}}" class="sdvBtn sdvBtnWood sdvBtnSm" bindtap="pause">常规暂停</button>
            <button wx:if="{{!offline && owner && match.phase==='PAUSED'}}" class="sdvBtn sdvBtnRed sdvBtnSm" bindtap="cancel">取消本场</button>
            <pixel-action class="pixelControl" skin="/assets/pixel-v1/button-drawer-leave.png" label="{{terminal?'回首页':'退出活动'}}" tone="plain" dynamic="{{terminal}}" font-scale="{{fontScale}}" bindaction="leave" />
          </view>
        </view>
        <view class="advancedRules">
          <view class="legendGrid">
            <view class="legendItem"><view class="legendSwatch swatchSelf"></view><text>本人</text></view>
            <view class="legendItem"><view class="legendSwatch swatchAlly"></view><text>队友</text></view>
            <view class="legendItem"><view class="legendSwatch swatchFlag"></view><text>集合点</text></view>
            <view class="legendItem"><view class="legendSwatch swatchCat"></view><text>共享</text></view>
          </view>
          <text class="legendFoot">当面扫码核验 · GPS辅助</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<view wx:if="{{codeOpen}}" class="codeMask" bindtap="closeCode" catchtouchmove="ignoreTouch"></view>
<view wx:if="{{codeOpen}}" class="codeSheet" role="dialog" aria-label="现场核验码">
  <view class="codeSheetHeader">
    <view class="sdvIconTitle">
      <pixel-glyph kind="code" size="18" color="#5e3616" />
      <text>现场核验码</text>
    </view>
    <view class="drawerClose">
      <button class="sheetCloseButton" bindtap="closeCode" aria-label="关闭核验码"><pixel-glyph kind="close" size="16" color="#332012" /></button>
    </view>
  </view>
  <scroll-view scroll-y class="codeSheetBody">
    <text class="codeSafety">停在安全处当面扫码</text>
    <view class="inlineQr">
      <view wx:if="{{devPreview}}" class="codePlaceholder"><image src="/assets/sdv-v1/demo-cat-mouse.png" mode="aspectFit" /><text>演示码 · 不可扫描</text></view>
      <image wx:elif="{{image && seconds>0}}" src="{{image}}" mode="aspectFit" aria-label="本场现场动态核验码" />
      <view wx:else class="codePlaceholder"><text>{{codeError?'无法生成':'更新中…'}}</text></view>
    </view>
    <text class="codeExpiry">{{devPreview?'15s 示例':seconds>0?seconds+'s 自动更新':'等待核验码'}}</text>
    <text wx:if="{{codeError}}" class="sdvError codeFailure">{{codeError}}</text>
    <text class="codeFootnote">扫码成功即登记 · GPS辅助</text>
  </scroll-view>
</view>

<sdv-modal
  visible="{{layerSheetOpen}}"
  mode="sheet"
  title="地图图层"
  items="{{layerOptions}}"
  cancelText="取消"
  fontScale="{{fontScale}}"
  bindselect="onSelectLayer"
  bindcancel="closeLayerSheet"
  bindclose="closeLayerSheet"
/>

<sdv-modal
  visible="{{confirmModal.visible}}"
  mode="dialog"
  title="{{confirmModal.title}}"
  content="{{confirmModal.content}}"
  confirmText="{{confirmModal.confirmText}}"
  confirmTone="{{confirmModal.confirmTone}}"
  cancelText="先不"
  fontScale="{{fontScale}}"
  bindconfirm="onConfirmModal"
  bindcancel="closeConfirmModal"
  bindclose="closeConfirmModal"
/>
</view>
