/* pages/map/map.wxss */
.map-container {
  width: 100%;
  height: 100vh;
  position: relative;
}

.game-map {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 顶部信息层 */
.top-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  pointer-events: none;
}

.top-layer > view {
  pointer-events: auto;
}

/* 记分板（小、左上角、可收起） */
.score-board-mini {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  background: rgba(0,0,0,0.7);
  border-radius: 10rpx;
  padding: 10rpx 15rpx;
  color: #fff;
  min-width: 120rpx;
  max-width: 280rpx;
}

.score-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 5rpx 0;
}

.score-icon {
  font-size: 28rpx;
}

.score-toggle {
  font-size: 20rpx;
  margin-left: 10rpx;
}

.score-list-mini {
  margin-top: 10rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
  padding-top: 10rpx;
}

.score-item-mini {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 0;
  gap: 8rpx;
}

.score-item-mini.offline {
  opacity: 0.6;
}

.score-rank-mini {
  font-size: 20rpx;
  color: #f1c40f;
  min-width: 30rpx;
}

.score-role-mini {
  font-size: 24rpx;
}

.score-name-mini {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100rpx;
}

.score-points-mini {
  font-weight: bold;
  color: #f1c40f;
  font-size: 22rpx;
}

.score-expand-btn {
  text-align: center;
  padding: 10rpx 0;
  margin-top: 10rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
  font-size: 22rpx;
  color: #4ECDC4;
}

/* 道具商店 */
.shop-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
}

.shop-content {
  position: relative;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 20rpx;
  width: 80%;
  max-height: 70vh;
  overflow: hidden;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.shop-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(255,255,255,0.1);
  background: rgba(0,0,0,0.3);
}

.shop-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.shop-score {
  font-size: 28rpx;
  color: #f1c40f;
  font-weight: bold;
}

.shop-close {
  font-size: 40rpx;
  color: #888;
  padding: 0 10rpx;
}

.shop-list {
  padding: 20rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.shop-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.05);
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
  gap: 15rpx;
}

.shop-item-icon {
  font-size: 40rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}

.shop-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.shop-item-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

.shop-item-desc {
  font-size: 22rpx;
  color: #888;
}

.shop-item-price {
  font-size: 26rpx;
  color: #f1c40f;
  font-weight: bold;
  background: rgba(241,196,15,0.2);
  padding: 8rpx 15rpx;
  border-radius: 20rpx;
}

.shop-item-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.shop-item-btn:active {
  opacity: 0.8;
}

.shop-item-btn.disabled {
  background: #555;
  color: #888;
}

.shop-item.disabled {
  opacity: 0.5;
}

.shop-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.role-tip {
  margin: 80rpx 30rpx 20rpx;
  background: rgba(0,0,0,0.8);
  color: #fff;
  padding: 20rpx 30rpx;
  border-radius: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.screen-tip {
  margin: 10rpx 30rpx 20rpx;
  background: rgba(255, 152, 0, 0.9);
  color: #fff;
  padding: 15rpx 25rpx;
  border-radius: 15rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
}

.close-tip {
  font-size: 40rpx;
  padding: 0 10rpx;
}

.game-info {
  margin: 0 auto;
  width: fit-content;
  background: rgba(255,255,255,0.9);
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  color: #333;
  align-items: center;
}

.history-btn {
  margin-left: 10rpx;
  font-size: 30rpx;
}

/* 弹幕区域 */
.danmaku-area {
  position: absolute;
  top: 180rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 25;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  pointer-events: none;
}

.danmaku-item {
  background: rgba(0, 0, 0, 0.8);
  color: #fff;
  padding: 15rpx 25rpx;
  border-radius: 25rpx;
  font-size: 28rpx;
  opacity: 0;
  transform: translateX(-50rpx);
  transition: all 0.3s ease;
  align-self: flex-start;
  max-width: 80%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.danmaku-item.show {
  opacity: 1;
  transform: translateX(0);
}

/* 历史记录弹窗 */
.history-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
}

.history-content {
  position: relative;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 20rpx;
  width: 85%;
  max-height: 70vh;
  overflow: hidden;
  border: 2rpx solid rgba(255,255,255,0.1);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(255,255,255,0.1);
  background: rgba(0,0,0,0.3);
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.history-close {
  font-size: 40rpx;
  color: #888;
  padding: 0 10rpx;
}

.history-list {
  padding: 20rpx;
  max-height: 55vh;
  overflow-y: auto;
}

.history-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.history-time {
  font-size: 22rpx;
  color: #888;
  min-width: 100rpx;
}

.history-msg {
  font-size: 26rpx;
  color: #fff;
  flex: 1;
}

.history-empty {
  text-align: center;
  color: #888;
  padding: 60rpx;
  font-size: 28rpx;
}

/* 左侧按钮层 */
.left-layer {
  position: absolute;
  left: 30rpx;
  bottom: 200rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 右侧按钮层 */
.right-layer {
  position: absolute;
  right: 30rpx;
  bottom: 200rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: flex-end;
}

/* 通用按钮样式 */
.action-btn {
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.2);
}

/* 扫码按钮（猫） */
.scan-btn {
  background: #667eea;
}

/* 二维码按钮（鼠） */
.qrcode-btn {
  background: #f0932b;
}

/* 道具按钮 */
.item-btn {
  background: #fff;
  color: #333;
}

/* 结束按钮 */
.end-btn {
  background: #ff4757;
}

/* 缩放控制 */
.zoom-controls {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-top: 30rpx;
}

.zoom-btn,
.locate-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.locate-btn {
  font-size: 36rpx;
}

.zoom-btn:active,
.locate-btn:active {
  background: #f0f0f0;
  transform: scale(0.95);
}

/* 视野范围提示条 */
.vision-hint-bar {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  background: rgba(0, 0, 0, 0.8);
  color: #4ECDC4;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
  border: 2rpx solid #4ECDC4;
  box-shadow: 0 0 20rpx rgba(78, 205, 196, 0.5);
}

.vision-hint-bar.eagle-eye-active {
  background: rgba(255, 215, 0, 0.9);
  color: #333;
  border: 2rpx solid #FFD700;
  box-shadow: 0 0 30rpx rgba(255, 215, 0, 0.8);
}

.vision-hint-bar.golden-shield-active {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #333;
  border: 2rpx solid #FFD700;
  box-shadow: 0 0 30rpx rgba(255, 215, 0, 0.8);
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% { transform: translateX(-50%) scale(1); }
  50% { transform: translateX(-50%) scale(1.05); }
}

/* 轰炸选择遮罩 */
.bombard-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 0, 0, 0.15);
  z-index: 20;
  pointer-events: none;
}

.bombard-overlay-content {
  position: absolute;
  top: 150rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.85);
  border-radius: 20rpx;
  padding: 30rpx 50rpx;
  text-align: center;
  border: 2rpx solid #FF4444;
  pointer-events: auto;
}

.bombard-title {
  font-size: 36rpx;
  color: #FF4444;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.bombard-desc {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.bombard-info {
  font-size: 24rpx;
  color: #aaa;
}

.bombard-cancel {
  position: absolute;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.95);
  color: #333;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: bold;
  pointer-events: auto;
}

/* 轰炸确认按钮栏 */
.bombard-confirm-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.85);
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  z-index: 25;
}

.bombard-confirm-hint {
  text-align: center;
  color: #fff;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.bombard-confirm-btns {
  display: flex;
  gap: 20rpx;
}

.bombard-reselect-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.bombard-confirm-btn {
  flex: 1.5;
  background: rgba(255, 68, 68, 0.9);
  color: #fff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
}

/* 轰炸倒计时 */
.bombard-timers {
  position: absolute;
  top: 120rpx;
  right: 20rpx;
  z-index: 15;
}

.bombard-timer-item {
  background: rgba(0, 0, 0, 0.8);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 10rpx;
  border: 2rpx solid #FFCC00;
}

.bombard-timer-content {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.bombard-timer-icon {
  font-size: 32rpx;
}

.bombard-timer-sec {
  color: #FFD700;
  font-size: 32rpx;
  font-weight: bold;
}

.bombard-timer-sec.urgent {
  color: #FF0000;
  -webkit-animation: blink 0.3s infinite;
  animation: blink 0.3s infinite;
}

@-webkit-keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* 引爆动画 */
.bombard-explosion {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  pointer-events: none;
}

.bombard-explosion.show {
  animation: explosionIn 2s ease-out forwards;
}

@keyframes explosionIn {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.5);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.2);
  }
  40% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(1.5);
  }
}

.explosion-circle {
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FF4444 0%, #FF8800 50%, transparent 70%);
  animation: pulseRing 0.5s ease-out infinite;
}

@keyframes pulseRing {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

.explosion-text {
  margin-top: 30rpx;
  font-size: 48rpx;
  color: #FF4444;
  font-weight: bold;
  text-shadow: 0 0 20rpx rgba(255, 68, 68, 0.8);
}
