@import "../../utils/pixel-theme.wxss";

.mapPage{
  position:relative;
  box-sizing:border-box;
  width:var(--vw,100vw);
  height:var(--vh,100vh);
  padding-top:var(--nav-height,64px);
  color:#332012;
  --font-scale:1;
  overflow:hidden;
}

.playPage{display:block}

.emptyState{
  margin:28px 18px 0;
  padding:24px 18px;
  text-align:center;
  display:flex;
  flex-direction:column;
  gap:12px;
}

.emptyTitle{
  display:block;
  font-size:calc(18px * var(--font-scale));
  color:#332012;
}

.terminalScroll{
  height:calc(var(--vh) - var(--nav-height));
  padding-bottom:0;
}

.terminalWrap{
  min-height:100%;
  padding:10px 14px 0;
  display:flex;
  flex-direction:column;
  gap:9px;
  box-sizing:border-box;
}

.terminalWrap .sdvMeadowFooter{
  margin-top:auto;
}

.summaryHeroCard{
  overflow:hidden;
  padding:0;
}

.resultHero,
.state-catWin .resultHero,
.state-mouseWin .resultHero,
.state-cancelled .resultHero{
  display:block;
  width:100%;
  aspect-ratio:750 / 278!important;
  height:auto!important;
  image-rendering:pixelated;
}

.summaryPlank{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:7px 12px;
  border:0;
  border-top:2px solid #4f2710;
  border-radius:0;
}

.summaryPlankTitle{
  font-size:calc(17px * var(--font-scale));
  color:#24451c;
}

.resultStats{
  padding:10px 12px;
  display:flex;
  flex-direction:column;
  gap:9px;
}

.resultVictoryBanner{
  display:flex;
  align-items:center;
  gap:10px;
  padding:8px 10px;
  border:2px solid #7b3c14;
  border-radius:0;
  background:#fff2d4;
  box-shadow:inset 0 2px 0 #fff9e8,0 2px 0 #cfa96c;
}

.victory-catWin{
  background:#ffecc2;
  border-color:#a64d0b;
  box-shadow:inset 0 2px 0 #fff7e0,0 2px 0 #d9a75f;
}

.victory-mouseWin{
  background:#d4ebba;
  border-color:#35692a;
  box-shadow:inset 0 2px 0 #ecf7df,0 2px 0 #9bc97b;
}

.victory-cancelled{
  background:#f5dcab;
  border-color:#7b3c14;
  box-shadow:inset 0 2px 0 #fff0cf,0 2px 0 #cfa96c;
}

.victoryMascot{
  width:34px;
  height:34px;
  flex:none;
  image-rendering:pixelated;
}

.victoryCopy{
  flex:1;
  min-width:0;
}

.victoryTitle{
  display:block;
  font-size:calc(16px * var(--font-scale));
  line-height:1.25;
  color:#2c6122;
}

.victory-catWin .victoryTitle{
  color:#a64d0b;
}

.victory-cancelled .victoryTitle{
  color:#5e3616;
}

.resultReason{
  display:block;
  margin-top:2px;
  text-align:left;
  font-size:calc(12px * var(--font-scale));
  line-height:1.35;
  color:#5e4c3c;
}

.victoryMedal{
  flex:none;
  display:inline-flex;
  align-items:center;
  gap:3px;
  padding:4px 8px;
  background:#ffdba3;
  border:2px solid #a64d0b;
  border-radius:0;
  box-shadow:inset 0 1px 0 #fff0d1;
  font-size:calc(12px * var(--font-scale));
  color:#7a3303;
  line-height:1.2;
}

.resultGrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

.resultMetric{
  padding:10px 8px;
  background:#d4ebba;
  border:2px solid #35692a;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ecf7df,inset 0 -2px 0 #9bc97b,0 2px 0 #cfa96c;
  text-align:center;
  display:flex;
  flex-direction:column;
  justify-content:center;
  gap:4px;
}

.resultMetricSky{
  background:#f5dcab;
  border-color:#7b3c14;
  box-shadow:inset 0 2px 0 #fff0cf,inset 0 -2px 0 #d9b678,0 2px 0 #cfa96c;
}

.statIconHead{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:4px;
}

.statLabel{
  display:block;
  font-size:calc(12px * var(--font-scale));
  color:#5e4c3c;
}

.statValue{
  display:inline-flex;
  align-items:baseline;
  justify-content:center;
  gap:3px;
  font-size:calc(26px * var(--font-scale));
  line-height:1.2;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}

.statDenom{
  font-size:calc(16px * var(--font-scale));
  color:#5e4c3c;
}

.statVenue{
  display:block;
  font-size:calc(14px * var(--font-scale));
  line-height:1.35;
  color:#3b1d0b;
  overflow-wrap:anywhere;
}

.resultMapCard,.trackResultCard{
  padding:6px 8px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.resultMap{
  height:180px;
  overflow:hidden;
  border:2px solid #3b1c0a;
  border-radius:0;
}

.trackResultActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.resultActions{
  display:flex;
  flex-direction:column;
  gap:14px;
}

.resultSubActions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.waitingHost{
  text-align:center;
  display:block;
  padding:10px;
  font-size:calc(14px * var(--font-scale));
  color:#5e4c3c;
}

.recordNote{
  text-align:center;
  display:block;
  font-size:12px;
  line-height:1.4;
  color:#5e4c3c;
}

.mapCanvas{
  position:absolute;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:#dce8df;
  overflow:hidden;
  z-index:0;
}

campus-model{display:block;width:100%;height:100%}
.mapCanvas venue-art,.gameMap{display:block;width:100%;height:100%}

.playHud{
  position:absolute;
  z-index:3;
  top:calc(var(--nav-height) + 8px);
  left:10px;
  right:10px;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:6px;
  padding:0;
  background:transparent;
  border:0;
  border-radius:0;
  box-shadow:none;
  pointer-events:none;
}

.hudPlaque{
  display:inline-flex;
  align-items:center;
  gap:6px;
  min-height:46px;
  padding:2px 6px;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  filter:drop-shadow(0 3px 0 rgba(27,16,8,.4));
  box-sizing:border-box;
  pointer-events:auto;
}

.navRolePlaque{
  min-height:36px;
  height:36px;
  padding:0 6px 0 4px;
  gap:5px;
  max-width:100%;
}

.navRolePlaque .hudAvatar{
  width:22px;
  height:22px;
}

.navRolePlaque .roleName,
.navRolePlaque .phaseName{
  font-size:calc(13px * var(--font-scale));
  line-height:1.2;
}

.navRolePlaque .phaseName{
  overflow:hidden;
  text-overflow:ellipsis;
}

.navRoleDot{
  width:3px;
  height:3px;
  background:#7c522b;
  flex:none;
}

.navPreviewTag{
  flex:none;
  padding:1px 5px;
  background:#ffdba3;
  border:2px solid #a64d0b;
  border-radius:0;
  font-size:10px;
  color:#7a3303;
  line-height:1.2;
}

.hudMainBar{
  display:flex;
  width:100%;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  min-height:44px;
  padding:2px 8px;
}

.hudMainMetrics{
  display:inline-flex;
  align-items:center;
  gap:8px;
  min-width:0;
  flex:1 1 auto;
}

.hudAvatar{display:block;width:28px;height:28px;flex:none;image-rendering:pixelated}

.roleName,.phaseName{white-space:nowrap}
.role-cat .roleName{color:#c95810}
.role-mouse .roleName{color:#2c6122}
.phaseName{color:#2c6122}

.compactClock{
  flex:none;
  display:inline-block;
  min-width:58px;
  text-align:center;
  white-space:nowrap;
  font-size:20px;
  line-height:1.15;
  font-variant-numeric:tabular-nums;
  color:#332012;
}

.compactClock.clock-warn{
  color:#a64d0b;
  background:#ffdba3;
  padding:1px 5px;
  border:2px solid #a64d0b;
}

.compactClock.clock-urgent{
  color:#fffdf6;
  background:#d1503a;
  padding:1px 5px;
  border:2px solid #731d0f;
}

.compactProgress{
  flex:none;
  white-space:nowrap;
  border-left:2px solid #c99b5b;
  padding-left:6px;
  font-size:17px;
  font-variant-numeric:tabular-nums;
}

.hudGuideInline{
  flex:1 1 auto;
  min-width:0;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:3px;
  padding:2px 6px;
  background:rgba(242,207,148,.65);
  border:1.5px solid #b58447;
  font-size:11px;
  line-height:1.25;
  color:#3b1d0b;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.hudGuideText{
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-variant-numeric:tabular-nums;
}

.fgLocationBanner{
  pointer-events:auto;
  display:flex;
  align-items:center;
  gap:6px;
  width:100%;
  box-sizing:border-box;
  padding:4px 8px;
  background:#ffdba3;
  border:2px solid #a64d0b;
  box-shadow:inset 0 1px 0 #fff0d1,0 2px 0 rgba(27,16,8,.3);
  color:#7a3303;
  font-size:11px;
  line-height:1.3;
}

.fgLocationText{
  flex:1;
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.fgLocationBtn,.fgLocationClose{
  flex:none;
  width:auto!important;
  margin:0!important;
  min-height:22px;
  line-height:1.2;
}

.fgLocationBtn{
  padding:2px 7px!important;
  background:#4a943b;
  border:1.5px solid #2c6122;
  color:#fffdf6;
  font-size:11px;
}

.fgLocationClose{
  padding:2px 6px!important;
  background:#fbe3b0;
  border:1.5px solid #a64d0b;
  color:#7a3303;
  font-size:13px;
}

.fgLocationBtn::after,.fgLocationClose::after{border:0}

.progressTag{
  font-size:calc(11px * var(--action-scale,1));
  color:#6b4e35;
  margin-right:3px;
}

.progressSep{
  color:#6b4e35;
}

.mapLocationSignal{
  flex:none;
  pointer-events:auto;
  --signal-bg:#f2cf94;
  --signal-border:2px solid #7b3c14;
  --signal-border-image:none;
  --signal-pad:2px 7px;
  --signal-min-h:28px;
  --signal-shadow:inset 0 1px 0 #ffe9bf;
  --signal-filter:none;
  --signal-color:#3b1d0b;
}

.venueNavChip{
  pointer-events:auto;
  display:inline-flex;
  align-items:center;
  gap:4px;
  padding:3px 8px;
  background:rgba(251,227,176,.92);
  border:2px solid #5e3616;
  border-radius:0;
  box-shadow:inset 0 1px 0 #fff3d6,0 2px 0 rgba(27,16,8,.34);
  color:#3b1d0b;
  font-size:11px;
  line-height:1.25;
  white-space:nowrap;
}

.mapGestureHint{
  padding:4px 8px;
  background:#fae3b2;
  border:2px solid #4f2710;
  border-radius:0;
  color:#3b1d0b;
  font-size:10px;
  line-height:1.25;
  box-shadow:0 2px 0 #79a857;
}

.mapTools{
  position:absolute;
  z-index:4;
  right:10px;
  bottom:calc(92px + max(var(--safe-bottom),env(safe-area-inset-bottom)));
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:12px;
  pointer-events:none;
}

.edgeButton{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:2px;
  box-sizing:border-box;
  width:46px!important;
  min-height:46px;
  height:46px;
  margin:0!important;
  padding:0!important;
  border:6px solid transparent;
  border-radius:0;
  background:transparent;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:6px;
  border-image-repeat:round;
  image-rendering:pixelated;
  filter:drop-shadow(0 3px 0 rgba(27,16,8,.38));
  color:#3b1d0b;
  pointer-events:auto;
}

.edgeButton::after,.dockBtn::after,.sheetCloseButton::after{border:0}
.edgeButton:active,.dockBtn:active,.sheetCloseButton:active{transform:translateY(2px);opacity:.9}
.edgeButton[disabled]{opacity:.45}

.toolLabel{
  display:block;
  font-size:10px;
  line-height:1.1;
  color:#332012;
  white-space:nowrap;
}

.edgeButton.vibeActive{
  border-image-source:url("data:image/png;base64,");
}

.edgeButton.vibeMuted{
  opacity:.78;
}

.vibeActive .toolLabel{
  color:#2c6122;
}

.vibeMuted .toolLabel{
  color:#7c522b;
}

.mapStatusRegion{
  position:absolute;
  z-index:3;
  left:10px;
  right:66px;
  bottom:calc(78px + max(var(--safe-bottom),env(safe-area-inset-bottom)));
  pointer-events:none;
}

.mapStatus{
  pointer-events:auto;
  padding:9px 12px;
  background:#fae3b2;
  border:2px solid #3b1c0a;
  border-left:5px solid #4a943b;
  border-radius:0;
  box-shadow:inset 0 2px 0 #fff2cf,0 2px 0 #79a857;
  color:#3b1d0b;
  font-size:calc(12px * var(--font-scale));
  line-height:1.45;
}

.mapStatus>text{display:block}
.statusTitle{display:block;font-size:calc(15px * var(--font-scale));line-height:1.3;margin-bottom:3px}
.statusReconnect{border-left-color:#d1503a}
.proximityWarning{background:#ffdba3;border-color:#a64d0b;border-left-color:#e87f24;color:#7a3303}

.compactButton{
  width:auto!important;
  max-width:100%;
  white-space:normal;
  display:inline-block;
  margin:6px 0 0;
  padding:7px 14px;
  min-height:40px;
  font-size:calc(13px * var(--font-scale));
  line-height:1.4;
  background:#4a943b;
  color:#fffdf6;
  border:2px solid #3b1c0a;
  border-radius:0;
  box-shadow:inset 0 2px 0 #82cf6f,inset 0 -2px 0 #2c6122,0 2px 0 #cfa96c;
}

.compactButton::after{border:0}

.captureRetryBar{
  position:absolute;
  z-index:35;
  left:12px;
  right:12px;
  bottom:calc(86px + max(var(--safe-bottom),env(safe-area-inset-bottom)));
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
  padding:10px 12px;
  background:#fbe3b0;
  border:3px solid #3b1c0a;
  border-radius:0;
  font-size:calc(14px * var(--font-scale,1));
}

.mapBottomDock{
  position:absolute;
  z-index:4;
  left:12px;
  right:12px;
  bottom:calc(12px + max(var(--safe-bottom),env(safe-area-inset-bottom)));
  display:flex;
  align-items:stretch;
  justify-content:center;
  gap:14px;
  padding:0;
  background:transparent;
  border:0;
  border-radius:0;
  box-shadow:none;
  pointer-events:none;
  box-sizing:border-box;
}

.dockBtn{
  position:relative;
  overflow:visible;
  pointer-events:auto;
  margin:0!important;
  padding:4px 8px!important;
  min-height:50px;
  border-width:8px;
  border-style:solid;
  border-color:transparent;
  border-image-width:8px;
  border-radius:0;
  box-shadow:none;
  filter:drop-shadow(0 3px 0 rgba(27,16,8,.42));
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
  font-size:calc(15px * var(--font-scale));
  line-height:1.25;
  white-space:nowrap;
  box-sizing:border-box;
}

.dockPrimary{flex:1.85;min-width:0}
.dockSecondary{flex:1;min-width:0}
.dockBtn[disabled]{opacity:.52}

.dockBadge{
  position:absolute;
  z-index:4;
  top:-6px;
  right:-5px;
  pointer-events:none;
  min-width:18px;
  height:18px;
  padding:0 4px;
  box-sizing:border-box;
  background:#d1503a;
  border:2px solid #3b1c0a;
  border-radius:0;
  color:#fffdf6;
  font-size:10px;
  line-height:14px;
  text-align:center;
}

.mapError{
  position:absolute;
  z-index:5;
  top:calc(var(--nav-height) + 98px);
  left:10px;
  right:10px;
  margin:0;
}

.mapError.errorDismissible{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.nightToggleBtn{
  margin-top:10px;
}

.drawerMask{
  position:absolute;
  inset:0;
  background:rgba(28,44,24,.52);
  z-index:20;
  animation:maskEnter 180ms ease-out both;
}

.drawer{
  position:absolute;
  bottom:0;
  left:0;
  width:var(--vw,100vw);
  height:min(68%,calc(var(--vh) - var(--nav-height) - 10px));
  background:#fbe3b0;
  border-top:3px solid #3b1c0a;
  border-radius:0;
  z-index:21;
  overflow:hidden;
  animation:sheetEnter 240ms cubic-bezier(.2,.8,.2,1) both;
}

.drawer.sheetLeaving{animation:sheetExit 180ms ease-in both}
.drawerMask.sheetLeaving{animation:maskExit 180ms ease-in both}

.sheetGrip{padding:2px 0 4px;min-height:22px;background:#f2cf94}
.drawerHandle{width:42px;height:4px;margin:8px auto 2px;border-radius:0;background:#7b3c14}

.drawerHeader{
  display:flex;
  align-items:center;
  gap:12px;
  padding:4px 14px 10px;
  background:#f2cf94;
  border-bottom:2px solid #7b3c14;
  box-shadow:inset 0 2px 0 #ffe9bf;
  font-size:calc(20px * var(--font-scale));
  color:#3b1d0b;
}

.drawerHeaderTitle{flex:1;min-width:0}
.drawerLogo{width:28px;height:30px;flex:none;image-rendering:pixelated}
.drawerClose{width:38px;flex:none}

.sheetCloseButton{
  display:flex;
  align-items:center;
  justify-content:center;
  width:36px!important;
  height:36px;
  min-height:36px;
  padding:0!important;
  margin:0!important;
  background:transparent;
  border:6px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:6px;
  border-image-repeat:round;
  image-rendering:pixelated;
}

.drawerTabs{
  display:flex;
  background:#eed094;
  border-bottom:2px solid #7d481e;
  height:46px;
}

.drawerTabs>button{
  flex:1;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:5px;
  width:auto;
  margin:0;
  padding:8px 4px;
  background:transparent;
  font-size:calc(14px * var(--font-scale));
  line-height:1.4;
  color:#5e3616;
  border-radius:0;
}

.drawerTabs>button::after{border:0}

.drawerTabs>.selected{
  background:#fbe3b0;
  color:#3b1d0b;
  border-bottom:3px solid #4a943b;
}

.drawerBody{height:calc(100% - 122px)}
.drawerContent{padding:12px 14px max(24px,var(--safe-bottom),env(safe-area-inset-bottom))}

.squadColumns{display:grid;grid-template-columns:.9fr 1.2fr;gap:8px}

.squad{
  background:#fff2d4;
  border:2px solid #7d481e;
  border-radius:0;
  overflow:hidden;
}

.squadHead{
  display:flex;
  align-items:center;
  gap:6px;
  background:#f2cf94;
  border-bottom:2px solid #b5652a;
  padding:6px 8px;
  font-size:calc(14px * var(--font-scale));
  color:#3b1d0b;
}

.miceGroup .squadHead{background:#d4ebba;border-bottom-color:#4a943b}
.squadHead image{width:26px;height:26px;flex:none;image-rendering:pixelated}
.teamGrid{padding:6px}
.mouseGrid{display:grid;grid-template-columns:1fr 1fr;gap:4px}

.teamMember{display:flex;gap:5px;align-items:center;padding:5px 0;min-width:0}
.teamMember image{width:30px;height:34px;flex:none;image-rendering:pixelated}
.teamMember>view{min-width:0;flex:1}
.rosterName{display:block;font-size:calc(12px * var(--font-scale));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#332012}
.rosterState{display:block;font-size:10px;line-height:1.4;color:#2c6122}
.rosterState.caught{color:#5e4c3c}

.eventGroup,.rulesGroup{margin:4px 0}
.sectionHeading{display:flex;align-items:center;gap:8px;font-size:calc(16px * var(--font-scale));margin-bottom:8px;color:#332012}
.sectionHeading image{width:22px;height:22px;flex:none;image-rendering:pixelated}
.eventRow{display:flex;gap:12px;margin:6px 0;padding-left:12px;border-left:3px solid #e87f24;font-size:calc(13px * var(--font-scale));line-height:1.5;color:#332012}
.eventTime{color:#5e4c3c;flex:none;font-variant-numeric:tabular-nums}

.rulesBox{
  padding:10px 12px;
  display:flex;
  flex-direction:column;
  gap:7px;
}

.ruleItem{
  display:flex;
  align-items:center;
  gap:7px;
}

.bodyCopy{
  display:block;
  font-size:calc(13px * var(--font-scale));
  line-height:1.45;
  color:#332012;
}

.drawerToolRow{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin-top:12px;
}

.drawerActionStack{
  display:flex;
  flex-direction:column;
  gap:14px;
  margin-top:12px;
}

.drawerSubActions{
  display:flex;
  align-items:stretch;
  gap:12px;
}

.drawerSubActions>button{
  flex:1 1 0;
  width:auto!important;
  min-width:0;
}

.drawerSubActions .pixelControl{
  flex:1 1 0;
  min-width:0;
}

.drawerSubActions .nativeAction{
  font-size:calc(15px * var(--action-scale,1));
  padding:8px 10px;
  min-height:40px;
  white-space:normal;
}

.advancedRules{
  border-top:2px dashed #bdd4ac;
  margin-top:14px;
  padding-top:10px;
  display:flex;
  flex-direction:column;
  gap:6px;
}

.legendGrid{
  display:flex;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:8px;
}

.legendItem{
  display:inline-flex;
  align-items:center;
  gap:5px;
  font-size:12px;
  color:#3b1d0b;
}

.legendSwatch{
  width:10px;
  height:10px;
  border:1.5px solid #3b1c0a;
  flex:none;
}

.swatchSelf{background:#2274c4}
.swatchAlly{background:#3f8f34}
.swatchFlag{background:#f09c1a}
.swatchCat{background:#d92626}

.legendFoot{
  font-size:12px;
  color:#5e4c3c;
}

.codeMask{
  position:absolute;
  inset:0;
  z-index:22;
  background:rgba(28,44,24,.52);
  animation:maskEnter 180ms ease-out both;
}

.codeSheet{
  position:absolute;
  z-index:23;
  left:10px;
  right:10px;
  bottom:0;
  max-height:calc(var(--vh) - var(--nav-height) - 16px);
  background:#fbe3b0;
  border:3px solid #3b1c0a;
  border-bottom:0;
  border-radius:0;
  box-shadow:inset 0 0 0 3px #e8a254;
  padding:0 0 max(16px,var(--safe-bottom));
  animation:sheetEnter 240ms cubic-bezier(.2,.8,.2,1) both;
  overflow:hidden;
}

.codeSheetHeader{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  padding:12px 14px;
  background:#f2cf94;
  border-bottom:3px solid #3b1c0a;
  box-shadow:inset 0 2px 0 #ffe9bf,inset 0 -3px 0 #4d9a3b,inset 0 -5px 0 #82cf6f;
  font-size:calc(19px * var(--font-scale));
  color:#3b1d0b;
}

.codeSheetBody{
  padding:10px 14px 4px;
  max-height:calc(var(--vh) - var(--nav-height) - var(--safe-bottom) - 96px);
  text-align:center;
  box-sizing:border-box;
}

.codeSafety,.codeExpiry,.codeFootnote,.codeFailure{
  display:block;
  margin:8px 0;
  font-size:calc(14px * var(--font-scale));
  line-height:1.5;
}

.codeFootnote{font-size:calc(12px * var(--font-scale));color:#5e4c3c}
.codeFailure{text-align:left}

.inlineQr{
  width:min(calc(var(--vw) * .62),248px);
  height:min(calc(var(--vw) * .62),248px);
  margin:10px auto;
  background:#ffffff;
  padding:10px;
  border:3px solid #3b1c0a;
  border-radius:0;
}

.inlineQr>image{display:block;width:100%;height:100%}
.codePlaceholder{display:flex;align-items:center;justify-content:center;flex-direction:column;height:100%;font-size:14px;color:#5e4c3c;gap:8px}
.codePlaceholder image{width:70%;height:70%;flex:none}

@keyframes sheetEnter{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes sheetExit{from{transform:translateY(0)}to{transform:translateY(100%)}}
@keyframes maskEnter{from{opacity:0}to{opacity:1}}
@keyframes maskExit{from{opacity:1}to{opacity:0}}

@media(prefers-reduced-motion:reduce){
  .drawer,.drawerMask,.codeSheet,.codeMask{animation-duration:1ms}
}

.fontLarge .squadColumns,.fontLarge .mouseGrid,.fontLarge .resultGrid,.fontLarge .trackResultActions,.fontLarge .resultSubActions,.fontLarge .drawerToolRow{grid-template-columns:1fr}
.narrowCanvas .playHud{left:6px;right:6px;gap:4px}
.narrowCanvas .hudMainBar{padding:2px 5px;gap:4px}
.narrowCanvas .navRolePlaque{padding:0 4px;gap:3px}
.narrowCanvas .compactClock{font-size:17px;min-width:50px}
.narrowCanvas .compactProgress{font-size:15px;padding-left:4px}
.narrowCanvas .hudGuideInline{display:none}
.narrowCanvas .dockBtn{font-size:calc(13px * var(--font-scale));padding:6px 4px!important}
