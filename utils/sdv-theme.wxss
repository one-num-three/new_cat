/* 全站统一星露谷（方案 A：鹈鹕镇像素春草地 × 暖蜂蜜羊皮纸 × 晴空蓝）16-bit 九宫格木框设计基线 */
@import "./sdv-borders.wxss";

page{
  --sdv-bg:#a8d481;
  --sdv-sky:#7bc4ec;
  --sdv-sky-soft:#cdebfb;
  --sdv-sky-deep:#1e5880;
  --sdv-meadow:#d4ebba;
  --sdv-meadow-border:#35692a;
  --sdv-paper:#fbe3b0;
  --sdv-paper-warm:#f5dcab;
  --sdv-paper-inset:#fff3d6;
  --sdv-wood-dark:#4f2710;
  --sdv-wood-mid:#b5652a;
  --sdv-wood-light:#e8a254;
  --sdv-wood-deep:#7b3c14;
  --sdv-wood-header:#f2cf94;
  --sdv-ink:#3b1d0b;
  --sdv-ink-muted:#5e3616;
  --sdv-ink-soft:#7c522b;
  --sdv-green:#4a943b;
  --sdv-green-deep:#2c6122;
  --sdv-green-soft:#d4ebba;
  --sdv-amber:#e87f24;
  --sdv-amber-deep:#a64d0b;
  --sdv-amber-soft:#ffdba3;
  --sdv-blue:#3588bd;
  --sdv-blue-deep:#1e5880;
  --sdv-blue-soft:#cdebfb;
  --sdv-red:#d1503a;
  --sdv-red-deep:#8c2c1b;
  --sdv-red-soft:#f8d4c8;
}

page,.sdvScreen{
  background-color:#a8d481;
  background-image:url("data:image/png;base64,");
  background-repeat:repeat;
  background-size:64px 64px;
  image-rendering:pixelated;
  color:#3b1d0b;
}

.sdvScreen{
  position:relative;
  width:var(--vw,100vw);
  min-height:var(--vh,100vh);
  box-sizing:border-box;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;
  font-weight:400;
  overflow-x:hidden;
}

/* 经典星露谷 16-bit 蜂蜜橡木九宫格木框 × 暖蜂蜜羊皮纸 #fbe3b0 */
.sdvWoodCard{
  position:relative;
  box-sizing:border-box;
  background:transparent;
  border:12px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:24 fill;
  border-image-width:12px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
}

/* 暖麦纸卡 #f5dcab */
.sdvPaperCard{
  position:relative;
  box-sizing:border-box;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
}

/* 嫩春草九宫格标牌（主标牌 #d4ebba） */
.sdvPlank{
  box-sizing:border-box;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#24451c;
}

.sdvPlankSky{
  box-sizing:border-box;
  background:transparent;
  border:12px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:24 fill;
  border-image-width:12px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
}

.sdvPlankWood{
  box-sizing:border-box;
  background:transparent;
  border:12px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:24 fill;
  border-image-width:12px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
}

.sdvSectionTitle{
  display:flex;
  align-items:center;
  gap:10rpx;
  font-size:calc(30rpx * var(--font-scale,1));
  line-height:1.35;
  color:#3b1d0b;
}

.sdvSectionTitle::before{
  content:"";
  display:block;
  width:8rpx;
  height:28rpx;
  flex:none;
  background:#4a943b;
  border:2px solid #2b5a22;
  border-radius:0;
}

/* 统一 16-bit 四钉阶梯角木牌/按键 */
.sdvBtn{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8rpx;
  box-sizing:border-box;
  width:100%!important;
  min-height:44px;
  margin:0;
  padding:6px 10px;
  border:8px solid transparent;
  border-radius:0;
  background:transparent;
  color:#3b1d0b;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
  font-size:calc(17px * var(--font-scale,1));
  font-weight:400;
  line-height:1.3;
  white-space:normal;
  text-align:center;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
}

.sdvBtn::after{border:0}
.sdvBtn:active{transform:translateY(2px);opacity:.92}
.sdvBtn[disabled]{opacity:.68;filter:saturate(.55)}

.sdvBtnGreen,
.sdvBtnAmber,
.sdvBtnBlue,
.sdvBtnRed,
.sdvBtnWood,
.sdvBtnPaper{
  background:transparent;
  border-style:solid;
  border-color:transparent;
  border-image-slice:16 fill;
  border-image-repeat:round;
  image-rendering:pixelated;
  box-shadow:none;
}

.sdvBtnGreen{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvBtnAmber{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvBtnBlue{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvBtnRed{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvBtnWood{
  color:#3b1d0b;
  border-image-source:url("data:image/png;base64,");
}

.sdvBtnPaper{
  color:#3b1d0b;
  border-image-source:url("data:image/png;base64,");
}

.sdvBtnSm{
  min-height:38px;
  padding:4px 8px;
  border-width:6px;
  border-image-width:6px;
  font-size:calc(14px * var(--font-scale,1));
}

.sdvBtnInline{
  width:auto!important;
  flex:none;
}

/* 暖麦橡木硬边分段选择槽 */
.sdvPillGroup{
  display:flex;
  gap:8rpx;
  padding:6rpx;
  background:#e8cb92;
  border:2px solid #7d481e;
  border-radius:0;
  box-shadow:inset 0 2px 0 #d4b172,inset 0 -2px 0 #f7e2b5;
  box-sizing:border-box;
}

.sdvPill{
  flex:1 1 0;
  min-width:0;
  width:auto!important;
  min-height:42px;
  margin:0!important;
  padding:8px 10px;
  border:2px solid transparent;
  border-radius:0;
  background:transparent;
  color:#5e3616;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
  font-size:calc(15px * var(--font-scale,1));
  line-height:1.3;
  white-space:normal;
  display:flex;
  align-items:center;
  justify-content:center;
}

.sdvPill::after{border:0}

.sdvPillActive{
  background:#4a943b;
  color:#fffdf6;
  border-color:#2c6122;
  box-shadow:inset 0 2px 0 #82cf6f,inset 0 -2px 0 #2c6122;
}

/* 凹陷像素暖羊皮纸输入框 #fff3d6 */
.sdvInput{
  display:block;
  width:100%;
  min-width:0;
  min-height:44px;
  box-sizing:border-box;
  padding:6px 8px;
  background:transparent;
  border:6px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:12 fill;
  border-image-width:6px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
  font-size:calc(17px * var(--font-scale,1));
  line-height:1.35;
}

/* 底部固定蜂蜜木桌草沿操作栏 */
.sdvStickyBar{
  position:fixed;
  left:0;
  right:auto;
  bottom:0;
  width:var(--vw,100vw);
  max-width:100vw;
  z-index:18;
  box-sizing:border-box;
  background:#f6dca8;
  border-top:3px solid #3b1c0a;
  box-shadow:inset 0 4px 0 #4d9a3b,inset 0 6px 0 #82cf6f,0 -2px 0 #79a857;
  padding:14px 14px calc(10px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
}

/* 像素印章徽标（暖羊皮纸硬边双像素框） */
.sdvBadge{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
  padding:3px 9px;
  border:2px solid #4f2710;
  border-radius:0;
  background:#ffecc2;
  box-shadow:inset 0 2px 0 #fff7e0,0 2px 0 #cfa96c;
  color:#3b1d0b;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.25;
  white-space:nowrap;
}

.sdvBadgeGreen{background:#d4ebba;border-color:#2c6122;color:#2c6122;box-shadow:inset 0 2px 0 #ecf7df,0 2px 0 #9bc97b}
.sdvBadgeAmber{background:#ffdba3;border-color:#a64d0b;color:#7a3303;box-shadow:inset 0 2px 0 #fff0d1,0 2px 0 #d9a75f}
.sdvBadgeBlue{background:#f2cf94;border-color:#7b3c14;color:#3b1d0b;box-shadow:inset 0 2px 0 #ffe9bf,0 2px 0 #cfa96c}
.sdvBadgeRed{background:#f8d4c8;border-color:#8c2c1b;color:#731d0f;box-shadow:inset 0 2px 0 #fceae4,0 2px 0 #d49c8e}
.sdvBadgeGray{background:#e8d8b7;border-color:#6b4d2b;color:#4f351a;box-shadow:inset 0 2px 0 #f7ebd1,0 2px 0 #c2ad84}

/* 暖麦提示条、引导卡与错误条 */
.sdvNotice{
  display:block;
  padding:9px 12px;
  background:#f2cf94;
  border:2px solid #7b3c14;
  border-radius:0;
  box-shadow:inset 0 2px 0 #ffe9bf,inset 0 -2px 0 #d4aa6a,0 2px 0 #79a857;
  color:#3b1d0b;
  font-size:calc(13px * var(--font-scale,1));
  line-height:1.5;
  overflow-wrap:anywhere;
}

.sdvGuideTip{
  display:flex;
  align-items:flex-start;
  gap:8px;
  padding:4px 6px;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#24451c;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.45;
  overflow-wrap:anywhere;
}

.sdvGuideDot{
  width:8px;
  height:8px;
  margin-top:4px;
  flex:none;
  background:#4a943b;
  border:2px solid #24451c;
  border-radius:0;
}

.sdvMeadowFooter{
  display:block;
  width:100%;
  aspect-ratio:750 / 184;
  height:auto!important;
  margin-top:4px;
  border-radius:0;
  image-rendering:pixelated;
}

.sdvPressed{
  transform:translateY(2px);
  opacity:.9;
  filter:brightness(.94);
}

.sdvError{
  display:block;
  padding:4px 6px;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#731d0f;
  font-size:calc(13px * var(--font-scale,1));
  line-height:1.5;
  overflow-wrap:anywhere;
}

.sdvIconTitle{
  display:flex;
  align-items:center;
  gap:8rpx;
  min-width:0;
  font-size:calc(28rpx * var(--font-scale,1));
  line-height:1.3;
  color:#3b1d0b;
}

.sdvIconBtn{
  flex:none;
  width:44px!important;
  min-width:44px;
  height:44px;
  min-height:44px;
  margin:0!important;
  padding:0!important;
  display:flex;
  align-items:center;
  justify-content:center;
  border-width:6px;
  border-style:solid;
  border-color:transparent;
  border-image-width:6px;
  border-radius:0;
  box-sizing:border-box;
}

.sdvIconBtn::after{border:0}
.sdvIconBtn:active{transform:translateY(2px);opacity:.92}
.sdvIconBtn[disabled]{opacity:.55}

.sdvIconBtnSm{
  width:36px!important;
  min-width:36px;
  height:36px;
  min-height:36px;
}

.sdvChipRow{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:6px;
}

.sdvInfoChip{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:3px 8px;
  background:#fff2d4;
  border:2px solid #b58447;
  border-radius:0;
  box-shadow:inset 0 1px 0 #fff9e8;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.25;
  color:#3b1d0b;
  white-space:nowrap;
}

.sdvErrorRow{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
}

.errorText{
  flex:1;
  min-width:0;
  overflow-wrap:anywhere;
}

.errorClose{
  flex:none;
  font-size:16px;
  line-height:1;
  padding:0 4px;
  color:inherit;
}

.permLinkBtn{
  margin-top:4px;
}

/* 星露谷「夜间营火」配色（纯 CSS 变量，零额外图像体积） */
.sdvNight,.sdvNight.sdvScreen,.sdvNight.screen,.sdvNight.mapPage{
  background-color:#243526;
  background-image:none;
  color:#f6e6c2;
}

.sdvNight .pinnedNav{
  background:#1f324a;
  border-bottom-color:#120a05;
  box-shadow:inset 0 2px 0 #314d6e,inset 0 -4px 0 #3f7a34,inset 0 -6px 0 #62a851,0 2px 0 #142217;
}

.sdvNight .floatingNav .navBrand{
  border-image-source:none;
  background:#34261c;
  border:2px solid #8a562d;
  padding:2px 8px;
}

.sdvNight .navTitle{color:#f7e8c6;}

.sdvNight .navBack{
  border-image-source:none;
  background:#463323;
  border:2px solid #8a562d;
  color:#f7e8c6;
}

.sdvNight .sdvWoodCard{
  border-image-source:none;
  background:#34261c;
  border:3px solid #160d07;
  box-shadow:inset 0 0 0 2px #7a4b26,inset 0 0 0 4px #4d3422;
  padding:10px;
  color:#f6e6c2;
}

.sdvNight .sdvPaperCard{
  border-image-source:none;
  background:#2d2219;
  border:2px solid #7a4b26;
  box-shadow:inset 0 2px 0 #453224;
  padding:8px;
  color:#f6e6c2;
}

.sdvNight .sdvPlank{
  border-image-source:none;
  background:#253d27;
  border:2px solid #599c4a;
  padding:6px 10px;
  color:#dff5d4;
}

.sdvNight .sdvPlankSky,.sdvNight .sdvNotice,.sdvNight .codeRow,.sdvNight .codePlate,.sdvNight .safetyNote,.sdvNight .venueDropInner,.sdvNight .venueNavChip{
  border-image-source:none;
  background:#1e3447;
  border-color:#4b8cb8;
  color:#d8eefc;
  box-shadow:inset 0 2px 0 #2d4c66;
}

.sdvNight .sdvInput{
  border-image-source:none;
  background:#211812;
  border:2px solid #8a562d;
  padding:6px 10px;
  color:#fff2d6;
  box-shadow:inset 0 2px 0 #140d09;
}

.sdvNight .sdvBtnPaper,.sdvNight .sdvBtnWood,.sdvNight .edgeButton,.sdvNight .sheetCloseButton{
  border-image-source:none;
  background:#463323;
  border:2px solid #9c6434;
  box-shadow:inset 0 2px 0 #664930,inset 0 -2px 0 #261a11;
  color:#f7e8c6;
}

.sdvNight .sdvStickyBar,.sdvNight .fieldPanel{
  background:#2a1f17;
  border-color:#140c06;
  box-shadow:inset 0 3px 0 #4a8c3c,inset 0 -2px 0 #1a120d;
}

.sdvNight .playHud{
  background:transparent;
  border:0;
  box-shadow:none;
}

.sdvNight .hudPlaque{
  border-image-source:none;
  background:#2d2219ee;
  border:2px solid #8a562d;
  padding:4px 8px;
  color:#f6e6c2;
}

.sdvNight .mapBottomDock{
  background:transparent;
  border:0;
  box-shadow:none;
}

.sdvNight .bulletinBoard{padding:0;}
.sdvNight .boardBody{background:transparent;padding:8rpx 10px 8px;}
.sdvNight .boardDivider{border-top-color:#7a4b26;}
.sdvNight .boardPost{top:-9px;background:#59371e;border-color:#160d07;box-shadow:inset 0 2px 0 #8a562d;}
.sdvNight .boardTuftLeft{left:-6px;}
.sdvNight .boardTuftRight{right:-6px;bottom:-4px;}

.sdvNight .drawer,.sdvNight .codeSheet{
  background:#2d2219;
  border-color:#8a562d;
  color:#f6e6c2;
}

.sdvNight .drawerHeader,.sdvNight .sheetGrip,.sdvNight .codeSheetHeader{
  background:#1f324a;
  color:#f7e8c6;
}

.sdvNight .drawerTabs{
  background:#231a13;
  border-bottom-color:#7a4b26;
}

.sdvNight .drawerTabs>button{color:#c9b493;}
.sdvNight .drawerTabs>.selected{background:#2d2219;color:#f7e8c6;}

.sdvNight .sdvInfoChip,.sdvNight .guideFlowItem,.sdvNight .teamSpriteStrip,.sdvNight .venueGuide,.sdvNight .sdvPillGroup,.sdvNight .squad,.sdvNight .rulesBox,.sdvNight .mapStatus,.sdvNight .playerCard,.sdvNight .calPickBar,.sdvNight .demoCard{
  background:#3d2d20;
  border-color:#8a562d;
  box-shadow:none;
  color:#f6e6c2;
}

.sdvNight .sdvPill{color:#d6c09d;}
.sdvNight .heroCaption{background:#253d27;border-top-color:#160d07;color:#d4ebba;box-shadow:none;}
.sdvNight .sdvIconTitle,.sdvNight .identityLabel,.sdvNight .playerName,.sdvNight .roomCode,.sdvNight .inviteCode,.sdvNight .venueTitle,.sdvNight .summaryVenue,.sdvNight .compactClock,.sdvNight .bodyCopy,.sdvNight .drawerHeaderTitle,.sdvNight .toolLabel,.sdvNight .teamSpriteText,.sdvNight .rosterName,.sdvNight .settingsCopy,.sdvNight .statsValue,.sdvNight .instruction,.sdvNight .demoTitle,.sdvNight .eventRow{color:#f7e8c6;}
.sdvNight .role-cat .roleName{color:#ffae63;}
.sdvNight .role-mouse .roleName{color:#8fd0f5;}
.sdvNight .phaseName,.sdvNight .vibeActive .toolLabel{color:#9be889;}
.sdvNight .registrationState{color:#d8c29e;border-left-color:#7a4b26;}
.sdvNight .compactProgress{border-left-color:#7a4b26;}
.sdvNight .compactClock.clock-warn{color:#3b1d0b;}
.sdvNight .compactClock.clock-urgent{color:#fffdf6;}
.sdvNight .guideStepTitle{color:#b6e39f;}
.sdvNight .venueHint,.sdvNight .legendFoot,.sdvNight .demoCaption,.sdvNight .inviteNote,.sdvNight .settingsNote,.sdvNight .statLabel,.sdvNight .eventTime{color:#c9b493;}
.sdvNight .signpostLink{color:#8fd0f5;}
.sdvNight .resumeAction,.sdvNight .venueDropValue,.sdvNight .safetyCopy,.sdvNight .codePlankTitle{color:#bfe3ff;}
.sdvNight .homeHero,.sdvNight .createHeroImg,.sdvNight .resultHero,.sdvNight .sdvMeadowFooter{filter:brightness(.84) contrast(1.04);}
.sdvNight .sdvIconBtn.sdvBtnPaper map-icon,
.sdvNight .sdvIconBtn.sdvBtnWood map-icon,
.sdvNight .edgeButton pixel-glyph,
.sdvNight .dockSecondary pixel-glyph,
.sdvNight .sheetCloseButton pixel-glyph,
.sdvNight .venueNavChip pixel-glyph,
.sdvNight .resumeLeft map-icon,
.sdvNight .identityLabelWrap map-icon,
.sdvNight .sdvIconTitle map-icon,
.sdvNight .sdvIconTitle pixel-glyph,
.sdvNight .settingRuleRow map-icon,
.sdvNight .ruleItem pixel-glyph,
.sdvNight .guideStepIconBox map-icon,
.sdvNight .guideIcon map-icon,
.sdvNight .sdvPill:not(.sdvPillActive) map-icon,
.sdvNight .sdvBtnPaper map-icon,
.sdvNight .sdvBtnWood map-icon,
.sdvNight .signpostLink:not(:last-child) map-icon{
  filter:invert(.92) sepia(.28) brightness(1.18);
}
.sdvNight .sdvError{border-image-source:none;background:#4a201a;border:2px solid #c95843;padding:8px 10px;color:#ffd8cf;}
