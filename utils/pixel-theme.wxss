@import "./pixel-art-ratios.wxss";
@import "./sdv-theme.wxss";
page{background-color:#a8d481;background-image:url("data:image/png;base64,");background-repeat:repeat;background-size:64px 64px;image-rendering:pixelated;color:#3b1d0b;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;font-weight:400;line-height:1.45}
view,scroll-view,button,input{box-sizing:border-box}button,input{font-weight:400;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif}button::after{border:0}button[disabled]{opacity:.62}
.screen{position:relative;width:var(--vw,100vw);min-height:var(--vh,100vh);box-sizing:border-box;background-color:#a8d481;background-image:url("data:image/png;base64,");background-repeat:repeat;background-size:64px 64px;image-rendering:pixelated;color:#3b1d0b}.muted{color:#5e3616}.orangeNumber{color:#b84c04}.label{font-weight:400}
.pixelPaper{background:transparent;border:8px solid transparent;border-radius:0;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated}
.textButton{white-space:normal;overflow-wrap:anywhere;max-width:100%;min-height:44px;background:transparent;color:#3b1d0b;border:8px solid transparent;border-radius:0;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;font-size:calc(15px * var(--font-scale,1));line-height:1.4;padding:5px 8px;margin:0}
.error{display:block;padding:4px 6px;margin:10px 14px;background:transparent;color:#731d0f;border:8px solid transparent;border-radius:0;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;font-size:14px;line-height:1.5}
