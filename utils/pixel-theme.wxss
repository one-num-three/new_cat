@import "./fusion-font.wxss";
@import "./pixel-font.wxss";
@import "./pixel-art-ratios.wxss";
page{background:#fcf8ed;color:#050b14;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC","Microsoft YaHei",sans-serif;font-weight:400;line-height:1.45}
view,scroll-view,button,input{box-sizing:border-box}button,input{font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif}button::after{border:0}button[disabled]{opacity:.52}
.screen{position:relative;width:var(--vw,100vw);min-height:var(--vh,100vh);box-sizing:border-box}.muted{color:#666}.orangeNumber{color:#ff6500}.label{font-weight:400}
.pixelPaper{background:#fcf9f0;border:2px solid #e8dfce;box-shadow:0 2px 0 #e8dfce;border-radius:3px}
.textButton{background:transparent;color:#384b38;font-size:15px;line-height:1.5;padding:10px;margin:0}
.error{display:block;padding:10px 12px;margin:10px 14px;background:#ffedd9;color:#a3381b;border:1px solid #e5b38d;font-size:14px;line-height:1.5}
