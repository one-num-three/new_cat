<view wx:if="{{visible}}" class="sdvModalWrap {{mode==='sheet'?'sdvModalSheetMode':'sdvModalDialogMode'}}" style="--font-scale:{{fontScale}}">
  <view class="sdvModalMask" bindtap="onMaskTap" catchtouchmove="ignoreTouch"></view>
  <view class="sdvModalPanel {{mode==='sheet'?'sdvSheetPanel':'sdvDialogPanel'}}" role="dialog" aria-label="{{title || '提示'}}">
    <view class="sdvModalHeader" catchtouchmove="ignoreTouch">
      <text class="sdvModalTitle">{{title || '提示'}}</text>
      <button class="sdvModalClose" bindtap="onMaskTap" aria-label="关闭">×</button>
    </view>
    <scroll-view scroll-y class="sdvModalBody">
      <text wx:if="{{content}}" class="sdvModalCopy">{{content}}</text>
      <slot />
      <view wx:if="{{mode==='sheet' && items && items.length}}" class="sdvSheetList">
        <button wx:for="{{items}}" wx:key="index" data-index="{{index}}" bindtap="onSelectItem" class="sdvSheetItem {{item.active?'sdvSheetActive':''}} {{item.danger?'sdvSheetDanger':''}}">
          <view class="sdvSheetItemCopy">
            <text class="sdvSheetItemLabel">{{item.label}}</text>
            <text wx:if="{{item.hint}}" class="sdvSheetItemHint">{{item.hint}}</text>
          </view>
          <text wx:if="{{item.active}}" class="sdvSheetBadge">当前</text>
          <text wx:else class="sdvSheetArrow" aria-hidden="true">›</text>
        </button>
      </view>
    </scroll-view>
    <view wx:if="{{mode==='sheet'}}" class="sdvModalFooter" catchtouchmove="ignoreTouch">
      <button class="sdvModalBtn sdvModalBtnPlain" bindtap="onCancel">{{cancelText || '关闭'}}</button>
    </view>
    <view wx:else class="sdvModalFooter" catchtouchmove="ignoreTouch">
      <button wx:if="{{showCancel}}" class="sdvModalBtn sdvModalBtnPlain" bindtap="onCancel">{{cancelText || '取消'}}</button>
      <button class="sdvModalBtn sdvModalBtnTone-{{confirmTone || 'green'}}" bindtap="onConfirm">{{confirmText || '确认'}}</button>
    </view>
  </view>
</view>
