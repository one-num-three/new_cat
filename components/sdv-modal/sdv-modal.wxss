.sdvModalWrap{
  position:fixed;
  inset:0;
  z-index:80;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px 16px;
  box-sizing:border-box;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
}

.sdvModalSheetMode{
  align-items:flex-end;
  padding:16px 10px calc(12px + max(var(--safe-bottom,0px),env(safe-area-inset-bottom)));
}

.sdvModalMask{
  position:absolute;
  inset:0;
  background:rgba(28,44,24,.54);
}

.sdvModalPanel{
  position:relative;
  z-index:1;
  width:100%;
  max-width:420px;
  max-height:80vh;
  display:flex;
  flex-direction:column;
  background:transparent;
  border:12px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:24 fill;
  border-image-width:12px;
  border-image-repeat:round;
  image-rendering:pixelated;
  overflow:hidden;
  box-sizing:border-box;
}

.sdvSheetPanel{
  max-width:520px;
}

.sdvModalHeader{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:10px 12px;
  background:#7bc4ec;
  border-bottom:3px solid #3b1c0a;
  box-shadow:inset 0 2px 0 #b5e3fa,inset 0 -3px 0 #4d9a3b,inset 0 -5px 0 #82cf6f;
}

.sdvModalTitle{
  flex:1;
  min-width:0;
  font-size:calc(18px * var(--font-scale,1));
  line-height:1.3;
  color:#3b1d0b;
  overflow-wrap:anywhere;
}

.sdvModalClose{
  flex:none;
  width:34px!important;
  height:34px;
  min-height:34px;
  margin:0!important;
  padding:0!important;
  display:flex;
  align-items:center;
  justify-content:center;
  background:transparent;
  border:6px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:6px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
  font-size:18px;
  line-height:1;
}

.sdvModalClose::after{border:0}

.sdvModalBody{
  flex:0 1 auto;
  max-height:56vh;
  padding:12px 14px;
  background:#fbe3b0;
  box-sizing:border-box;
}

.sdvModalCopy{
  display:block;
  font-size:calc(15px * var(--font-scale,1));
  line-height:1.6;
  color:#3b1d0b;
  white-space:pre-line;
  overflow-wrap:anywhere;
}

.sdvSheetList{
  display:flex;
  flex-direction:column;
  gap:8px;
}

.sdvSheetItem{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  width:100%!important;
  min-height:46px;
  margin:0!important;
  padding:5px 8px;
  background:transparent;
  border:8px solid transparent;
  border-radius:0;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  color:#3b1d0b;
  text-align:left;
  white-space:normal;
  box-sizing:border-box;
}

.sdvSheetItem::after{border:0}
.sdvSheetItem:active{opacity:.85}

.sdvSheetActive{
  padding:11px 14px;
  background:#cdebfb;
  border:2px solid #2a6e99;
  border-image:none;
  box-shadow:inset 0 2px 0 #eaf7fe,inset 0 -2px 0 #9bd2f0;
}

.sdvSheetDanger{
  border-image-source:url("data:image/png;base64,");
  color:#731d0f;
}

.sdvSheetItemCopy{
  flex:1;
  min-width:0;
}

.sdvSheetItemLabel{
  display:block;
  font-size:calc(15px * var(--font-scale,1));
  line-height:1.35;
}

.sdvSheetItemHint{
  display:block;
  margin-top:3px;
  font-size:calc(12px * var(--font-scale,1));
  line-height:1.4;
  color:#5e3616;
}

.sdvSheetBadge{
  flex:none;
  padding:2px 7px;
  background:#3588bd;
  border:2px solid #1e5880;
  border-radius:0;
  color:#fffdf6;
  font-size:11px;
}

.sdvSheetArrow{
  flex:none;
  font-size:20px;
  color:#35692a;
}

.sdvModalFooter{
  display:flex;
  gap:10px;
  padding:10px 12px 12px;
  background:#eed094;
  border-top:2px solid #b58447;
}

.sdvModalBtn{
  flex:1 1 0;
  min-width:0;
  width:auto!important;
  min-height:44px;
  margin:0!important;
  padding:5px 8px;
  border:8px solid transparent;
  border-radius:0;
  background:transparent;
  box-shadow:none;
  border-image-source:url("data:image/png;base64,");
  border-image-slice:16 fill;
  border-image-width:8px;
  border-image-repeat:round;
  image-rendering:pixelated;
  font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;
  font-size:calc(16px * var(--font-scale,1));
  line-height:1.3;
  white-space:normal;
}

.sdvModalBtn::after{border:0}
.sdvModalBtn:active{transform:translateY(2px);opacity:.88}

.sdvModalBtnPlain{
  color:#3b1d0b;
}

.sdvModalBtnTone-green{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvModalBtnTone-amber{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvModalBtnTone-red{
  color:#fffdf6;
  border-image-source:url("data:image/png;base64,");
}

.sdvModalBtnTone-plain{
  color:#3b1d0b;
}
