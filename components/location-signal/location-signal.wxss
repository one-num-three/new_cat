:host{display:inline-block}.signalChip{display:flex;align-items:center;justify-content:center;gap:6px;margin:0;min-height:36px;padding:7px 9px;background:#fcf8edf5;border:1px solid #72856c;border-radius:3px;color:#52634e;font-family:inherit;font-size:calc(12px * var(--signal-font-scale,1));font-weight:400;line-height:1.3;white-space:nowrap}.signalChip::after{border:0}.signalBars{display:flex;align-items:flex-end;gap:2px;height:17px;flex:none}.signalBar{width:3px;background:#ced3c3}.good .lit{background:#317b48}.fair .lit{background:#a7781c}.weak .lit{background:#b5522e}.muted{color:#6d7568;border-color:#969d8c}.signalChip text{font-variant-numeric:tabular-nums}
