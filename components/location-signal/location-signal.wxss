:host{display:inline-block}
.signalChip{width:auto!important;max-width:100%;display:inline-flex;align-items:center;justify-content:center;gap:6px;margin:0;min-height:40px;padding:var(--signal-pad,1px 6px);background:var(--signal-bg,transparent);border:var(--signal-border,8px solid transparent);border-radius:0;box-shadow:var(--signal-shadow,none);border-image-source:var(--signal-border-image,url("data:image/png;base64,"));border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;filter:drop-shadow(0 3px 0 rgba(27,16,8,.36));color:var(--signal-color,#3b1d0b);font-family:inherit;font-size:calc(12px * var(--signal-font-scale,1));font-weight:400;line-height:1.3;white-space:nowrap}
.signalChip::after{border:0}
.signalBars{display:flex;align-items:flex-end;gap:2px;height:16px;flex:none}
.signalBar{width:3px;background:var(--signal-bar-off,#cfb582)}
.good .lit{background:#4a943b}
.fair .lit{background:#e87f24}
.weak .lit{background:#d1503a}
.muted{color:var(--signal-color,#5e3616);border-image-source:var(--signal-border-image,url("data:image/png;base64,"))}
.signalChip text{font-variant-numeric:tabular-nums}
