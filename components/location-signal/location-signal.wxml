<button wx:if="{{signal}}" class="signalChip {{signal.tone}}" bindtap="explain" style="--signal-font-scale:{{fontScale}}" aria-label="{{'定位信号，'+signal.level+'格，'+signal.text+'。点击查看说明'}}"><view class="signalBars" aria-hidden="true"><view wx:for="{{bars}}" wx:key="*this" class="signalBar {{item<=signal.level?'lit':''}}" style="height:{{4+item*3}}px" /></view><text>{{signal.text}}</text></button>
