.nativeNav{position:absolute;top:0;left:0;right:0;z-index:10;color:#050b14;pointer-events:none}.navLine{position:relative;display:flex;align-items:center;justify-content:flex-start;padding-left:16px;gap:9px}.navLogo{width:29px;height:29px;flex:none}.navTitle{font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;font-size:19px;font-weight:400;max-width:58%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.navTitle.withBack{margin-left:27px;max-width:48%}.navBack{position:absolute;left:7px;top:0;width:34px!important;height:100%;display:flex;align-items:center;justify-content:center;line-height:1;padding:0!important;margin:0!important;background:transparent;color:#253329;font-size:35px;pointer-events:auto}.navBack::after{border:0}.navPreview{font-size:10px;color:#75806b;font-weight:400;margin-left:0}
.navTitle{max-width:calc(100% - 144px)}.navTitle.withBack{max-width:calc(100% - 155px)}
