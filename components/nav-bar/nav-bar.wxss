.nativeNav{position:absolute;top:0;left:0;right:auto;width:var(--vw,100vw);max-width:100vw;z-index:10;color:#3b1d0b;pointer-events:none}
.pinnedNav{position:fixed;background-color:#7bc4ec;background-image:url("data:image/png;base64,");background-repeat:repeat-x;background-position:center bottom;background-size:384px 56px;image-rendering:pixelated;border-bottom:3px solid #3b1c0a;box-shadow:inset 0 2px 0 #b5e3fa,inset 0 -4px 0 #4d9a3b,inset 0 -6px 0 #82cf6f,0 2px 0 #79a857}
.navLine{position:relative;display:flex;align-items:center;justify-content:flex-start;padding-left:12px;padding-right:110px;min-width:0;gap:8px}
.navBrand{display:inline-flex;align-items:center;gap:8px;min-width:0;max-width:100%;pointer-events:auto}
.floatingNav .navBrand{background:transparent;border:8px solid transparent;border-radius:0;padding:0 6px 0 2px;box-shadow:none;border-image-source:var(--nav-brand-border-image,url("data:image/png;base64,"));border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;filter:drop-shadow(0 3px 0 rgba(27,16,8,.38))}
.navBrand.withBack{margin-left:42px}
.navLogo{width:26px;height:26px;flex:none;image-rendering:pixelated}
.navTitle{font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;font-size:18px;font-weight:400;color:var(--nav-title-color,#3b1d0b);min-width:0;flex:0 1 auto;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.navBack{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:36px!important;height:34px;min-height:34px;display:flex;align-items:center;justify-content:center;line-height:1;padding:0 0 2px!important;margin:0!important;background:transparent;border:6px solid transparent;border-radius:0;box-shadow:none;border-image-source:var(--nav-back-border-image,url("data:image/png;base64,"));border-image-slice:16 fill;border-image-width:6px;border-image-repeat:round;image-rendering:pixelated;color:var(--nav-title-color,#3b1d0b);font-size:24px;pointer-events:auto}
.navBack::after{border:0}
.navBack:active{opacity:.85}
.navPreview{flex:none;padding:1px 6px;background:#ffdba3;border:2px solid #a64d0b;border-radius:0;font-size:10px;color:#7a3303;font-weight:400;line-height:1.3}
