<view class="nativeNav {{pinned?'pinnedNav':''}}" style="padding-top:{{statusHeight}}px">
  <view class="navLine" style="height:{{barHeight}}px">
    <button wx:if="{{back || preview}}" class="navBack" bindtap="goBack" aria-label="{{preview?'返回调试台':'返回'}}">‹</button>
    <image wx:if="{{!back && !preview}}" class="navLogo" src="/assets/pixel-v1/logo.png" mode="aspectFit" aria-hidden="true" />
    <text class="navTitle {{back || preview?'withBack':''}}">{{title}}</text>
    <text wx:if="{{preview}}" class="navPreview">预览</text>
  </view>
</view>

