:host{display:block;width:100%;height:100%}
.modelFrame{position:relative;width:100%;height:100%;overflow:hidden;background:#b7df8f}
.modelCanvas{display:block;width:100%;height:100%}
.modelPin{position:absolute;pointer-events:none;z-index:2;filter:var(--venue-overlay-filter,none)}
.modelPin image{width:48px;height:48px;image-rendering:pixelated}
.modelPin .pinLabel{position:absolute;top:45px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:10px;line-height:14px;color:#3b1d0b;background:#fff4d4;border:2px solid #4f2710;box-shadow:inset 0 1px 0 #fffaf0,0 2px 0 rgba(59,29,11,.35);border-radius:0;padding:1px 6px}
.modelCaption{position:absolute;left:8px;bottom:8px;max-width:calc(100% - 80px);pointer-events:none;background:#fae3b2;border:2px solid #4f2710;border-radius:0;color:#3b1d0b;padding:4px 6px;font-size:10px;line-height:1.5;z-index:3;filter:var(--venue-overlay-filter,none)}
.modelCaption view{display:block}
.attribution{font-size:8px}
.modelStatus{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:24px;background:#a8d481;z-index:4;text-align:center;color:#3b1d0b;font-size:14px}
.modelStatus button{min-height:44px;padding:4px 12px;border:8px solid transparent;border-radius:0;background:transparent;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;font-size:14px;color:#3b1d0b}
.modelSnapshot{display:block;position:absolute;inset:0;width:100%;height:100%;z-index:0;filter:var(--venue-art-filter,none)}
.compactCaption{bottom:calc(var(--safe-bottom,0px) + 8px);max-width:calc(100% - 252px);font-size:9px;overflow-wrap:anywhere;white-space:normal}
.compactCaption .attribution{font-size:7px;white-space:normal;overflow-wrap:anywhere}
