:host{display:block;width:100%;height:100%}.modelFrame{position:relative;width:100%;height:100%;overflow:hidden;background:#dce6d9}.modelCanvas{display:block;width:100%;height:100%}.modelPin{position:absolute;pointer-events:none;z-index:2}.modelPin image{width:48px;height:48px;image-rendering:pixelated}.modelPin .pinLabel{position:absolute;top:44px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:10px;color:#24342d;background:#fcf8eddd;padding:1px 4px}.modelCaption{position:absolute;left:8px;bottom:8px;max-width:calc(100% - 80px);pointer-events:none;background:#fcf8edde;color:#405346;padding:4px 6px;font-size:10px;line-height:1.5;z-index:3}.modelCaption view{display:block}.attribution{font-size:8px}.modelStatus{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:24px;background:#e7eddf;z-index:4;text-align:center;color:#24342d;font-size:14px}.modelStatus button{min-height:44px;padding:6px 18px;border:2px solid #24342d;background:#fcf8ed;font-size:14px;color:#24342d}

.modelSnapshot{display:block;position:absolute;inset:0;width:100%;height:100%;z-index:0}

.compactCaption{bottom:calc(var(--safe-bottom,0px) + 8px);max-width:calc(100% - 252px);font-size:9px;overflow-wrap:anywhere;white-space:normal}.compactCaption .attribution{font-size:7px;white-space:normal;overflow-wrap:anywhere}
