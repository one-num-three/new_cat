:host{display:block;width:100%;height:100%;min-height:0}
.venueArt{position:relative;overflow:hidden;width:100%;height:100%;min-height:0}
.venueViewport{position:absolute;inset:0;overflow:hidden;background:#b7df8f}
.venueImage{position:absolute;left:0;top:0;display:block;transform-origin:0 0;will-change:transform}
.venueTourHint{position:absolute;left:10px;top:10px;padding:1px 6px;background:transparent;border:8px solid transparent;border-radius:0;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;color:#3b1d0b;font-size:11px;pointer-events:none}
.venueDock{display:var(--venue-dock-display,grid);position:absolute;right:9px;bottom:25px;grid-template-columns:44px 44px;gap:4px}
.venueControl{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px!important;min-height:44px;margin:0;padding:0;border:6px solid transparent;border-radius:0;background:transparent;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:6px;border-image-repeat:round;image-rendering:pixelated;color:#3b1d0b;font-size:22px;line-height:1;font-weight:400}
.venueControl::after,.venueRetry::after{border:0}
.venueReset,.venueTour{font-size:12px}
.venueControl[disabled]{opacity:.45}
.venueAttribution{position:absolute;left:6px;bottom:5px;color:#3b1d0b;font-size:9px;text-shadow:0 1px 0 #fae3b2,1px 0 0 #fae3b2;pointer-events:none}
.venueStatus{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;background:#a8d481;color:#3b1d0b;font-size:14px}
.venueRetry{min-height:44px;padding:4px 12px;background:transparent;color:#3b1d0b;border:8px solid transparent;border-radius:0;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;font-size:14px}
.venueScene{position:absolute;left:0;top:0;transform-origin:0 0;will-change:transform}
.geoAnchor{position:absolute;pointer-events:none}
.geoBadge{position:absolute;width:0;height:0;transform-origin:0 0}
.geoMarker{position:absolute;display:block;image-rendering:pixelated}
.geoLabel{position:absolute;left:0;top:3px;transform:translateX(-50%);white-space:nowrap;font-size:11px;line-height:14px;color:#332012;text-shadow:1px 0 #fffdf6,-1px 0 #fffdf6,0 1px #fffdf6,0 -1px #fffdf6}
.geoRegion{position:absolute;border:2px solid #e87f24;background:rgba(232,127,36,.2);box-sizing:border-box;border-radius:50%;pointer-events:none}
.geoPin{display:block;width:24px;height:24px;line-height:24px;text-align:center;background:#e87f24;color:#fffdf6;border:2px solid #4f2710;border-radius:50%;font-size:12px;pointer-events:none}
.venueBoundaryLine{position:absolute;height:3px;background:#4a943b;border-top:1px solid #fffdf6;border-bottom:1px solid #fffdf6;transform-origin:0 50%;pointer-events:none;box-sizing:border-box}
