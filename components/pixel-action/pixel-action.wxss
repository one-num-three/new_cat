:host{display:block;min-width:0;width:100%}
.pixelAction{position:relative;display:flex;align-items:center;justify-content:center;width:100%!important;margin:0!important;box-sizing:border-box;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;font-weight:400;line-height:1.25;border-radius:0;min-height:44px}
.pixelAction::after{border:0}
.sourceAction{padding:0;background:transparent;overflow:visible}
.actionArt{display:block;width:100%;height:auto!important}
.nativeAction{padding:12px 14px;color:var(--action-orange-color,#fffdf6);background:var(--action-orange-bg,transparent);border:var(--action-bw,8px) solid var(--action-orange-bc,transparent);border-radius:0;box-shadow:var(--action-orange-shadow,none);border-image-source:var(--action-orange-bi,url("data:image/png;base64,"));border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;filter:var(--action-filter,none);font-size:calc(20px * var(--action-scale,1))}
.nativeAction.tone-blue{color:var(--action-blue-color,#fffdf6);background:var(--action-blue-bg,transparent);border-color:var(--action-blue-bc,transparent);box-shadow:var(--action-blue-shadow,none);border-image-source:var(--action-blue-bi,url("data:image/png;base64,"))}
.nativeAction.tone-green{color:var(--action-green-color,#fffdf6);background:var(--action-green-bg,transparent);border-color:var(--action-green-bc,transparent);box-shadow:var(--action-green-shadow,none);border-image-source:var(--action-green-bi,url("data:image/png;base64,"))}
.nativeAction.tone-red{color:var(--action-red-color,#fffdf6);background:var(--action-red-bg,transparent);border-color:var(--action-red-bc,transparent);box-shadow:var(--action-red-shadow,none);border-image-source:var(--action-red-bi,url("data:image/png;base64,"))}
.nativeAction.tone-plain,.nativeAction.tone-neutral{color:var(--action-plain-color,#3b1d0b);background:var(--action-plain-bg,transparent);border-color:var(--action-plain-bc,transparent);box-shadow:var(--action-plain-shadow,none);border-image-source:var(--action-plain-bi,var(--action-plain-border-image,url("data:image/png;base64,")))}
.actionLabel{display:block;white-space:normal;text-align:center}
.actionPressed{transform:translateY(2px);opacity:.9}
.pixelAction[disabled]{opacity:.68;filter:saturate(.55)}
