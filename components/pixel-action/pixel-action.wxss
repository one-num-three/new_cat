:host{display:block;min-width:0;width:100%}
.pixelAction{position:relative;display:flex;align-items:center;justify-content:center;width:100%!important;margin:0!important;box-sizing:border-box;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;font-weight:400;line-height:1.25;border-radius:0;min-height:44px}
.pixelAction::after{border:0}
.sourceAction{padding:0;background:transparent;overflow:visible}
.actionArt{display:block;width:100%;height:auto!important}
.nativeAction{padding:12px 14px;color:#fffdf6;background:transparent;border:8px solid transparent;border-radius:0;box-shadow:none;border-image-source:url("data:image/png;base64,");border-image-slice:16 fill;border-image-width:8px;border-image-repeat:round;image-rendering:pixelated;font-size:calc(20px * var(--action-scale,1))}
.nativeAction.tone-blue{color:#fffdf6;border-image-source:url("data:image/png;base64,")}
.nativeAction.tone-green{color:#fffdf6;border-image-source:url("data:image/png;base64,")}
.nativeAction.tone-red{color:#fffdf6;border-image-source:url("data:image/png;base64,")}
.nativeAction.tone-plain,.nativeAction.tone-neutral{color:#3b1d0b;border-image-source:url("data:image/png;base64,")}
.actionLabel{display:block;white-space:normal;text-align:center}
.actionPressed{transform:translateY(2px);opacity:.9}
.pixelAction[disabled]{opacity:.68;filter:saturate(.55)}
