:host{display:block;min-width:0;width:100%}.pixelAction{position:relative;display:flex;align-items:center;justify-content:center;width:100%!important;margin:0!important;box-sizing:border-box;font-family:CatMouseFusionUI,ParkReplicaUI,"PingFang SC",sans-serif;font-weight:400;line-height:1.25;border-radius:0;min-height:44px}.pixelAction::after{border:0}.sourceAction{padding:0;background:transparent;overflow:visible}.actionArt{display:block;width:100%;height:auto!important}.nativeAction{padding:12px 14px;color:#fff;background:#fb8018;border:3px solid #11151a;box-shadow:inset 0 3px #ffffff4d,inset 0 -4px #00000025;font-size:calc(20px * var(--action-scale,1));clip-path:polygon(7px 0,calc(100% - 7px) 0,calc(100% - 7px) 3px,100% 3px,100% calc(100% - 7px),calc(100% - 3px) calc(100% - 7px),calc(100% - 3px) 100%,7px 100%,7px calc(100% - 3px),0 calc(100% - 3px),0 7px,3px 7px,3px 0)}.nativeAction.tone-blue{background:#1196ed}.nativeAction.tone-green{background:#2d864c}.nativeAction.tone-red{background:#e44832}.nativeAction.tone-plain,.nativeAction.tone-neutral{background:#fcf8ed;color:#050b14}.actionLabel{display:block;white-space:normal;text-align:center}.actionPressed{opacity:.85}.pixelAction[disabled]{opacity:.45;filter:saturate(.4)}
