# Large archival bundles and editor/model backups stay local.
*.zip
*.7z
*.tar.gz
*.blend1
*.blend2

# Repeated delivery copies and screenshot evidence are not source inputs.
# Keep report text, audit scripts/data and all design originals used by tests.
/reports/**/MODIFIED_FILE/
/reports/**/release*/
/reports/**/before/
/reports/**/baseline/
/reports/**/rollback-fixture/
**/node-compile-cache/
**/.test-tmp/
**/test-tmp/
/reports/**/*.png
/reports/**/*.jpg
/reports/**/*.jpeg
/reports/**/*.webp

# Private deployment keys and database backups
*.pem
*.p12
*.pfx
*.dump
