<view class="mapPage">
  <view wx:if="{{devPreview}}" class="previewBanner mapPreviewBanner" bindtap="backToDev">预览 · 非实时位置 · 返回调试台 ›</view>
  <map class="gameMap" latitude="{{latitude}}" longitude="{{longitude}}" scale="17" markers="{{markers}}" circles="{{circles}}" show-location="false" enable-rotate="false" />
  <view class="topPanel"><view class="row"><view><text class="roleBadge {{match.myRole==='cat'?'catBadge':'mouseBadge'}}">{{roleText}} · {{phaseText}}</text><text wx:if="{{match}}" class="goal">已抓 {{match.captured}} / {{match.target}}</text><text wx:else class="goal">正在加入对局</text></view><view class="clockBlock"><text class="clock">{{match.phase==='FINISHED' || match.phase==='CANCELLED'?'已结束':clock}}</text><text class="clockCaption">{{offline?'等待同步':match.phase==='HIDING'?'躲藏倒计时':match.phase==='PAUSED'?'计时已冻结':match.phase==='FINISHED' || match.phase==='CANCELLED'?'结果已确认':'追逐剩余'}}</text></view></view><text class="status">{{connection}} · {{offline?'已隐藏战术位置':match.myStatus==='captured'?'仅查看公开状态':'地图按身份显示'}}</text></view>
  <view class="bottomPanel">
    <view wx:if="{{offline && connection!=='身份失效' && match && match.phase!=='FINISHED' && match.phase!=='CANCELLED'}}" class="stateIllustration reconnectState"><image src="/assets/brand/reconnecting.png" mode="aspectFit" aria-label="正在重连的猫鼠" /><text>连接中断，正在恢复本局状态</text></view>
    <view wx:if="{{!match}}" class="notice">正在获取本局状态，请稍候。</view>
    <view wx:if="{{offline && match && match.phase!=='FINISHED' && match.phase!=='CANCELLED'}}" class="notice">{{connection==='身份失效'?'身份已失效，请返回首页重新进入。':'地图和倒计时暂停更新。请停下等待连接恢复，不要依据旧位置追逐或扫码。'}}</view>
    <view wx:elif="{{match.phase==='HIDING'}}" class="notice">鼠先躲藏；猫请停留在集合点。追逐开始后才能抓捕。</view>
    <view wx:elif="{{match.phase==='PAUSED'}}" class="notice"><view class="stateIllustration"><image src="/assets/brand/reconnecting.png" mode="aspectFit" aria-label="等待恢复" /><text>本局暂停</text></view>{{pauseReasonText}}。请原地等待，重新定位后由组织者恢复。</view>
    <view wx:elif="{{match.myStatus==='captured' && match.phase!=='FINISHED' && match.phase!=='CANCELLED'}}" class="notice"><view class="stateIllustration"><image src="/assets/brand/captured-mouse.png" mode="aspectFit" aria-label="本轮已出局的老鼠" /><text>本轮已出局</text></view>你已被捕，请返回集合点等待结算。</view>
    <view wx:elif="{{match.phase==='CHASING'}}" class="notice">{{match.myRole==='cat'?'橘色区域是鼠的大致线索，线下接近后扫码。':'留意周围环境；停下后可展示动态码。'}}</view>
    <view wx:if="{{!offline && match.phase==='CHASING' && match.myRole==='mouse' && match.myStatus==='active' && nearbyCat}}" class="warning"><text class="warningDot"></text><text>附近有猫，请注意观察并安全移动</text></view>
    <view wx:if="{{!offline && match.phase==='CHASING' && match.myStatus==='active'}}"><button wx:if="{{match.myRole==='cat'}}" class="primary" loading="{{loading}}" bindtap="scan">扫码确认抓捕</button><button wx:else class="primary" bindtap="showCode">停下，展示动态码</button></view>
    <view wx:if="{{match.phase==='FINISHED' || match.phase==='CANCELLED'}}" class="result"><image wx:if="{{match.outcome==='cat_win'}}" class="resultArt" src="/assets/brand/cat-win.png" mode="aspectFit" aria-label="猫队获胜插画" /><image wx:elif="{{match.outcome==='mouse_win'}}" class="resultArt" src="/assets/brand/mouse-win.png" mode="aspectFit" aria-label="鼠队获胜插画" /><text class="resultTag">本局结算</text><text class="resultTitle">{{match.outcome==='cat_win'?'猫队获胜':match.outcome==='mouse_win'?'鼠队获胜':'本局取消'}}</text><text>{{match.reason==='capture_target'?'已达到捕获目标':match.reason==='deadline'?'追逐时间已到':'不计胜负'}}</text><button class="primary" bindtap="replay">再来一局</button></view>
    <view wx:if="{{error}}"><text class="error">{{error}}</text><button class="textButton" bindtap="goHome">返回首页</button></view>
    <view class="row actions"><button class="textButton" bindtap="toggleDrawer">队伍 · 规则 · 操作</button><button wx:if="{{!offline && match.phase==='PAUSED' && owner}}" class="textButton" bindtap="resume">恢复本局</button></view>
  </view>
  <view wx:if="{{drawer}}" class="drawerMask" bindtap="closeDrawer" catchtouchmove="ignoreTouch"></view>
  <view wx:if="{{drawer}}" class="drawer">
    <view class="drawerHeader"><text>对局详情</text><button class="textButton" bindtap="closeDrawer">关闭</button></view>
    <scroll-view scroll-y class="drawerBody">
      <view class="drawerContent"><text class="label">本局玩家</text><view wx:for="{{roster}}" wx:key="id" class="row roster"><text class="rosterName">{{item.nickname}} · {{item.role==='cat'?'猫':'鼠'}}</text><text class="rosterState">{{item.status==='captured'?'被捕':item.presence==='online'?'在局':'重连中'}}</text></view><text class="label">最近事件</text><view wx:if="{{!events.length}}" class="help">暂无新事件</view><view wx:for="{{events}}" wx:for-item="event" wx:key="seq" class="roster"><text>{{event.kind==='CAPTURE'?'完成一次抓捕':event.kind==='RESULT'?'本局结算':event.kind==='PAUSE'?'本局暂停':event.kind==='RESUME'?'本局恢复':event.kind==='CHASING'?'追逐开始':'本局开始'}}</text></view><text class="label">地图与规则</text><text class="help">蓝色标记是本人，集合点不是玩家位置。绿色边界是活动范围；橘色区域仅代表大致线索，不是鼠的精确位置。</text><text class="help">躲藏 30 秒，追逐 6 分钟。猫达到开局鼠人数的 60%（向上取整）获胜；否则时间到鼠胜。</text><text class="label">操作与安全</text><text class="help">猫每 30 秒获得区域线索，鼠获得近距预警。双方停下后扫码；GPS 只作辅助校验。进行中退出会暂停本局。</text><button wx:if="{{!offline && (match.phase==='CHASING' || match.phase==='HIDING')}}" class="secondary" bindtap="emergency">紧急暂停</button><button wx:if="{{!offline && owner && (match.phase==='CHASING' || match.phase==='HIDING')}}" class="secondary" bindtap="pause">组织者暂停</button><button wx:if="{{!offline && owner && match.phase==='PAUSED'}}" class="danger" bindtap="cancel">取消本局</button><button class="textButton" bindtap="leave">退出</button></view>
    </scroll-view>
  </view>
</view>
