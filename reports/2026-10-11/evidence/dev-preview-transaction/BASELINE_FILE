const config = require('./config');

function enabled() {
  try {
    return config.mode === 'local' && wx.getAccountInfoSync().miniProgram.envVersion === 'develop';
  } catch { return false; }
}

const cases = [
  { id:'home', title:'首页与加入', path:'/pages/index/index?devPreview=home' },
  { id:'create', title:'创建活动', path:'/pages/room/room?devPreview=create' },
  { id:'ready', title:'房间准备', path:'/pages/room/room?devPreview=ready' },
  { id:'cat', title:'猫队追逐地图', path:'/pages/map/map?devPreview=cat' },
  { id:'mouse', title:'鼠队追逐地图', path:'/pages/map/map?devPreview=mouse' },
  { id:'alert', title:'鼠队近距预警', path:'/pages/map/map?devPreview=alert' },
  { id:'hiding', title:'躲藏阶段', path:'/pages/map/map?devPreview=hiding' },
  { id:'code', title:'动态码', path:'/pages/qrcode/qrcode?devPreview=code' },
  { id:'captured', title:'被捕状态', path:'/pages/map/map?devPreview=captured' },
  { id:'paused', title:'暂停状态', path:'/pages/map/map?devPreview=paused' },
  { id:'offline', title:'断线重连', path:'/pages/map/map?devPreview=offline' },
  { id:'catWin', title:'猫队胜利', path:'/pages/map/map?devPreview=catWin' },
  { id:'mouseWin', title:'鼠队胜利', path:'/pages/map/map?devPreview=mouseWin' },
  { id:'cancelled', title:'取消结算', path:'/pages/map/map?devPreview=cancelled' }
];

function accepts(id) { return enabled() && cases.some(item => item.id === id); }

function mapSnapshot(id, me) {
  const now = Date.now(), isMouse = ['mouse','alert','captured','mouseWin'].includes(id);
  const phase = id === 'hiding' ? 'HIDING' : id === 'paused' ? 'PAUSED' : id === 'catWin' || id === 'mouseWin' ? 'FINISHED' : id === 'cancelled' ? 'CANCELLED' : 'CHASING';
  const role = isMouse ? 'mouse' : 'cat';
  const roster = [
    {id:me,nickname:'我 · 演示',role,status:id==='captured'?'captured':'active',presence:'online'},
    {id:'dev-cat',nickname:'小橘',role:'cat',status:'active',presence:'online'},
    {id:'dev-mouse',nickname:'小米',role:'mouse',status:'active',presence:'online'}
  ];
  const live = !['captured','paused','offline','catWin','mouseWin','cancelled'].includes(id);
  const visiblePositions = live ? [{id:me,lat:32.0584,lng:118.7968,accuracy:6,receivedAt:now},{id:role==='cat'?'dev-cat':'dev-mouse',lat:32.0588,lng:118.7971,accuracy:8,receivedAt:now}] : [];
  return {version:1,serverTime:now,venue:{lat:32.0582,lng:118.7965,radiusM:200},owner:true,roster,visiblePositions,
    intel:id==='cat'?[{cellLat:32.0592,cellLng:118.798,radiusM:50}]:[],nearbyCat:id==='alert',
    events:[{seq:1,kind:'START'},{seq:2,kind:'CHASING'}],
    match:{id:'dev-preview-match',phase,myRole:role,myStatus:id==='captured'?'captured':'active',remainingMs:phase==='HIDING'?18000:phase==='CHASING'?285000:0,captured:id==='catWin'?4:1,target:4,pauseReason:id==='paused'?'host':null,outcome:id==='catWin'?'cat_win':id==='mouseWin'?'mouse_win':null,reason:id==='catWin'?'capture_target':id==='mouseWin'?'deadline':id==='cancelled'?'cancelled':null}};
}

function roomData(id) {
  if(id==='create')return {roomId:'',total:8,venue:null};
  return {roomId:'dev-preview-room',code:'A1B2C3D4E5',owner:true,ready:true,rules:{total:8,cats:2,mice:6,hidingMs:30000,chasingMs:360000},
    roster:[{id:'dev-me',nickname:'我 · 演示',ready:true},{id:'dev-cat',nickname:'小橘',ready:true},{id:'dev-mouse',nickname:'小米',ready:false}],match:null};
}

module.exports = {enabled,accepts,cases,mapSnapshot,roomData};
