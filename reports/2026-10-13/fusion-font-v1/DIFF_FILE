+++ modified/cat-mouse-server/v2/fusion-font.test.js
@@ -0,0 +1,36 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
+const root=path.resolve(__dirname,'../..');
+const read=p=>fs.readFileSync(path.join(root,p),'utf8');
+const folder='design/2026-10-13/fusion-font-v1/';
+const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
+
+test('Fusion trial is imported only on dev page, never global or gameplay pages',()=>{
+ const css=read('pages/dev/dev.wxss');
+ assert.match(css,/@import "\.\/fusion-font\.wxss"/);
+ assert.match(css,/\.devScreen,\.devScreen button,\.devScreen text\{font-family:CatMouseFusionTrial,ParkReplicaUI,sans-serif;font-weight:400\}/);
+ for(const name of ['index','room','map','qrcode','venue'])assert.doesNotMatch(read(`pages/${name}/${name}.wxss`),/CatMouseFusionTrial|fusion-font/);
+ assert.doesNotMatch(read('utils/pixel-theme.wxss'),/CatMouseFusionTrial|fusion-font/);
+ if(fs.existsSync(path.join(root,'app.wxss')))assert.doesNotMatch(read('app.wxss'),/CatMouseFusionTrial|fusion-font/);
+});
+
+test('font source and embedded subset are locked and OFL preserved',()=>{
+ const m=JSON.parse(read(folder+'manifest.json'));
+ assert.equal(m.globalRollout,false);assert.equal(m.scope,'pages/dev');assert.equal(m.version,'2026.09.25');
+ for(const [name,hash] of [['upstream-zh-hans.woff',m.sourceSha256],['dev-subset.woff',m.subsetSha256]])assert.equal(sha(fs.readFileSync(path.join(root,folder,name))),hash);
+ const css=read('pages/dev/fusion-font.wxss');assert.equal(sha(Buffer.from(css)),m.wxssSha256);
+ const embedded=Buffer.from(css.match(/base64,([^\"]+)/)[1],'base64');
+ assert.equal(sha(embedded),m.subsetSha256);assert.equal(embedded.toString('ascii',0,4),'wOFF');
+ assert.ok(embedded.length<40000,'page static subset stays small');
+ assert.match(read(folder+'OFL.txt'),/SIL OPEN FONT LICENSE Version 1.1/);
+});
+
+test('all static Chinese labels in the trial are covered; arrow explicitly falls back',()=>{
+ const m=JSON.parse(read(folder+'manifest.json'));
+ const {groups}=require('../../utils/dev-preview');
+ const labels=read('pages/dev/dev.wxml')+JSON.stringify(groups);
+ for(const char of labels.match(/[\u3400-\u9fff]/g))assert.ok(m.coverage.includes(char),char);
+ assert.deepEqual(m.fallbackCharacters,['›']);
+ assert.match(read('pages/dev/dev.wxml'),/字体试样 · Fusion Pixel 12px/);
+});
