<view bindlayout="remeasureVenue" class="mapPage state-{{uiState}} {{terminal || uiState==='paused' || uiState==='offline'?'documentPage':'playPage'}} {{fontScale>1.15?'fontLarge':''}} {{viewportWidth<350?'narrowCanvas':''}}" style="--vw:{{viewportWidth}}px;--vh:{{viewportHeight}}px;--nav-height:{{navHeight}}px;--font-scale:{{fontScale}};--safe-bottom:{{safeBottom}}px">
<nav-bar title="猫鼠行动" preview="{{devPreview}}" />
<view wx:if="{{!match}}" class="emptyState"><text>正在同步本局状态</text><text class="bodyCopy">{{error || '请稍候，状态由服务器确认。'}}</text><button class="textButton" bindtap="goHome">返回首页</button></view>
<block wx:elif="{{terminal}}">
 <image class="resultHero" src="{{stateArt}}" mode="widthFix" aria-label="{{uiState==='catWin'?'猫队获胜':uiState==='mouseWin'?'鼠队获胜':'本局取消，不计胜负'}}" />
 <view class="terminalContent"><view class="pixelPaper resultStats"><text class="resultReason">{{uiState==='catWin'?'捕获目标已完成':uiState==='mouseWin'?'猫队未达到捕获目标':'公开记录'}}</text><view class="resultStatRow"><view><text wx:if="{{uiState!=='catWin'}}" class="statLabel">已抓捕</text><view class="statValue"><text class="orangeNumber">{{match.captured}}</text><text> / {{match.target}}</text></view></view><view wx:if="{{uiState!=='cancelled'}}" class="resultStatus"><text class="statLabel">对局状态</text><text class="statusBadge">已结束</text></view></view></view>
 <view wx:if="{{uiState==='mouseWin'}}" class="resultMap"><venue-art class="venueArt" compact="{{true}}" layout-key="{{viewportWidth+'x'+viewportHeight+'-'+fontScale}}" /></view>
 <view class="resultActions"><pixel-action class="pixelControl" wx:if="{{canReplay}}" skin="{{uiState==='catWin'?'/assets/pixel-v1/button-catwin-replay.png':uiState==='mouseWin'?'/assets/pixel-v1/button-mousewin-replay.png':'/assets/pixel-v1/button-cancelled-replay.png'}}" label="再来一局" tone="{{uiState==='cancelled'?'green':'orange'}}" font-scale="{{fontScale}}" bindaction="replay" /><text wx:else class="waitingHost">{{offline?'等待连接恢复后开始下一局':'等待房主开始下一局'}}</text><pixel-action class="pixelControl" skin="{{uiState==='catWin'?'/assets/pixel-v1/button-catwin-details.png':uiState==='mouseWin'?'/assets/pixel-v1/button-mousewin-details.png':'/assets/pixel-v1/button-cancelled-details.png'}}" label="查看对局详情" tone="plain" font-scale="{{fontScale}}" bindaction="toggleDrawer" /><pixel-action class="pixelControl" skin="{{uiState==='catWin'?'/assets/pixel-v1/button-catwin-home.png':uiState==='mouseWin'?'/assets/pixel-v1/button-mousewin-home.png':'/assets/pixel-v1/button-cancelled-home.png'}}" label="返回首页" tone="plain" font-scale="{{fontScale}}" bindaction="goHome" /></view><text wx:if="{{uiState==='cancelled'}}" class="recordNote">这局记录保留，下一轮使用新的对局</text></view>
</block>
<block wx:else>
 <view class="roleBand role-{{match.myRole}}"><image class="roleArt" src="{{roleArt}}" mode="aspectFit" aria-hidden="true" /><view class="roleCopy"><view class="roleTitle"><text class="roleName">{{roleText}}</text><text class="phaseSeparator"> · </text><text class="phaseName">{{offline?'重连中':uiState==='paused'?'本局暂停':uiState==='captured'?'已出局':phaseText}}</text></view><text class="roleSubtitle">{{offline?'连接恢复前不显示战术位置':uiState==='paused'?'计时已冻结，请原地等待':uiState==='captured'?'本轮出局，仅查看公开状态':uiState==='hiding'?(match.myRole==='cat'?'请在集合点等待倒计时结束':'在场地范围内寻找躲藏位置'):match.myRole==='cat'?'寻找老鼠，完成捕获目标':'躲避猫咪，坚持到最后'}}</text></view></view>
 <view class="pixelPaper hudStack"><view class="hudClock"><text class="statLabel">{{offline?'等待同步':match.phase==='HIDING'?'躲藏倒计时':match.phase==='PAUSED'?'计时已冻结':'追逐剩余时间'}}</text><text class="clock">{{clock}}</text></view><view class="hudCount"><text class="statLabel">已抓捕</text><view class="hudValue"><text class="orangeNumber">{{match.captured}}</text><text> / {{match.target}}</text></view></view></view>
 <block wx:if="{{uiState==='paused' || uiState==='offline'}}">
  <image class="pauseHero" src="{{stateArt}}" mode="widthFix" aria-label="{{uiState==='paused'?'猫鼠在公园停下等待':'连接中断，等待重连'}}" />
  <view class="statusMessage"><text class="statusTitle">{{uiState==='paused'?'本局暂停':'连接中断，正在重连'}}</text><text class="bodyCopy">{{uiState==='paused'?pauseReasonText:connection==='身份失效'?'身份已失效，请返回首页':'请停下等待连接恢复'}}</text><text class="bodyCopy">{{uiState==='paused'?'请原地等待，重新定位后恢复':'已隐藏战术位置和旧倒计时'}}</text></view>
  <view class="statusActions"><pixel-action class="pixelControl" wx:if="{{canResume}}" skin="/assets/pixel-v1/button-paused-resume.png" label="恢复本局" tone="green" font-scale="{{fontScale}}" bindaction="resume" /><text wx:elif="{{uiState==='paused'}}" class="waitingHost">等待组织者恢复本局</text><pixel-action class="pixelControl" wx:if="{{uiState==='paused'}}" skin="/assets/pixel-v1/button-paused-details.png" label="队伍·规则·操作" tone="plain" font-scale="{{fontScale}}" bindaction="toggleDrawer" /><view wx:else class="splitActions"><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-offline-team.png" label="队伍" tone="green" font-scale="{{fontScale}}" bindaction="toggleDrawer" /><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-offline-rules.png" label="规则" tone="orange" font-scale="{{fontScale}}" bindaction="toggleDrawer" /></view><button wx:if="{{connection==='身份失效'}}" class="textButton" bindtap="goHome">返回首页重新登录</button></view>
 </block>
 <block wx:else>
  <view class="mapModeBar"><view><text class="mapModeTitle">{{devPreview || artMode?'玄武湖 · 环洲 / 樱洲':'实时地图 · 授权视野'}}</text><text class="mapModeHint">{{devPreview || artMode?'场地导览 · 未标定实时位置':'蓝点是本人 · 橘色区域是大致线索'}}</text></view><button wx:if="{{!devPreview}}" class="mapModeButton" bindtap="toggleMapMode">{{artMode?'实时地图':'场地导览'}}</button><button wx:else class="mapModeButton" bindtap="openVenue">完整导览</button></view>
  <view class="mapCanvas"><venue-art class="venueArt" wx:if="{{devPreview || artMode}}" src="{{parkArt}}" compact="{{true}}" layout-key="{{viewportWidth+'x'+viewportHeight+'-'+fontScale+'-'+uiState}}" /><map wx:else class="gameMap" latitude="{{latitude}}" longitude="{{longitude}}" scale="17" markers="{{markers}}" circles="{{circles}}" show-location="{{false}}" enable-rotate="{{false}}" /></view>
  <view class="bottomPanel"><view wx:if="{{uiState==='hiding'}}" class="pixelPaper hidingPanel"><image class="hidingArt" src="{{stateArt}}" mode="widthFix" /><view><text class="statusTitle">鼠先躲藏</text><text class="bodyCopy">{{match.myRole==='cat'?'猫留在集合点，倒计时结束后出发。':'请在场地范围内躲藏，追逐开始后留意猫咪。'}}</text></view></view><view wx:elif="{{uiState==='captured'}}" class="pixelPaper capturedPanel"><text class="statusTitle">本轮已出局</text><text class="bodyCopy">仅查看公开状态</text><text class="bodyCopy">返回集合点，等待本局结算。</text></view><view wx:elif="{{nearbyCat}}" class="warningPanel"><text class="warningMark">!</text><view><text class="warningTitle">附近有猫，注意观察</text><text class="bodyCopy">只提示接近，不展示猫的位置</text></view></view><text wx:else class="mapNotice">{{match.myRole==='cat'?(devPreview || artMode?'位置线索请在实时地图中查看':'橘色区域仅代表大致线索'):'留意周围环境，注意安全！'}}</text>
   <view wx:if="{{uiState==='cat' || uiState==='mouse'}}" class="liveActions {{nearbyCat?'stackActions':'splitActions'}}"><pixel-action class="pixelControl" wx:if="{{canScan}}" skin="/assets/pixel-v1/button-cat-scan.png" label="扫码确认抓捕" tone="orange" font-scale="{{fontScale}}" loading="{{loading}}" bindaction="scan" /><pixel-action class="pixelControl" wx:if="{{canShowCode}}" skin="{{nearbyCat?'/assets/pixel-v1/button-alert-code.png':'/assets/pixel-v1/button-mouse-code.png'}}" label="停下，展示动态码" tone="blue" font-scale="{{fontScale}}" bindaction="showCode" /><pixel-action class="pixelControl" skin="{{nearbyCat?'/assets/pixel-v1/button-alert-details.png':match.myRole==='cat'?'/assets/pixel-v1/button-cat-details.png':'/assets/pixel-v1/button-mouse-details.png'}}" label="队伍·规则·操作" tone="plain" font-scale="{{fontScale}}" bindaction="toggleDrawer" /></view><pixel-action class="pixelControl" wx:else skin="{{uiState==='captured'?'/assets/pixel-v1/button-captured-details.png':'/assets/pixel-v1/button-hiding-details.png'}}" label="队伍·规则" tone="{{uiState==='captured'?'blue':'orange'}}" font-scale="{{fontScale}}" bindaction="toggleDrawer" /></view>
 </block>
</block>
<text wx:if="{{error && !offline}}" class="error">{{error}}</text>
<view wx:if="{{drawer}}" class="drawerMask" bindtap="closeDrawer"></view>
<view wx:if="{{drawer}}" class="drawer"><view class="drawerHandle"></view><view class="drawerHeader"><image class="drawerLogo" src="/assets/pixel-v1/drawer-title-icon.png" mode="aspectFit" /><text>对局详情</text><view class="drawerClose"><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-drawer-close.png" label="关闭" tone="plain" font-scale="{{fontScale}}" bindaction="closeDrawer" /></view></view><scroll-view scroll-y class="drawerBody"><view class="drawerContent">
 <view class="squadColumns"><view class="squad catsGroup"><view class="squadHead"><image src="/assets/pixel-v1/role-cat.png" mode="aspectFit" /><text>猫队 {{cats.length}}人</text></view><view class="teamGrid catGrid"><view wx:for="{{cats}}" wx:key="id" class="teamMember"><image src="/assets/pixel-v1/drawer-cat-avatar.png" mode="aspectFit" /><view><text class="rosterName">{{item.nickname}}</text><text class="rosterState">{{item.status==='left'?'已退出':item.presence==='online'?'在线':'重连中'}}</text></view></view></view></view><view class="squad miceGroup"><view class="squadHead"><image src="/assets/pixel-v1/role-mouse.png" mode="aspectFit" /><text>鼠队 {{mice.length}}人</text></view><view class="teamGrid mouseGrid"><view wx:for="{{mice}}" wx:key="id" class="teamMember"><image src="/assets/pixel-v1/drawer-mouse-avatar.png" mode="aspectFit" /><view><text class="rosterName">{{item.nickname}}</text><text class="rosterState {{item.status==='captured'?'caught':''}}">{{item.status==='captured'?'已被捕获':item.status==='left'?'已退出':item.presence==='online'?'在线':'重连中'}}</text></view></view></view></view></view>
 <view class="eventGroup"><view class="sectionHeading"><image src="/assets/pixel-v1/drawer-event-icon.png" mode="aspectFit" /><text>最近事件</text></view><text wx:if="{{!events.length}}" class="bodyCopy">暂无新事件</text><view wx:for="{{events}}" wx:for-item="event" wx:key="seq" class="eventRow"><text>{{event.timeText}}</text><text>{{event.kind==='CAPTURE'?'完成一次抓捕':event.kind==='RESULT'?'本局结算':event.kind==='PAUSE'?'本局暂停':event.kind==='RESUME'?'本局恢复':event.kind==='CHASING'?'追逐开始':'本局开始'}}</text></view></view>
 <view class="rulesGroup"><view class="sectionHeading"><image src="/assets/pixel-v1/drawer-rules-icon.png" mode="aspectFit" /><text>规则摘要</text></view><text class="bodyCopy">• 30秒躲藏 · 6分钟追逐</text><text class="bodyCopy">• 猫抓满{{match.target}}人获胜</text><text class="bodyCopy">• 取消不计胜负</text></view>
 <pixel-action class="pixelControl" wx:if="{{!offline && !terminal && (match.phase==='CHASING' || match.phase==='HIDING')}}" skin="/assets/pixel-v1/button-drawer-pause.png" label="紧急暂停" tone="red" font-scale="{{fontScale}}" bindaction="emergency" /><pixel-action class="pixelControl" skin="/assets/pixel-v1/button-drawer-leave.png" label="{{terminal?'返回首页':'退出本局'}}" tone="plain" dynamic="{{terminal}}" font-scale="{{fontScale}}" bindaction="leave" />
 <view class="advancedRules"><text class="bodyCopy">实时地图的蓝点是本人，旗帜是集合点；橘色区域不是精确位置。场地导览图不叠加玩家位置。被捕本轮出局；截止时未达标则鼠胜。双方停下扫码，GPS仅作辅助校验。</text><button wx:if="{{!offline && owner && (match.phase==='CHASING' || match.phase==='HIDING')}}" class="textButton" bindtap="pause">组织者暂停</button><button wx:if="{{!offline && owner && match.phase==='PAUSED'}}" class="textButton" bindtap="cancel">取消本局</button></view>
</view></scroll-view></view>
</view>
