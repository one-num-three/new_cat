:host{display:block;width:100%;height:100%;min-height:0}.venueArt{position:relative;overflow:hidden;width:100%;height:100%;min-height:0}.venueViewport{position:absolute;inset:0;overflow:hidden}.venueImage{position:absolute;left:0;top:0;display:block;transform-origin:0 0;will-change:transform}.venueTourHint{position:absolute;left:10px;top:10px;padding:5px 9px;background:#fcf8ede6;color:#24342d;font-size:11px;border-radius:3px;pointer-events:none}.venueDock{position:absolute;right:9px;bottom:25px;display:grid;grid-template-columns:44px 44px;gap:4px}.venueControl{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:44px!important;min-height:44px;margin:0;padding:0;border:1px solid #617664;border-radius:5px;background:#fcf8edef;color:#173d2a;font-size:24px;line-height:1;font-weight:550}.venueControl::after,.venueRetry::after{border:0}.venueReset,.venueTour{font-size:12px}.venueControl[disabled]{opacity:.45}.venueAttribution{position:absolute;left:6px;bottom:5px;color:#153d50;font-size:9px;text-shadow:0 1px 2px #fff,1px 0 2px #fff;pointer-events:none}.venueStatus{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;background:#fcf8ed;color:#24342d;font-size:14px}.venueRetry{min-height:44px;padding:8px 20px;background:#fff;border:1px solid #617664;border-radius:4px;font-size:14px}
