@import "../../utils/pixel-theme.wxss";
.devScreen{width:var(--vw,100vw);min-height:var(--vh,100vh);padding:calc(var(--nav-height) + 12px) 16px max(24px,env(safe-area-inset-bottom));background:#fcf8ed}.devTitle{display:block;font-size:calc(27px*var(--font-scale));font-weight:750;line-height:1.25}.devDescription{display:block;font-size:16px;color:#4f713b;margin-top:8px}.devNote{display:block;font-size:12px;color:#777;margin-top:5px}.venuePreviewEntry,.homeButton{display:block;width:100%!important;padding:12px;margin:15px 0 0;background:#e8efda;color:#21432b;border:3px solid #273d27;border-radius:2px;font-size:calc(16px*var(--font-scale));line-height:1.4;font-weight:750}.previewGroup{margin-top:18px}.groupTitle{display:block;font-size:calc(19px*var(--font-scale));font-weight:750;margin-bottom:8px}.previewGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.previewItem{display:flex;align-items:center;gap:7px;width:100%!important;margin:0!important;padding:11px 9px;background:#fcf9f0;border:2px solid #e5dbca;border-radius:2px;min-height:50px;font-size:calc(14px*var(--font-scale));line-height:1.4;text-align:left}.entryNumber{font-size:11px;color:#b37a31;flex:none}.entryTitle{flex:1;min-width:0;font-weight:550}.entryArrow{font-size:24px;color:#4c623e;flex:none}.fontLarge .previewGrid{grid-template-columns:1fr}.narrowCanvas .previewItem{padding:9px 6px;gap:5px;font-size:13px}.homeButton{background:#fcf8ed;color:#050b14;margin-top:20px}
