@import "../../utils/pixel-theme.wxss";
.mapPage{position:relative;box-sizing:border-box;width:var(--vw,100vw);min-height:var(--vh,100vh);padding-top:var(--nav-height,64px);background:#fcf8ed;color:#050b14;--font-scale:1}.playPage{height:var(--vh);display:flex;flex-direction:column;overflow:hidden}.documentPage{padding-bottom:max(20px,var(--safe-bottom),env(safe-area-inset-bottom))}
.roleBand{display:flex;align-items:center;gap:14px;padding:8px 20px;background:#ff9b2b;flex:none}.roleBand.role-mouse{background:#27b1ef}.roleArt{width:calc(var(--vw)*.16);height:calc(var(--vw)*.15);flex:none}.roleCopy{flex:1;min-width:0}.roleTitle{display:block;font-size:calc(var(--vw)*.078*var(--font-scale));font-weight:750;line-height:1.2;letter-spacing:.5px;color:#101115;-webkit-text-stroke:.5px #fff;paint-order:stroke fill}.roleSubtitle{display:block;font-size:calc(12px*var(--font-scale));line-height:1.3;margin-top:4px;font-weight:550}.state-captured .roleBand{filter:saturate(.5)}
.hudStack{display:flex;flex:none;margin:9px 9px 0;padding:8px 5px;background:#fcf9f0}.hudClock,.hudCount{width:50%;text-align:center;min-width:0}.hudCount{border-left:1px solid #e5d9c6}.state-cat .hudClock{order:2;border-left:1px solid #e5d9c6}.state-cat .hudCount{order:1;border-left:0}.statLabel{display:block;font-size:calc(15px*var(--font-scale));font-weight:550;line-height:1.3}.clock,.hudValue{display:block;font-size:calc(var(--vw)*.092);font-weight:900;line-height:1.1;margin-top:3px;font-variant-numeric:tabular-nums}.hudValue{white-space:nowrap}
.mapModeBar{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:7px 12px 5px;flex:none}.mapModeTitle{display:block;font-size:12px;font-weight:750;color:#305837}.mapModeHint{display:block;font-size:10px;color:#68675e;line-height:1.4}.mapModeButton{width:auto!important;margin:0!important;min-height:36px;padding:6px 9px;flex:none;line-height:1.3;background:#e8efda;border:2px solid #415c37;border-radius:2px;color:#264b2e;font-size:12px;font-weight:550}
.mapCanvas{position:relative;flex:1 1 0;min-height:140px;margin:0 10px;overflow:hidden;background:#0abce9;border:2px solid #e5dbca}.mapCanvas venue-art,.gameMap{display:block;width:100%;height:100%}.bottomPanel{flex:0 1 auto;min-height:0;max-height:48%;overflow:auto;padding:6px 10px max(12px,var(--safe-bottom),env(safe-area-inset-bottom))}.mapNotice{display:block;font-size:calc(14px*var(--font-scale));font-weight:550;text-align:center;padding:5px 3px}.splitActions{display:grid;grid-template-columns:1.15fr 1fr;gap:3px;align-items:center}.stackActions,.resultActions,.statusActions{display:flex;flex-direction:column;gap:7px}.liveActions{margin-top:5px}
.hidingPanel{display:flex;align-items:center;gap:8px;padding:0 7px 0 0;margin-bottom:6px}.hidingArt{display:block;width:60%;height:auto;flex:none}.hidingPanel>view{flex:1;min-width:0}.statusTitle{display:block;font-size:calc(23px*var(--font-scale));font-weight:750;line-height:1.3}.bodyCopy{display:block;font-size:calc(14px*var(--font-scale));font-weight:450;line-height:1.5;white-space:normal}.hidingPanel .statusTitle{font-size:calc(20px*var(--font-scale))}.hidingPanel .bodyCopy{font-size:calc(13px*var(--font-scale))}.capturedPanel{text-align:center;padding:8px;margin:0 0 7px}.capturedPanel .statusTitle{color:#dc6311}
.warningPanel{display:flex;align-items:center;justify-content:center;gap:10px;padding:8px;margin-bottom:5px;border:2px solid #ffc48f;background:#ffedd9;color:#da3a12}.warningMark{font-size:37px;font-weight:900}.warningTitle{display:block;font-size:calc(21px*var(--font-scale));font-weight:750}.warningPanel .bodyCopy{font-size:calc(12px*var(--font-scale))}
.pauseHero,.resultHero{display:block;width:100%;height:auto}.pauseHero{margin-top:8px}.statusMessage{text-align:center;padding:14px 20px 8px}.statusMessage .bodyCopy{margin-top:6px}.statusActions{margin:5px 14px 0}.waitingHost{text-align:center;display:block;padding:13px;font-size:calc(15px*var(--font-scale));color:#65635b}
.terminalContent{padding:8px 15px 0}.resultStats{padding:13px 10px;text-align:center}.resultReason{display:block;font-size:calc(21px*var(--font-scale));font-weight:750;margin-bottom:8px}.resultStatRow{display:flex;justify-content:space-evenly;align-items:center;gap:8px}.resultStatRow>view{min-width:0}.statValue{font-size:calc(var(--vw)*.12);font-weight:900;line-height:1.2;white-space:nowrap}.statusBadge{display:inline-block;background:#278253;color:#fff;padding:5px 12px;border-radius:5px;font-size:calc(21px*var(--font-scale));font-weight:750;margin-top:6px}.state-mouseWin .statusBadge{background:#737771}.state-cancelled .statusBadge{background:#7c7b77}.resultActions{margin-top:12px}.resultActions pixel-action:last-child{max-width:76%;align-self:center}.recordNote{text-align:center;display:block;font-size:12px;line-height:1.4;color:#666;margin-top:10px}.resultMap{height:180px;margin-top:10px;overflow:hidden;border:2px solid #e9dfcd}
.drawerMask{position:fixed;inset:0;background:#18261877;z-index:20}.drawer{position:fixed;bottom:0;left:0;width:var(--vw,100vw);height:78%;background:#fcf8ed;border-top:3px solid #11151a;border-radius:18px 18px 0 0;z-index:21;overflow:hidden}.drawerHandle{width:43px;height:5px;margin:9px auto 3px;border-radius:3px;background:#cac5b9}.drawerHeader{display:flex;align-items:center;gap:8px;padding:0 16px;height:52px;font-size:calc(27px*var(--font-scale));font-weight:750}.drawerLogo{width:33px;height:36px;flex:none}.drawerClose{width:43px;flex:none;margin-left:auto}.drawerBody{height:calc(100% - 69px)}.drawerContent{padding:6px 14px max(24px,var(--safe-bottom),env(safe-area-inset-bottom))}.squadColumns{display:grid;grid-template-columns:.85fr 1.3fr;gap:6px}.squad{background:#fcf9f0;border:1px solid #f2dab4;border-radius:8px;overflow:hidden}.miceGroup{border-color:#c2e1f2}.squadHead{display:flex;align-items:center;gap:4px;background:#ffbd76;padding:6px;font-size:calc(15px*var(--font-scale));font-weight:750}.miceGroup .squadHead{background:#a8ddf8}.squadHead image{width:30px;height:30px;flex:none}.teamGrid{padding:6px}.mouseGrid{display:grid;grid-template-columns:1fr 1fr;gap:4px}.teamMember{display:flex;gap:4px;align-items:center;padding:5px 0;min-width:0}.teamMember image{width:32px;height:37px;flex:none}.teamMember>view{min-width:0;flex:1}.rosterName{display:block;font-size:calc(12px*var(--font-scale));font-weight:550;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rosterState{display:block;font-size:10px;line-height:1.4;color:#328343}.rosterState.caught{color:#777}.eventGroup,.rulesGroup{margin:12px 3px}.sectionHeading{display:block;font-size:calc(17px*var(--font-scale));font-weight:750;margin-bottom:6px}.eventRow{display:flex;gap:12px;margin:5px 0;padding-left:12px;border-left:3px solid #ff9b2b;font-size:calc(13px*var(--font-scale));line-height:1.5}.drawerContent>pixel-action{margin-top:7px}.advancedRules{border-top:1px solid #ded4c2;margin-top:16px;padding-top:12px}.advancedRules .bodyCopy{font-size:12px;color:#65685c}.emptyState{padding:50px 20px;text-align:center}.emptyState>text{display:block;margin-bottom:12px}
.fontLarge .roleTitle{font-size:calc(var(--vw)*.073*var(--font-scale))}.fontLarge .roleSubtitle{font-size:12px}.fontLarge .splitActions{grid-template-columns:1fr}.fontLarge .bottomPanel{max-height:47%}.fontLarge .hidingPanel .bodyCopy{font-size:14px}.fontLarge .mouseGrid{grid-template-columns:1fr}.fontLarge .squadColumns{grid-template-columns:1fr 1fr}.narrowCanvas .roleBand{padding-left:10px;padding-right:10px;gap:8px}.narrowCanvas .mapModeHint{max-width:195px}.narrowCanvas .teamMember image{width:25px;height:30px}

.state-catWin .resultStatRow{flex-direction:column}.state-catWin .statValue{font-size:calc(var(--vw)*.18)}.state-catWin .resultStatus{display:flex;justify-content:center;align-items:center;gap:18px;width:100%;padding:9px;border:1px solid #e8dfce}.state-catWin .statusBadge{margin-top:0}.resultStats{display:flex;flex-direction:column}.state-mouseWin .resultReason{order:2;margin:7px 0 0;font-size:14px;font-weight:450}

.fontLarge .drawerClose{width:94px}.fontLarge .drawerHeader{height:74px}.fontLarge .drawerBody{height:calc(100% - 91px)}

.roleName,.phaseName{white-space:nowrap}.fontLarge .phaseSeparator{display:none}.fontLarge .phaseName{display:block}.sectionHeading{display:flex;align-items:center;gap:7px}.sectionHeading image{width:23px;height:23px;flex:none}
