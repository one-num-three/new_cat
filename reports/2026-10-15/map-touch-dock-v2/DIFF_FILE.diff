function inspect(){return evaluate(()=>new Promise(resolve=>{const p=getCurrentPages().slice(-1)[0],c=p.selectComponent('.venueArt');if(!c){resolve({route:p.route,missing:true});return;}const sels=['.playHud','.actionDrawer','.collapsedDock','.dockAction','.iconAction','.mapTools','.mapStatus','.zoomInButton','.zoomOutButton'],q=wx.createSelectorQuery().in(p);sels.forEach(s=>q.selectAll(s).boundingClientRect());q.exec(boxes=>{const query=c.createSelectorQuery();query.select('.venueImage').boundingClientRect();query.selectAll('.geoBadge').boundingClientRect();query.exec(r=>resolve({route:p.route,width:p.data.viewportWidth,height:p.data.viewportHeight,safe:p.data.safeBottom,scale:c.data.scaleValue,camera:c._camera,minScale:c._minScale(),image:r[0],badges:r[1],points:c.data.overlayPoints,fitWidth:c.data.fitWidth,fitHeight:c.data.fitHeight,tray:p.data.trayExpanded,code:p.data.codeOpen,offline:p.data.offline,boxes:Object.fromEntries(sels.map((s,i)=>[s,boxes[i]]))}));});}));}
function ready(){let s;for(let i=0;i<3;i++){s=inspect();if(s.image&&s.image.width>0)return s;}throw Error('No rendered map '+JSON.stringify(s));}
function aligned(s){assert.ok(Math.abs(s.image.width/s.image.height-1)<1e-4);for(let i=0;i<s.points.length;i++){const p=s.points[i],b=s.badges[i],x=s.image.left+p.x/s.fitWidth*s.image.width,y=s.image.top+p.y/s.fitHeight*s.image.height;assert.ok(Math.abs(b.left+b.width/2-x)<2&&Math.abs(b.top+b.height/2-y)<2);}}
function record(name){aligned(ready());call('simulator_screenshot',{path:path.join(out,name+'.png'),optimize:'false'});const s=ready();aligned(s);rows.push({name,...s});fs.writeFileSync(path.join(out,'progress.json'),JSON.stringify(rows,null,2));console.log('VERIFIED '+name);return s;}
function touch(selector,action,points){const file=path.join(out,'touches-'+seq+'.json');fs.writeFileSync(file,JSON.stringify(points));return call('automation_element_action',{selector,action,'touches-file':file});}
function gesture(start,move){return evaluate((a,b)=>{const c=getCurrentPages().slice(-1)[0].selectComponent('.venueArt');c.onTouchStart({touches:a});c.onTouchMove({touches:b});c.onTouchEnd({touches:[]});},start,move);}
