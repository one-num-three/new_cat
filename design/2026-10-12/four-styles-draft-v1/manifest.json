{
  "title": "猫鼠行动 四风格全页面初步定稿 v1",
  "tool": "built-in image_gen",
  "total": 60,
  "styles": [
    {
      "id": "01-wayfinding",
      "name": "城市导视",
      "style": "严格匹配参考的城市导视：醒目交通黄、黑白网格、橙猫蓝鼠，硬朗几何分区，凝练粗体大数字，地铁导视与赛事计时牌。不变成普通圆角卡片，不用软陶像素。"
    },
    {
      "id": "02-acrylic",
      "name": "2.5D亚克力积木",
      "style": "严格匹配参考的2.5D亚克力城市积木：奶白底、深墨字、磨砂通透亚克力薄板、低多边形橙白猫灰鼠、橙蓝精密按钮、轻微厚度与柔和投影。地图上不加大面积角色装饰。"
    },
    {
      "id": "03-pixel-day",
      "name": "晴日16-bit像素",
      "style": "严格匹配参考的晴日16-bit像素：奶油白、草绿、天蓝、橙色，精致硬边像素猫鼠和公园、小型像素标题边框、阶梯像素按钮。中文功能字保持清晰黑体，禁止3D或模糊假像素。"
    },
    {
      "id": "04-pixel-retro",
      "name": "复古掌机像素",
      "style": "严格匹配参考的复古掌机像素：米白、墨绿、灰绿的克制像素系统、少量亮橙强调、点阵数字、阶梯边框、扁平像素猫鼠。中文功能字用清晰黑体。不变成彩色16bit或3D。"
    }
  ],
  "pages": [
    {
      "id": "01-home",
      "name": "首页与加入",
      "route": "pages/index/index",
      "body": "首页。顶栏猫鼠行动，顶部约30%高度为同风格猫鼠户外追逐主视觉。主标题“和熟人到户外”，副标题“玩一场猫鼠追逐”。下方清晰表单：你的昵称（示例小橘），房间码（占位输入10位房间码）。主按钮“加入房间”，次按钮“创建活动”。底部短规则“30秒躲藏 · 6分钟追逐”。首屏简洁，不出现地图与队伍计数。"
    },
    {
      "id": "02-create",
      "name": "创建活动",
      "route": "pages/room/room?mode=create",
      "body": "创建活动页。标题“组织一场追逐”。本局人数选择器：8人，下方2猫·6鼠；场地块标题“集合点与活动范围”，标注“集合点已确认”“活动范围：半径200米”，按钮“重新确认位置”，配小面积静态场地图；规则摘要30秒躲藏、6分钟追逐、抓满4人猫胜。底部主按钮“创建并邀请”。这是设置表单不是地图操作页。"
    },
    {
      "id": "03-ready",
      "name": "房间准备",
      "route": "pages/room/room",
      "body": "房间准备，房主视角已全员准备。顶部小猫鼠集合插画。完整10位房间码“A1B2C3D4E5”配单独复制按钮，绝不能沿用参考5位码。玩家准备8/8，正好8名：我、小橘、小米、阿青、可可、小林、圆圆、阿川；各自“已准备”，紧凑双列名单。阵营尚未分配，不要提前给名单成员猫鼠身份。摘要2猫6鼠·捕获目标4人。主按钮“开始30秒躲藏”，次按钮“取消准备”。"
    },
    {
      "id": "04-cat",
      "name": "猫队追逐地图",
      "route": "pages/map/map?devPreview=cat",
      "body": "猫队追逐中。顶栏“猫队 · 追逐中”，紧凑HUD：已抓1/4、04:45追逐剩余。真实导航感平面地理地图占中部至少60%，公园道路湖泊简洁可读、本人蓝点、集合点旗帜。只显示一块约50米橙色透明“线索区域”，区域内部没有敌方点或头像或方向。底部说明“橘色区域仅代表大致线索”，主按钮“扫码确认抓捕”，次按钮“队伍·规则·操作”。没有虚构技能。"
    },
    {
      "id": "05-mouse",
      "name": "鼠队追逐地图",
      "route": "pages/map/map?devPreview=mouse",
      "body": "鼠队正常追逐中，无预警。顶栏“鼠队 · 追逐中”，已抓1/4，04:45追逐剩余。真实导航感平面公园地图至少60%，仅本人蓝点和集合点旗帜，没有猫点、橙色线索区域、敌方方向距离或安全区。底部短提示“留意周围环境”，主按钮“停下，展示动态码”，次按钮“队伍·规则·操作”。不放实际二维码、不写收集线索。"
    },
    {
      "id": "06-alert",
      "name": "鼠队近距预警",
      "route": "pages/map/map?devPreview=alert",
      "body": "鼠队近距预警。顶栏鼠队·追逐中，已抓1/4，04:45。地图仅本人蓝点和集合点旗帜，没有任何猫位置、方位、距离、威胁区域或安全区。地图底部上方清晰警示“附近有猫，注意观察”，小字“只提示接近，不展示猫的位置”。警示是文字横条不是地图区域。底部按钮“停下，展示动态码”，次按钮“队伍·规则·操作”。"
    },
    {
      "id": "07-hiding",
      "name": "躲藏阶段",
      "route": "pages/map/map?devPreview=hiding",
      "body": "躲藏阶段，猫方视角。顶栏“猫队 · 躲藏阶段”。倒计时00:18，标签“躲藏倒计时”，已抓0/4。公园地图没有橙色线索或敌方标记。底部状态插画显示猫在集合点等待、远处鼠开始躲藏；文字“鼠先躲藏”“猫留在集合点，倒计时结束后出发”。唯一次按钮“队伍·规则”。隐藏扫码和动态码操作。"
    },
    {
      "id": "08-code",
      "name": "动态抓捕码",
      "route": "pages/qrcode/qrcode",
      "body": "单独动态抓捕码页面，无地图。标题“动态抓捕码”，鼠队身份标签。主标题“停下，展示动态码”，说明“和猫当面确认后再展示”“GPS只作辅助校验”。中央大方形留白占位框含猫鼠小符号和清晰文字“演示码”“不可扫描”，不画真实二维码、不画可扫描图样。框下“15秒有效期·示例”。提醒“请停在安全位置，不要跑动操作”。底部“返回地图”，脚注“扫码成功才算抓捕”。"
    },
    {
      "id": "09-captured",
      "name": "被捕与观战",
      "route": "pages/map/map?devPreview=captured",
      "body": "鼠方已被捕。顶栏“鼠队 · 已出局”，公共进度已抓1/4，04:45。无实时人物位置或线索，地图可作为淡化静态底图。主视觉温和表现小鼠休息，非伤害。状态“本轮已出局”“仅查看公开状态”“返回集合点，等待本局结算”。没有复活按钮、没有展示码、没有扫码。底部唯一按钮“队伍·规则”。"
    },
    {
      "id": "10-paused",
      "name": "暂停状态",
      "route": "pages/map/map?devPreview=paused",
      "body": "暂停状态，房主视角。顶栏“本局暂停”，已抓1/4，04:45，必须清楚标注“计时已冻结”。淡化静态地图没有玩家点线索。主状态插画猫鼠休息；文案“组织者暂停”“请原地等待”。主按钮“恢复本局”，次按钮“队伍·规则·操作”。不要写倒计时继续或自动恢复。"
    },
    {
      "id": "11-offline",
      "name": "断线重连",
      "route": "pages/map/map?devPreview=offline",
      "body": "断线重连状态，非比赛暂停。顶栏“重连中”，时间显示“--:--”并标注“等待同步”，避免把旧时间表示为实时倒计时。淡化静态地图，无玩家坐标或线索。连接图标和友好插画；主文案“连接中断，正在重连”“请停下等待连接恢复”，小状态“自动重连中”。扫码/展示码隐藏。底部按钮“队伍·规则”。不承诺赛事时间冻结。"
    },
    {
      "id": "12-cat-win",
      "name": "猫队胜利",
      "route": "pages/map/map?devPreview=catWin",
      "body": "猫队获胜结算，房主视角。主视觉同风格猫角色庆祝，克制纸屑，不是地图页大面积地图。标题“猫队获胜”，原因“已达到捕获目标”，结果大数字“4 / 4”，标注“捕获目标已完成”，对局状态“已结束”。不写必须抓满6鼠、不加积分奖励或排行榜。主按钮“再来一局”，次按钮“查看对局详情”，文本入口“返回首页”。"
    },
    {
      "id": "13-mouse-win",
      "name": "鼠队胜利",
      "route": "pages/map/map?devPreview=mouseWin",
      "body": "鼠队获胜结算，房主视角。同风格鼠角色轻松庆祝。标题“鼠队获胜”，原因“追逐时间已到”，数字“已抓捕3/4”，解释“猫队未达到捕获目标”。状态“已结束”。不写所有鼠都没被抓，不加积分或商店。主按钮“再来一局”，次按钮“查看对局详情”，文本入口“返回首页”。"
    },
    {
      "id": "14-cancelled",
      "name": "取消结算",
      "route": "pages/map/map?devPreview=cancelled",
      "body": "取消结算页，房主视角。中性猫鼠收好旗帜的插画，安静而非庆祝或失败。标题“本局取消”，明确“不计胜负”，状态“已结束”，公共记录“已抓捕1/4”。主按钮“再来一局”，次按钮“查看对局详情”，文本入口“返回首页”。不要胜败标识或奖杯。"
    },
    {
      "id": "15-details",
      "name": "对局详情抽屉",
      "route": "pages/map/map?drawer=true",
      "body": "追逐中的对局详情底部抽屉，遮罩下顶部露出少量地图和HUD。抽屉占屏幕约85%，标题“对局详情”和关闭。猫队2人：我、小橘；鼠队6人：小米（被捕）、阿青、可可、小林、圆圆、阿川（存活）。紧凑双列队员名单。最近事件“09:02 完成一次抓捕”“09:00 追逐开始”。规则摘要“30秒躲藏·6分钟追逐”“猫抓满4人获胜”“取消不计胜负”。明显“紧急暂停”按钮，底部低优先“退出本局”。不呈现敌方定位。所有文案可读，不堆叠小卡片，明确可滚动。"
    }
  ],
